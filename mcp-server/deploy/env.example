# Local dev:  set -a; . deploy/env.local; set +a; npm run build && npm start
PUBLIC_BASE_URL=http://127.0.0.1:8080
FIREBASE_PROJECT_ID=turf-timer
FIREBASE_WEB_API_KEY=            # public Web API key (Firebase console > Project settings)
MCP_JWT_SECRET=                  # >= 32 chars; prod: Secret Manager "mcp-jwt-secret"
MCP_STORE=memory                 # memory | firestore (default firestore)
ALLOW_FIREBASE_ID_TOKENS=0       # 1 = dev only, accept raw Firebase ID tokens on /mcp
# MCP_EXTRA_REDIRECTS=https://example.com/callback
