<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.ReportsPage"
             Title="Match Reports"
             BackgroundColor="#1b5e20">
    <Grid RowDefinitions="Auto,*">
        <!-- Button Container - Not included in report when emailing -->
        <VerticalStackLayout Grid.Row="0" 
                           Padding="15" 
                           Spacing="10"
                           x:Name="ButtonContainer">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button x:Name="ViewReportButton"
                        Text="👁️ View Report"
                        Clicked="OnViewReportClicked"
                        BackgroundColor="#2e7d32"
                        TextColor="White"
                        FontSize="16"
                        Padding="20,10"
                        CornerRadius="8" />

                <Button x:Name="EmailHtmlButton"
                        Text="📧 Email HTML"
                        Clicked="OnEmailHtmlClicked"
                        BackgroundColor="#2e7d32"
                        TextColor="White"
                        FontSize="16"
                        Padding="20,10"
                        CornerRadius="8" />

                <Button x:Name="EmailReportButton"
                        Text="📎 Email Report"
                        Clicked="OnEmailReportClicked"
                        BackgroundColor="#2e7d32"
                        TextColor="White"
                        FontSize="16"
                        Padding="20,10"
                        CornerRadius="8" />
            </HorizontalStackLayout>

            <Label x:Name="StatusLabel"
                   Text=""
                   TextColor="White"
                   FontSize="14"
                   HorizontalOptions="Center"
                   IsVisible="False" />
        </VerticalStackLayout>

        <!-- WebView for HTML Report Display -->
        <WebView Grid.Row="1" 
                 x:Name="ReportWebView"
                 BackgroundColor="White" />
    </Grid>
</ContentPage>
