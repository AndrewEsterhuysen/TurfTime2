<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.SkinsPage"
             Title="Skins"
             BackgroundColor="#1b5e20">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Header -->
            <Label Text="🎨 App Skins" 
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,10,0,10" />
            
            <Label Text="Choose your preferred app theme:" 
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="#E0E0E0"
                   Margin="0,0,0,20" />
            
            <!-- Classic Skin -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True"
                   x:Name="classicFrame">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClassicTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Padding="20" Spacing="10">
                        <HorizontalStackLayout Spacing="15">
                            <Label Text="🌿" FontSize="32" VerticalOptions="Center" />
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                <Label Text="Classic" 
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Original green theme" 
                                       FontSize="14"
                                       TextColor="#E0E0E0" />
                            </VerticalStackLayout>
                            <Label x:Name="classicCheckmark"
                                   Text="✓" 
                                   FontSize="32"
                                   TextColor="#00e676"
                                   VerticalOptions="Center"
                                   IsVisible="False" />
                        </HorizontalStackLayout>
                        
                        <!-- Preview -->
                        <Frame BackgroundColor="#1b5e20"
                               CornerRadius="8"
                               Padding="15"
                               HasShadow="False">
                            <HorizontalStackLayout Spacing="10">
                                <BoxView Color="#00e676" WidthRequest="30" HeightRequest="30" CornerRadius="4" />
                                <BoxView Color="#8B4513" WidthRequest="30" HeightRequest="30" CornerRadius="4" />
                                <BoxView Color="#ffeb3b" WidthRequest="30" HeightRequest="30" CornerRadius="4" />
                                <BoxView Color="#FF6B35" WidthRequest="30" HeightRequest="30" CornerRadius="4" />
                            </HorizontalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>
            </Frame>
            
            <!-- Modern Skin -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True"
                   x:Name="modernFrame">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnModernTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Padding="20" Spacing="10">
                        <HorizontalStackLayout Spacing="15">
                            <Label Text="🌙" FontSize="32" VerticalOptions="Center" />
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                <Label Text="Modern" 
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Dark theme with high contrast" 
                                       FontSize="14"
                                       TextColor="#E0E0E0" />
                            </VerticalStackLayout>
                            <Label x:Name="modernCheckmark"
                                   Text="✓" 
                                   FontSize="32"
                                   TextColor="#00e676"
                                   VerticalOptions="Center"
                                   IsVisible="False" />
                        </HorizontalStackLayout>
                        
                        <!-- Preview -->
                        <Frame BackgroundColor="#0d1b2a"
                               CornerRadius="8"
                               Padding="15"
                               HasShadow="False">
                            <HorizontalStackLayout Spacing="10">
                                <BoxView Color="#00ff88" WidthRequest="30" HeightRequest="30" CornerRadius="4" />
                                <BoxView Color="#ff6b35" WidthRequest="30" HeightRequest="30" CornerRadius="4" />
                                <BoxView Color="#ffd700" WidthRequest="30" HeightRequest="30" CornerRadius="4" />
                                <BoxView Color="#00d9ff" WidthRequest="30" HeightRequest="30" CornerRadius="4" />
                            </HorizontalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>
            </Frame>
            
            <Label Text="The theme will be applied when you return to the Game page." 
                   FontSize="13"
                   HorizontalOptions="Center"
                   TextColor="#B0B0B0"
                   Margin="0,20,0,0"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
