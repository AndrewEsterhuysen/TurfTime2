<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.SettingsPage"
             Title="Settings"
             BackgroundColor="#1b5e20">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Header -->
            <Label Text="⚙️ Settings" 
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,10,0,20" />
            
            <!-- Log Option -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label Text="📋" FontSize="32" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Log" 
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="View game session logs and export data" 
                                   FontSize="14"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                        <Label Text="›" 
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>
            
            <!-- Skins Option -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSkinsTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label Text="🎨" FontSize="32" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Skins" 
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Choose between Classic and Modern themes" 
                                   FontSize="14"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                        <Label Text="›" 
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Rotation Style Option -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRotationStyleTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label Text="🎯" FontSize="32" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Rotation Style" 
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Choose how players to rotate are highlighted" 
                                   FontSize="14"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                        <Label Text="›" 
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Team View Option -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTeamViewTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label Text="📋" FontSize="32" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Team View" 
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Choose between Swipe View or Table View" 
                                   FontSize="14"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                        <Label Text="›" 
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
