<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TurfTime2"
             x:Class="TurfTime2.TeamDetailsPage"
             Title="Team Details">
    <ContentPage.Resources>
        <local:BoolToCheckConverter x:Key="BoolToCheckConverter"/>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <!-- Current Team Display -->
            <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#2C2C2C}"
                   Padding="15"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Current Team" FontAttributes="Bold" FontSize="16"/>
                    <Label x:Name="CurrentTeamLabel" 
                           Text="No team selected" 
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                    <Label x:Name="TeamModeLabel"
                           Text="Mode: Not configured"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#999, Dark=#888}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Shared Mode Section -->
            <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                   Padding="15"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="SharedCheckbox"
                                  CheckedChanged="OnSharedCheckboxChanged"/>
                        <Label Text="Shared (Cloud sync with team members)"
                               FontSize="14"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Create New Team -->
                    <StackLayout x:Name="CreateTeamSection" IsVisible="False" Spacing="10">
                        <Label Text="Create New Team" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>

                        <Label Text="Club &amp; Team" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                        <Entry x:Name="ClubEntry"
                               Placeholder="Club name (e.g., Manchester United FC)"
                               TextChanged="OnClubTeamChanged"/>
                        <Entry x:Name="TeamEntry"
                               Placeholder="Team name (e.g., U17 Boys)"
                               TextChanged="OnClubTeamChanged"/>

                        <Label Text="OR" HorizontalOptions="Center" FontAttributes="Bold" Margin="0,5"/>

                        <Label Text="Nickname" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                        <Entry x:Name="NicknameEntry"
                               Placeholder="Team nickname (e.g., Socceroos)"
                               TextChanged="OnNicknameChanged"/>

                        <Button Text="Create Team &amp; Become Admin"
                                Clicked="OnCreateTeamClicked"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                Margin="0,10,0,0"/>
                    </StackLayout>

                    <!-- Join Existing Team -->
                    <StackLayout x:Name="JoinTeamSection" IsVisible="False" Spacing="10">
                        <Label Text="Join Existing Team" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>

                        <Entry x:Name="InviteCodeEntry"
                               Placeholder="Enter invite code"
                               MaxLength="20"/>

                        <Button Text="Join as Member"
                                Clicked="OnJoinTeamClicked"
                                BackgroundColor="#2196F3"
                                TextColor="White"/>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Local Mode Section -->
            <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                   Padding="15"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="LocalCheckbox"
                                  CheckedChanged="OnLocalCheckboxChanged"/>
                        <Label Text="Local (Device only, no cloud sync)"
                               FontSize="14"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <StackLayout x:Name="LocalTeamSection" IsVisible="False" Spacing="10">

                        <!-- Switch Between Local Teams (shown FIRST if teams exist) -->
                        <Label x:Name="LocalTeamSwitcherLabel"
                               Text="Your Teams"
                               FontAttributes="Bold"
                               FontSize="16"
                               Margin="0,10,0,0"
                               IsVisible="False"/>

                        <CollectionView x:Name="LocalTeamsCollection"
                                        IsVisible="False"
                                        SelectionMode="Single"
                                        SelectionChanged="OnLocalTeamSelectionChanged"
                                        Margin="0,0,0,10">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <!-- SwipeView for rename/delete gestures -->
                                    <SwipeView>
                                        <SwipeView.LeftItems>
                                            <SwipeItems Mode="Execute">
                                                <SwipeItem Text="Rename"
                                                           BackgroundColor="#2196F3"
                                                           Command="{Binding Source={x:Reference LocalTeamsCollection}, Path=BindingContext.RenameTeamCommand}"
                                                           CommandParameter="{Binding .}"
                                                           Invoked="OnRenameTeamSwipe"/>
                                            </SwipeItems>
                                        </SwipeView.LeftItems>
                                        <SwipeView.RightItems>
                                            <SwipeItems Mode="Execute">
                                                <SwipeItem Text="Delete"
                                                           BackgroundColor="Red"
                                                           Command="{Binding Source={x:Reference LocalTeamsCollection}, Path=BindingContext.DeleteTeamCommand}"
                                                           CommandParameter="{Binding .}"
                                                           Invoked="OnDeleteTeamSwipe"/>
                                            </SwipeItems>
                                        </SwipeView.RightItems>

                                        <Frame Padding="10"
                                               Margin="0,5"
                                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                                               BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#505050}"
                                               CornerRadius="5"
                                               HasShadow="False"
                                               InputTransparent="False">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTeamItemTapped" />
                                            </Frame.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding IsActive, Converter={StaticResource BoolToCheckConverter}}"
                                                       FontSize="20"
                                                       VerticalOptions="Center"/>
                                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                                    <Label Text="{Binding TeamName}"
                                                           FontSize="16"
                                                           FontAttributes="Bold"/>
                                                    <Label Text="{Binding TeamId}"
                                                           FontSize="10"
                                                           TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </Frame>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Separator between existing teams and create section -->
                        <BoxView x:Name="TeamSeparator"
                                 HeightRequest="1"
                                 Color="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                 Margin="0,10,0,0"
                                 IsVisible="False"/>

                        <!-- Create New Local Team (shown AFTER existing teams) -->
                        <Label Text="Create New Team" 
                               FontAttributes="Bold" 
                               FontSize="16" 
                               Margin="0,10,0,0"/>

                        <Entry x:Name="LocalTeamNameEntry"
                               Placeholder="Team name (local only)"/>

                        <Button Text="Create Local Team"
                                Clicked="OnSetLocalTeamClicked"
                                BackgroundColor="#FF9800"
                                TextColor="White"/>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Admin Panel (visible only for admins) -->
            <Frame x:Name="AdminPanel"
                   IsVisible="False"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                   Padding="15"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Admin Panel" FontAttributes="Bold" FontSize="16"/>
                    
                    <Frame BackgroundColor="{AppThemeBinding Light=#FFF3CD, Dark=#4A3C1E}"
                           Padding="10"
                           CornerRadius="5">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Invite Code" FontAttributes="Bold" FontSize="12"/>
                            <Label x:Name="InviteCodeDisplay"
                                   Text="Loading..."
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Share this code with your team members"
                                   FontSize="10"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <Button Text="View Team Members"
                            Clicked="OnViewMembersClicked"
                            BackgroundColor="#9C27B0"
                            TextColor="White"/>
                    
                    <Button Text="Regenerate Invite Code"
                            Clicked="OnRegenerateCodeClicked"
                            BackgroundColor="#F44336"
                            TextColor="White"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Leave Team Button -->
            <Button x:Name="LeaveTeamButton"
                    Text="Leave Current Team"
                    IsVisible="False"
                    Clicked="OnLeaveTeamClicked"
                    BackgroundColor="#F44336"
                    TextColor="White"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
