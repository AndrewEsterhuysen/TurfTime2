<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TurfTime2.GamePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TurfTime2.Models"
             xmlns:conv="clr-namespace:TurfTime2.Converters"
             xmlns:local="clr-namespace:TurfTime2"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1b5e20">

    <ContentPage.Resources>
        <Color x:Key="FieldColor">#388e3c</Color>
        <Color x:Key="BenchColor">#1565c0</Color>
        <Color x:Key="GoalieColor">#f57f17</Color>
        <Color x:Key="InactiveColor">#424242</Color>
        <Color x:Key="AccentColor">#FF6B35</Color>
        <Color x:Key="CardBg">#2e7d32</Color>
        <Color x:Key="CyanHighlight">#00d9ff</Color>

        <conv:BoolToFontAttrsConverter    x:Key="BoolToFontAttrs" />
        <conv:PositionToColorConverter    x:Key="PositionToColor" />
        <conv:NextToBorderColorConverter  x:Key="NextToBorderColor" />
        <conv:NextToBorderThicknessConverter x:Key="NextToBorderThickness" />
        <conv:NextToArrowConverter        x:Key="NextToArrow" />

        <!-- ── Player row template for VIEW_A ── -->
        <DataTemplate x:Key="PlayerRowTemplate" x:DataType="models:Player">
            <!--
                DragRow root: calls RequestDisallowInterceptTouchEvent(true) at
                ACTION_DOWN on Android, preventing the CollectionView/RecyclerView
                from intercepting vertical gestures before PanGestureRecognizer fires.
                ONE PanGestureRecognizer on the outer Grid handles both intents.
                After ~12 dp the handler commits to swipe (horizontal) or drag
                (vertical) so the two actions never conflict.
                The ☰ label is a visual cue only — no child gesture recognizer.
            -->
            <local:DragRow Spacing="0">
                <!-- Gold insertion-point indicator — visible only when IsDragTarget -->
                <BoxView HeightRequest="3"
                         Color="#FFD700"
                         IsVisible="{Binding IsDragTarget}"
                         HorizontalOptions="Fill" />

                <Grid ColumnDefinitions="0.15*,0.7*,0.15*">
                    <Grid.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnPlayerPanUpdated" />
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="1"
                            Stroke="{Binding IsNextToRotate, Converter={StaticResource NextToBorderColor}}"
                            StrokeThickness="{Binding IsNextToRotate, Converter={StaticResource NextToBorderThickness}}"
                            StrokeShape="RoundRectangle 0"
                            BackgroundColor="{Binding Position, Converter={StaticResource PositionToColor}}"
                            Margin="0,1,0,0">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                              Padding="4,9">
                            <!-- Drag handle (visual only — gesture is on the outer Grid) -->
                            <Label Grid.Column="0"
                                   Text="☰"
                                   TextColor="#88ffffff"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   Margin="0,0,6,0" />
                            <!-- Position icon: ⚽ 💺 🥅 ❌ -->
                            <Label Grid.Column="1"
                                   Text="{Binding PositionIcon}"
                                   FontSize="20"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0" />
                            <!-- Next-to-rotate arrow -->
                            <Label Grid.Column="2"
                                   Text="➤"
                                   TextColor="{StaticResource CyanHighlight}"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsNextToRotate}"
                                   Margin="0,0,6,0" />
                            <!-- Player name -->
                            <Label Grid.Column="3"
                                   Text="{Binding Name}"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="{Binding IsNextToRotate, Converter={StaticResource BoolToFontAttrs}}"
                                   VerticalOptions="Center" />
                            <!-- Field time -->
                            <Label Grid.Column="4"
                                   Text="{Binding FieldTimeDisplay}"
                                   TextColor="#ccffcc"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </Grid>
            </local:DragRow>
        </DataTemplate>
        <!-- ── Inactive / absent group header template ── -->
        <DataTemplate x:Key="InactiveHeaderTemplate" x:DataType="models:InactiveGroupHeader">
            <Grid ColumnDefinitions="0.15*,0.7*,0.15*">
                <Border Grid.Column="1"
                        BackgroundColor="#424242"
                        StrokeShape="RoundRectangle 0"
                        Stroke="#666"
                        StrokeThickness="1"
                        Margin="0,4,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInactiveHeaderTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Label}"
                           TextColor="#cccccc"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="10,10" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template selector -->
        <local:RosterItemTemplateSelector x:Key="RosterSelector"
            PlayerTemplate="{StaticResource PlayerRowTemplate}"
            InactiveHeaderTemplate="{StaticResource InactiveHeaderTemplate}" />

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">

        <!-- ══ HEADER ══ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Padding="8,6,8,4" BackgroundColor="#1a4a1e">

            <!-- Left: Us score -->
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                <Label Text="Us"
                       TextColor="#ccffcc"
                       FontSize="11"
                       HorizontalOptions="Center"
                       IsVisible="{Binding ScoresVisible}" />
                <Label Text="{Binding TeamAScore}"
                       TextColor="{StaticResource AccentColor}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       IsVisible="{Binding ScoresVisible}" />
            </StackLayout>

            <!-- Centre: Match timer / team name / rotation timer stacked -->
            <StackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="1">
                <!-- Match timer -->
                <Label Text="{Binding MatchTimeLabelText}"
                       TextColor="#99cc99"
                       FontSize="10"
                       HorizontalOptions="Center" />
                <Label x:Name="MatchTimerLabel"
                       Text="{Binding MatchTimeDisplay}"
                       TextColor="White"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMatchTimerTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <!-- Team name (between the two timers) -->
                <Label Text="{Binding TeamName}"
                       TextColor="#ffe082"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <!-- Rotation countdown -->
                <Label Text="Rotate"
                       TextColor="#99cc99"
                       FontSize="10"
                       HorizontalOptions="Center" />
                <Label x:Name="CountdownLabel"
                       Text="{Binding CountdownDisplay}"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCountdownTimerTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

            <!-- Right: Them score -->
            <StackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                <Label Text="Them"
                       TextColor="#ccffcc"
                       FontSize="11"
                       HorizontalOptions="Center"
                       IsVisible="{Binding ScoresVisible}" />
                <Label Text="{Binding TeamBScore}"
                       TextColor="{StaticResource AccentColor}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       IsVisible="{Binding ScoresVisible}" />
            </StackLayout>
        </Grid>

        <!-- ══ Member read-only banner ══ -->
        <Border Grid.Row="1"
                BackgroundColor="#ffc107"
                Padding="8,4"
                StrokeShape="RoundRectangle 4"
                IsVisible="{Binding IsMember}"
                Margin="4,2,4,2">
            <Label Text="📖 VIEW-ONLY MODE — Team Admin controls the game"
                   TextColor="Black"
                   FontAttributes="Bold"
                   FontSize="12"
                   HorizontalOptions="Center" />
        </Border>

        <!-- ══ CONTENT AREA ══ -->
        <Grid Grid.Row="2">

            <!-- VIEW_A: Swipeable list -->
            <CollectionView x:Name="SwipeableRoster"
                            ItemsSource="{Binding DisplayItems}"
                            ItemTemplate="{StaticResource RosterSelector}"
                            ItemsLayout="VerticalList"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No players – tap Setup to add players"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- VIEW_B: Table (built in code-behind) -->
            <ScrollView x:Name="TableView" IsVisible="False">
                <StackLayout x:Name="TableStack" Spacing="1" />
            </ScrollView>

            <!-- VIEW_C: Rotation display with score buttons -->
            <Grid x:Name="RotationView"
                  IsVisible="False"
                  RowDefinitions="Auto,*"
                  ColumnDefinitions="80,*,80">

                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                        x:Name="TeamAScoreBtn"
                        Text="{Binding TeamAScore, StringFormat='Us&#10;{0}'}"
                        BackgroundColor="{StaticResource FieldColor}"
                        TextColor="White"
                        FontSize="22"
                        FontAttributes="Bold"
                        VerticalOptions="Fill"
                        Clicked="OnTeamAScoreClicked"
                        IsVisible="{Binding ScoresVisible}" />

                <StackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                             VerticalOptions="Center"
                             Spacing="4"
                             Padding="8,0">
                    <Label Text="Next Rotation"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="18"
                           HorizontalOptions="Center"
                           Margin="0,0,0,8" />
                    <CollectionView x:Name="RotationPairsView"
                                    ItemsSource="{Binding RotationPairs}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RotationPair">
                                <Grid ColumnDefinitions="*,*" Margin="4,2">
                                    <Label Grid.Column="0"
                                           Text="{Binding BenchPlayerName, StringFormat='💺 {0} ➜'}"
                                           TextColor="#bbdefb"
                                           FontSize="15"
                                           HorizontalOptions="Start" />
                                    <Label Grid.Column="1"
                                           Text="{Binding FieldPlayerName, StringFormat='⬅ ⚽ {0}'}"
                                           TextColor="#ffccbc"
                                           FontSize="15"
                                           HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Assign field and bench players first"
                                   TextColor="#aaa"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </StackLayout>

                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                        x:Name="TeamBScoreBtn"
                        Text="{Binding TeamBScore, StringFormat='Them&#10;{0}'}"
                        BackgroundColor="#c62828"
                        TextColor="White"
                        FontSize="22"
                        FontAttributes="Bold"
                        VerticalOptions="Fill"
                        Clicked="OnTeamBScoreClicked"
                        IsVisible="{Binding ScoresVisible}" />
            </Grid>

        </Grid>

        <!-- ══ BOTTOM CONTROLS ══ -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,*,*"
              Padding="4,6,4,6"
              ColumnSpacing="6"
              BackgroundColor="#1a4a1e">

            <Button Grid.Column="0"
                    x:Name="StartBtn"
                    Text="{Binding StartButtonText}"
                    BackgroundColor="{StaticResource AccentColor}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    IsEnabled="{Binding CanStart}"
                    Clicked="OnStartClicked"
                    Pressed="OnStartPressed"
                    Released="OnStartReleased" />

            <Button Grid.Column="1"
                    x:Name="RotateBtn"
                    Text="{Binding RotateButtonText}"
                    BackgroundColor="{StaticResource CardBg}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    Clicked="OnRotateClicked"
                    Pressed="OnRotatePressed"
                    Released="OnRotateReleased" />

            <Button Grid.Column="2"
                    x:Name="ViewBtn"
                    Text="Swipe"
                    BackgroundColor="{StaticResource CardBg}"
                    TextColor="White"
                    FontSize="13"
                    Clicked="OnViewButtonClicked" />

        </Grid>

    </Grid>

</ContentPage>
