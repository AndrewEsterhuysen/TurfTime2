<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.TeamViewPage"
             Title="Team View"
             BackgroundColor="#1b5e20">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Header -->
            <Label Text="📋 Team View Preference" 
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,10,0,10" />

            <Label Text="Choose your preferred view for managing the team roster:" 
                   FontSize="14"
                   TextColor="#E0E0E0"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <!-- Option 1: Swipe View (VIEW_A) -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True"
                   x:Name="SwipeViewFrame">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSwipeViewTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label x:Name="SwipeViewCheck" Text="✓" FontSize="28" VerticalOptions="Center" TextColor="#00d9ff" IsVisible="True" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Swipe View" 
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Touch-friendly interface with swipeable player cards" 
                                   FontSize="13"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Info Section -->
            <Frame BackgroundColor="Transparent"
                   BorderColor="#00d9ff"
                   CornerRadius="8"
                   Padding="15"
                   Margin="0,20,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ℹ️ Note:" 
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#00d9ff" />
                    <Label Text="The VIEW button toggles between the Swipe view and the Rotation Display."
                           FontSize="13"
                           TextColor="#E0E0E0"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
