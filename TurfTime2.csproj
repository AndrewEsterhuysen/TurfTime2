<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- On Windows: Android + Windows. On Mac: Android + iOS + MacCatalyst. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-ios;net10.0-windows10.0.19041</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>TurfTime2</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Turf Time</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.andrewestherhuysen.turftime</ApplicationId>

		<!-- Versions -->
		<!-- ApplicationDisplayVersion = marketing version (CFBundleShortVersionString / versionName).
		     ApplicationVersion = integer build (CFBundleVersion / versionCode). Store rejects reuse. -->
		<ApplicationDisplayVersion>2.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>22</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<EnableMsixTooling>true</EnableMsixTooling>
		<PublishSingleFile Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041'">true</PublishSingleFile>
		<SelfContained Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041'">true</SelfContained>
		<RuntimeIdentifier Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041'">win-x64</RuntimeIdentifier>

		<!-- Shorten iOS output path on Windows to avoid MAX_PATH (260 char) limit on deep Firebase xcframework paths.
				 Only applies for local builds; absolute paths are not supported when building remotely to a Mac host. -->
		<BaseOutputPath Condition="$([MSBuild]::IsOSPlatform('windows')) and $(TargetFramework.Contains('ios')) and '$(ServerAddress)' == ''">C:\b\</BaseOutputPath>
		<BaseIntermediateOutputPath Condition="$([MSBuild]::IsOSPlatform('windows')) and $(TargetFramework.Contains('ios')) and '$(ServerAddress)' == ''">C:\b\obj\</BaseIntermediateOutputPath>
		<!-- When BaseIntermediateOutputPath is redirected (e.g. C:\b\obj\ for iOS on Windows), the SDK's default
				 glob exclusions no longer cover the local obj\ folder, so generated files from other TFMs bleed in.
				 Suppress that by also excluding the project-local obj\ and bin\ directories. -->
		<DefaultItemExcludes Condition="'$(BaseIntermediateOutputPath)' != 'obj\' and '$(BaseIntermediateOutputPath)' != 'obj/'">$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>

		<!-- Disable Firebase Crashlytics (we only need Cloud Messaging) -->
		<FirebaseCrashlyticsEnabled>false</FirebaseCrashlyticsEnabled>

		<!-- Skip Xamarin.Build.Download archive extraction on Windows — iOS compiles on the Mac build host -->
		<XamarinDownloadSkipRestoreArchives Condition="$([MSBuild]::IsOSPlatform('windows'))">true</XamarinDownloadSkipRestoreArchives>
		<!-- Point Xamarin.Build.Download to the 7-Zip install on Windows -->
		<XamarinBuildDownloadUser7ZipPath Condition="$([MSBuild]::IsOSPlatform('windows'))">C:\Program Files\7-Zip\7z.exe</XamarinBuildDownloadUser7ZipPath>	
		<Configurations>Debug;Release;Release Copy</Configurations>
		<Platforms>AnyCPU</Platforms></PropertyGroup>

	<!-- iOS Debug Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and $(TargetFramework.Contains('ios'))">
		<CodesignKey>Apple Development: Created via API (BZW4P28WC4)</CodesignKey>
		<CodesignProvision>TurfTime Development Provisioning Profile</CodesignProvision>
		<!-- Push: aps-environment=development -->
		<CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<!-- iOS Release Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $(TargetFramework.Contains('ios'))">
		<CodesignKey>Apple Distribution: Andrew Esterhuysen (YT6V9JS4F9)</CodesignKey>
		<CodesignProvision>TurfTimer_Distribution_Provisioning_Profile</CodesignProvision>
		<EnableCodeSigning>true</EnableCodeSigning>
		<ArchiveOnBuild>true</ArchiveOnBuild>
		<MtouchLink>SdkOnly</MtouchLink>
		<EnableSGenConc>true</EnableSGenConc>
		<!-- Push: aps-environment=production -->
		<CodesignEntitlements>Platforms/iOS/Entitlements.Release.plist</CodesignEntitlements>
	</PropertyGroup>

	<!-- Android Debug Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and $(TargetFramework.Contains('android'))">
		<AndroidFastDeploymentType>false</AndroidFastDeploymentType>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<!-- Android Release Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $(TargetFramework.Contains('android'))">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>turftime.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>turftime</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(AndroidSigningStorePassword)</AndroidSigningStorePass> <!-- Note: The Android signing key password is the same as the store password in this case, but it can be different if desired.-->
    <AndroidSigningKeyPass>$(AndroidSigningKeyPassword)</AndroidSigningKeyPass> <!-- Note: The Android signing key password is the same as the store password in this case, but it can be different if desired.-->
    <AndroidLinkTool>r8</AndroidLinkTool>
		<RunAOTCompilation>true</RunAOTCompilation>
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\turftimer_splash.svg" Color="#512BD4" BaseSize="620,620" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="wwwroot\**" />
	</ItemGroup>

	<!-- Ensure wwwroot is copied to output for Windows -->
	<ItemGroup Condition="$(TargetFramework.Contains('windows'))">
		<Content Include="wwwroot\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<AndroidResource Include="Platforms\Android\Resources\values\crashlytics.xml" />
	</ItemGroup>
	<ItemGroup>
		<MauiAsset Remove="wwwroot\js\.editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<MauiCss Remove="wwwroot\css\styles-modern.css" />
	</ItemGroup>

	<!-- Firebase Configuration for Android -->
	<ItemGroup Condition="$(TargetFramework.Contains('android'))">
		<GoogleServicesJson Include="Platforms\Android\google-services.json" />
	</ItemGroup>

	<!-- Firebase Configuration for iOS / MacCatalyst
	     Robust inclusion for Pair-to-Mac and remote builds:
	     - Explicit BundleResource with LogicalName so it lands at root of the .app bundle (required by FIRApp.configure).
	     - Unconditional + conditioned forms for resilience during MSBuild evaluation on Mac build host.
	     - Build-time diagnostic message.
	-->
	<ItemGroup>
		<!-- Primary (works for local Mac builds) -->
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist" Condition="'$(TargetFramework)' == 'net10.0-ios' Or '$(TargetFramework)' == 'net10.0-maccatalyst'">
			<LogicalName>GoogleService-Info.plist</LogicalName>
		</BundleResource>
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('ios')) or $(TargetFramework.Contains('maccatalyst'))">
		<!-- Keep original form + None Remove for compatibility with older tooling / Rider -->
		<None Remove="Platforms\iOS\GoogleService-Info.plist" />
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist">
			<LogicalName>GoogleService-Info.plist</LogicalName>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</BundleResource>
	</ItemGroup>

	<!-- Build-time verification / diagnostic for iOS Firebase config (helps Pair-to-Mac troubleshooting) -->
	<Target Name="VerifyFirebasePlist" AfterTargets="PrepareForBuild" Condition="'$(TargetFramework)' == 'net10.0-ios' Or '$(TargetFramework)' == 'net10.0-maccatalyst'">
		<Message Text="[iOS Firebase] Ensuring GoogleService-Info.plist is configured as BundleResource with LogicalName=GoogleService-Info.plist (must appear at .app root for FIRApp.configure)" Importance="high" />
		<Message Text="[iOS Firebase] Source plist: $(MSBuildProjectDirectory)\Platforms\iOS\GoogleService-Info.plist" Importance="high" />
	</Target>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Plugin.Firebase" Version="3.1.1" />
		<PackageReference Include="Plugin.Firebase.CloudMessaging" Version="3.1.1" />
		<PackageReference Include="QuestPDF" Version="2025.1.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.8" />
		<PackageReference Include="ZXing.Net" Version="0.16.10" />
		<PackageReference Include="ZXing.Net.Maui" Version="0.6.0" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.6.0" />
		<!-- Pin to override the 0.11.0 version pulled transitively by Plugin.Firebase, which conflicts with the 0.11.4 DLL -->
		<PackageReference Include="Xamarin.Build.Download" Version="0.11.4" />
		<!-- Resolve androidx.tracing conflict: explicitly pin both tracing and tracing-ktx to same version -->
		<PackageReference Include="Xamarin.AndroidX.Tracing.Tracing" Version="1.3.0.1" Condition="$(TargetFramework.Contains('android'))" />
		<PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="1.3.0.1" Condition="$(TargetFramework.Contains('android'))" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="GamePage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="HelpPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="ReportsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="RotationStylePage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="SetupPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="SettingsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TeamDetailsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="DetailsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="ComingSoonPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TimersSettingsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="WelcomePage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <None Update="ChatPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </None>
	</ItemGroup>

	<!-- Generate build metadata at compile time -->
	<PropertyGroup>
		<GetGitHashCommand>git rev-parse --short HEAD</GetGitHashCommand>
		<GetGitHashCommand Condition="'$(OS)' == 'Windows_NT'">cmd /c git rev-parse --short HEAD</GetGitHashCommand>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
	  <!-- Keep simulator/device Debug on interpreter + non-LLVM to avoid startup AOT/LLVM runtime crashes. -->
	  <MtouchUseLlvm>False</MtouchUseLlvm>
	  <UseInterpreter>True</UseInterpreter>
	  <MtouchLink>None</MtouchLink>
	  <EnableSGenConc>True</EnableSGenConc>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(TargetFramework.Contains(`-ios`))'">
		<ValidateXcodeVersion>false</ValidateXcodeVersion>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)'=='net10.0-ios'">
		<CodesignKey>Apple Distribution: Andrew Esterhuysen (YT6V9JS4F9)</CodesignKey>
		<CodesignProvision>TurfTimer_Distribution_Provisioning_Profile</CodesignProvision>
		<EnableCodeSigning>true</EnableCodeSigning>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' and '$(Configuration)' == 'Debug'">
	  <CodesignKey>Apple Development: Created via API (BZW4P28WC4)</CodesignKey>
	  <CodesignProvision>TurfTime Development Provisioning Profile</CodesignProvision>
	  <EnableCodeSigning>true</EnableCodeSigning>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release Copy' ">
	  <CodesignKey>Apple Distribution: Andrew Esterhuysen (YT6V9JS4F9)</CodesignKey>
	  <CodesignProvision>TurfTimer_Distribution_Provisioning_Profile</CodesignProvision>
	  <EnableCodeSigning>true</EnableCodeSigning>
	  <ArchiveOnBuild>true</ArchiveOnBuild>
	  <MtouchLink>SdkOnly</MtouchLink>
	  <EnableSGenConc>true</EnableSGenConc>
	  <AndroidPackageFormat>aab</AndroidPackageFormat>
	  <AndroidKeyStore>true</AndroidKeyStore>
	  <AndroidSigningKeyStore>turftime.keystore</AndroidSigningKeyStore>
	  <AndroidSigningKeyAlias>turftime</AndroidSigningKeyAlias>
	  <AndroidSigningStorePass>$(AndroidSigningStorePassword)</AndroidSigningStorePass>
	  <AndroidSigningKeyPass>$(AndroidSigningKeyPassword)</AndroidSigningKeyPass>
	  <AndroidLinkTool>r8</AndroidLinkTool>
	  <RunAOTCompilation>true</RunAOTCompilation>
	  <PublishTrimmed>true</PublishTrimmed>
	  <CodesignKey>Apple Distribution: Andrew Esterhuysen (YT6V9JS4F9)</CodesignKey>
	  <CodesignProvision>TurfTimer_Distribution_Provisioning_Profile</CodesignProvision>
	  <EnableCodeSigning>true</EnableCodeSigning>
	  <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
	</PropertyGroup>
	<!-- Disabled: Having two Windows targets causes Windows App SDK errors with WindowsPackageType=None -->
	<!--<PropertyGroup>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100.1</TargetFrameworks>
	</PropertyGroup>-->

	<Target Name="GenerateBuildMetadata" BeforeTargets="BeforeCompile">
		<Exec Command="$(GetGitHashCommand)" ConsoleToMSBuild="true" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
		</Exec>

		<PropertyGroup>
			<GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown</GitCommitHash>
			<BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm"))</BuildTimestamp>
			<!-- Write to the TFM-level intermediate path (no RID suffix) so all inner RID builds
					 share the same single file and don't produce duplicate class definitions. -->
			<_BuildInfoDir Condition="'$(RuntimeIdentifier)' != ''">$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(IntermediateOutputPath)'))))\</_BuildInfoDir>
			<_BuildInfoDir Condition="'$(RuntimeIdentifier)' == ''">$(IntermediateOutputPath)</_BuildInfoDir>
			<BuildInfoContent>
// Auto-generated build metadata
namespace TurfTime2%3B

public static class BuildInfo
{
		public const string GitCommit = "$(GitCommitHash)"%3B
		public const string BuildTime = "$(BuildTimestamp) UTC"%3B
}
			</BuildInfoContent>
		</PropertyGroup>

		<WriteLinesToFile File="$(_BuildInfoDir)BuildInfo.g.cs" Lines="$(BuildInfoContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<Compile Include="$(_BuildInfoDir)BuildInfo.g.cs" />
		</ItemGroup>

		<Message Text="Build Metadata: Commit=$(GitCommitHash), Time=$(BuildTimestamp) UTC" Importance="high" />
	</Target>

</Project>
