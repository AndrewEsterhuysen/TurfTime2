<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041</TargetFrameworks>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>TurfTime2</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Turf Time</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.andrewestherhuysen.turftime</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>4.0.1</ApplicationDisplayVersion>
		<ApplicationVersion>5</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<EnableMsixTooling>true</EnableMsixTooling>
		<PublishSingleFile Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041'">true</PublishSingleFile>
		<SelfContained Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041'">true</SelfContained>
		<RuntimeIdentifier Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041'">win-x64</RuntimeIdentifier>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- iOS Release Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $(TargetFramework.Contains('ios'))">
		<CodesignKey>Apple Development</CodesignKey>
		<CodesignProvision>Automatic</CodesignProvision>
		<ArchiveOnBuild>true</ArchiveOnBuild>
		<MtouchLink>SdkOnly</MtouchLink>
		<EnableSGenConc>true</EnableSGenConc>
	</PropertyGroup>

	<!-- Android Release Configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $(TargetFramework.Contains('android'))">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>turftime.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>turftime</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(AndroidSigningStorePassword)</AndroidSigningStorePass> <!-- Note: The Android signing key password is the same as the store password in this case, but it can be different if desired.-->
    <AndroidSigningKeyPass>$(AndroidSigningKeyPassword)</AndroidSigningKeyPass> <!-- Note: The Android signing key password is the same as the store password in this case, but it can be different if desired.-->
    <AndroidLinkTool>r8</AndroidLinkTool>
		<RunAOTCompilation>true</RunAOTCompilation>
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\turftimer_splash.svg" Color="#512BD4" BaseSize="620,620" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="wwwroot\**" />
	</ItemGroup>

	<!-- Ensure wwwroot is copied to output for Windows -->
	<ItemGroup Condition="$(TargetFramework.Contains('windows'))">
		<Content Include="wwwroot\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<MauiAsset Remove="wwwroot\js\.editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<MauiCss Remove="wwwroot\css\styles-modern.css" />
	</ItemGroup>

	<!-- Firebase Configuration for Android -->
	<ItemGroup Condition="$(TargetFramework.Contains('android'))">
		<GoogleServicesJson Include="Platforms\Android\google-services.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Plugin.Firebase" Version="3.1.1" />
		<PackageReference Include="Plugin.Firebase.CloudMessaging" Version="3.1.1" />
		<PackageReference Include="QuestPDF" Version="2024.12.8" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="TurfTime2\GamePage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\HelpPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\LogPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\ReportsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\RotationStylePage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\SetupPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\SettingsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\SkinsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\TeamDetailsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="TurfTime2\TeamViewPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <None Update="TurfTime2\ChatPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </None>
	</ItemGroup>

	<!-- Generate build metadata at compile time -->
	<PropertyGroup>
		<GetGitHashCommand>git rev-parse --short HEAD</GetGitHashCommand>
		<GetGitHashCommand Condition="'$(OS)' == 'Windows_NT'">cmd /c git rev-parse --short HEAD</GetGitHashCommand>
	</PropertyGroup>
	<!-- Disabled: Having two Windows targets causes Windows App SDK errors with WindowsPackageType=None -->
	<!--<PropertyGroup>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100.1</TargetFrameworks>
	</PropertyGroup>-->

	<Target Name="GenerateBuildMetadata" BeforeTargets="BeforeCompile">
		<Exec Command="$(GetGitHashCommand)" ConsoleToMSBuild="true" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
		</Exec>

		<PropertyGroup>
			<GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown</GitCommitHash>
			<BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm"))</BuildTimestamp>
			<BuildInfoContent>
// Auto-generated build metadata
namespace TurfTime2%3B

public static class BuildInfo
{
		public const string GitCommit = "$(GitCommitHash)"%3B
		public const string BuildTime = "$(BuildTimestamp) UTC"%3B
}
			</BuildInfoContent>
		</PropertyGroup>

		<WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Lines="$(BuildInfoContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
		</ItemGroup>

		<Message Text="Build Metadata: Commit=$(GitCommitHash), Time=$(BuildTimestamp) UTC" Importance="high" />
	</Target>

</Project>
