<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.QrShareModal"
             Title="Share Team"
             Shell.PresentationMode="Modal">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Close" Clicked="OnCloseToolbarClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Share Team via QR Code"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding TeamName}" FontSize="18" FontAttributes="Bold" />
                <Label Text="{Binding PlayerCount, StringFormat='Players: {0}'}" FontSize="14" />
                <Label Text="{Binding EncodedSize, StringFormat='QR Size: {0} bytes'}" FontSize="12" TextColor="#666" />
            </VerticalStackLayout>
        </Frame>

        <Frame BorderColor="#000000" CornerRadius="10" Padding="10" HasShadow="True" HorizontalOptions="Center">
            <Image
                Source="{Binding QrImage}"
                WidthRequest="250"
                HeightRequest="250"
                Aspect="AspectFit" />
        </Frame>

        <Label
            Text="Send this QR code to another device. The recipient can scan it to import your team."
            FontSize="12"
            TextColor="#666"
            HorizontalTextAlignment="Center"
            Margin="0,10" />

        <VerticalStackLayout Spacing="10">
            <Button
                Text="Copy Share Link"
                Command="{Binding CopyLinkCommand}"
                BackgroundColor="#2196F3"
                TextColor="White"
                CornerRadius="8"
                Padding="15,12" />

            <Button
                Text="Share (iMessage/SMS)"
                Command="{Binding ShareCommand}"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="8"
                Padding="15,12" />

            <Button
                Text="Close"
                Command="{Binding CloseCommand}"
                BackgroundColor="#F44336"
                TextColor="White"
                CornerRadius="8"
                Padding="15,12" />
        </VerticalStackLayout>
    </VerticalStackLayout>
    </ScrollView>

</ContentPage>
