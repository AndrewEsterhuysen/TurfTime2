<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.WelcomePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D1F10" Offset="0.0" />
            <GradientStop Color="#050505" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- Greyscale watermark: splash image at very low opacity, centred -->
        <Image Source="turftimer_splash_512_512.png"
               Aspect="AspectFit"
               Opacity="0.08"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="420"
               HeightRequest="420">
            <!-- Desaturate via a colour filter overlay rendered beneath text -->
        </Image>

        <!-- Desaturate overlay: semi-transparent white layer over the image to wash colour further -->
        <BoxView Color="White"
                 Opacity="0.04"
                 VerticalOptions="Fill"
                 HorizontalOptions="Fill" />

        <!-- Welcome content on top -->
        <ScrollView VerticalOptions="Fill">
            <VerticalStackLayout Padding="24,48,24,32" Spacing="0">

                <!-- App logo / title line -->
                <Label Text="⏱ TurfTimer"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#E8E8E8"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4" />

                <Label Text="Your Sideline Companion"
                       FontSize="14"
                       TextColor="#A0A0A0"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,32" />

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="#333333" Margin="0,0,0,28" />

                <!-- Welcome heading -->
                <Label Text="Welcome to TurfTimer!"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,16" />

                <!-- Welcome body -->
                <Label TextColor="#CCCCCC"
                       FontSize="15"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,24">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="We're thrilled to have you on the pitch with us. TurfTimer is built by coaches, for coaches — designed to take the admin off your shoulders so you can focus on the game." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Current features heading -->
                <Label Text="✅  What's Available Right Now"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       Margin="0,0,0,10" />

                <Label TextColor="#C8C8C8"
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,24">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="🏆  " /><Span Text="Multiple Team Support" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — manage as many teams as you need, all stored locally on your device." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="💾  " /><Span Text="Local Data Retention" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — your rosters, game history, and settings are saved on-device so you're never caught without your data." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="🔄  " /><Span Text="Easy Substitution Management" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — a smart rotation queue ensures every player gets fair field time. Tap a player to move them up the queue. Perfect for fast-paced formats like fast fives where rotations happen frequently." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="📋  " /><Span Text="Game Reports" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — generate a clear post-game summary for each match, ready to share with your team." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,0,0,24" />

                <!-- Coming soon heading -->
                <Label Text="🚀  Coming Soon"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       Margin="0,0,0,10" />

                <Label TextColor="#B0B0B0"
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,24">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="☁️  " /><Span Text="Online Team Data Storage" FontAttributes="Bold" TextColor="#D0D0D0" /><Span Text=" — sync your rosters and game data securely to the cloud. Access from any device, anytime." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="👥  " /><Span Text="Multi-User Access Control" FontAttributes="Bold" TextColor="#D0D0D0" /><Span Text=" — dedicated roles for clubs and coaches (admin) and member parents (view-only), so everyone has the right level of visibility." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="📡  " /><Span Text="Live Game Updates" FontAttributes="Bold" TextColor="#D0D0D0" /><Span Text=" — family and supporters follow the action in real time from the sidelines or from home." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="💬  " /><Span Text="Team-Specific Integrated Chat" FontAttributes="Bold" TextColor="#D0D0D0" /><Span Text=" — keep all your team communication in one place, right inside the app." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="📍  " /><Span Text="Live Location Sharing" FontAttributes="Bold" TextColor="#D0D0D0" /><Span Text=" — share venue locations with team members so no one gets lost on match day." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="…and much more!" TextColor="#888888" FontAttributes="Italic" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,0,0,24" />

                <!-- Closing call-to-action -->
                <Label Text="Join Us on the Journey! 🌱"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,12" />

                <Label TextColor="#B8B8B8"
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,36">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="TurfTimer is actively growing, and your experience on the pitch shapes every feature we build. You're not just using an app — " />
                            <Span Text="you're part of its story." FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Span Text=" We can't wait to deliver everything that's coming, and we're grateful to have you with us every step of the way. Please share your feedback, suggestions, and feature requests — your input helps us build what truly adds value. Game on! 🎉" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Don't show again toggle -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="10"
                                       Margin="0,0,0,16">
                    <CheckBox x:Name="DontShowCheckBox"
                              Color="#1A7F3C"
                              VerticalOptions="Center" />
                    <Label Text="Don't show this again"
                           TextColor="#A0A0A0"
                           FontSize="14"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDontShowLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Close / Enter button -->
                <Button Text="Let's Go! ▶"
                        x:Name="CloseBtn"
                        Clicked="OnCloseClicked"
                        BackgroundColor="#1A7F3C"
                        TextColor="#FFFFFF"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="52"
                        HorizontalOptions="Fill"
                        Margin="0,0,0,16" />

                <!-- App version watermark -->
                <Label x:Name="VersionLabel"
                       FontSize="11"
                       TextColor="#444444"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,8" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
