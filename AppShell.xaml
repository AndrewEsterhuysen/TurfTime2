<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TurfTime2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TurfTime2"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True">

    <Shell.Resources>
        <Style TargetType="ShellContent">
            <Setter Property="Shell.NavBarIsVisible" Value="True" />
        </Style>
    </Shell.Resources>

    <TabBar>
        <ShellContent
            Title="Game"
            ContentTemplate="{DataTemplate local:GamePage}"
            Route="GamePage" />

        <ShellContent
            Title="Location"
            ContentTemplate="{DataTemplate local:SetupPage}"
            Route="SetupPage" />

        <ShellContent
            x:Name="ChatTab"
            Title="Chat"
            ContentTemplate="{DataTemplate local:ChatPage}"
            Route="ChatPage" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />

        <ShellContent
            Title="Help"
            ContentTemplate="{DataTemplate local:HelpPage}"
            Route="HelpPage" />
    </TabBar>
</Shell>
