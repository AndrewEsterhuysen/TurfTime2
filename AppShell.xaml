<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TurfTime2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TurfTime2"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True">

    <TabBar>
        <ShellContent
            Title="Game"
            ContentTemplate="{DataTemplate local:GamePage}"
            Route="GamePage" />

        <ShellContent
            Title="Location"
            ContentTemplate="{DataTemplate local:SetupPage}"
            Route="SetupPage" />

        <ShellContent
            Title="Log"
            ContentTemplate="{DataTemplate local:LogPage}"
            Route="LogPage" />

        <ShellContent
            Title="Help"
            ContentTemplate="{DataTemplate local:HelpPage}"
            Route="HelpPage" />
    </TabBar>
</Shell>
