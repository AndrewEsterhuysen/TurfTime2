rules_version = '2';

// Turf Time — Firestore security rules (aligned with Plugin.Firebase client paths)
// Deploy: firebase deploy --only firestore:rules --project turf-timer
//
// Model:
//   clubs/{clubId}/metadata/info
//   clubs/{clubId}/members/{uid}    (role: owner | admin | member; optional coachTeamId)
//   clubs/{clubId}/players/{playerId}  (club player list — owner/admin/coach; docs/club-players-spec.md)
//   teams/{teamId}/metadata/info    (+ optional clubId/clubName/kind)
//   teams/{teamId}/secrets/info     (inviteCode, adminCodeHash, creatorEmail — team admins)
//   clubs/{clubId}/secrets/info     (ownerRecoveryCodeHash — club owner)
//   teams/{teamId}/members/{uid}
//   teams/{teamId}/roster/data
//   teams/{teamId}/details/location  (match schedule / venue — admin write, member read)
//   teams/{teamId}/details/kit       (Details → Kit — admin write, member read)
//   teams/{teamId}/details/duties    (Details → Duties — admin write, member read)
//   teams/{teamId}/details/settings  (team feature flags, e.g. nominationsEnabled — admin write, member read)
//   teams/{teamId}/messages/{messageId}
//   teams/{teamId}/sessions/{sessionId}
//   teams/{teamId}/sessions/{sessionId}/nominations/{uid}   (player of the match votes)
//   teams/{teamId}/sessions/{sessionId}/nominationsMeta/status
//   mcp_* (server-only MCP OAuth state; Admin SDK only)
//   teams/{teamId}/public/invite     (join reverse-lookup under team tree)
//   invite_codes/{code}             (O(1) join lookup; may include clubId/clubName)
//   activeControllers/{teamId}      (presence index for stale controller release)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamAdmin(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Team creator (metadata.createdBy) — only they may hard-delete the whole team.
    function isTeamOwner(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/metadata/info)
        && get(/databases/$(database)/documents/teams/$(teamId)/metadata/info).data.createdBy == request.auth.uid;
    }

    // Team data readers: joined members, plus the team creator (metadata.createdBy). The owner
    // clause keeps DeleteTeamAsOwner working: it deletes members/* first and then lists
    // messages/sessions/logs to delete them, at which point the owner is no longer a member.
    function canReadTeam(teamId) {
      return isTeamMember(teamId) || isTeamOwner(teamId);
    }

    function clubMetaPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/metadata/info;
    }

    function clubMemberPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    function isClubOwner(clubId) {
      return signedIn()
        && exists(clubMetaPath(clubId))
        && get(clubMetaPath(clubId)).data.createdBy == request.auth.uid;
    }

    function isClubOwnerOrAdmin(clubId) {
      return isClubOwner(clubId)
        || (
          signedIn()
          && exists(clubMemberPath(clubId))
          && get(clubMemberPath(clubId)).data.role in ['owner', 'admin']
        );
    }

    function isClubMember(clubId) {
      return isClubOwner(clubId)
        || (signedIn() && exists(clubMemberPath(clubId)));
    }

    function teamMetaPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/metadata/info;
    }

    function teamSecretsPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/secrets/info;
    }

    function clubSecretsPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/secrets/info;
    }

    function inviteDocPath(code) {
      return /databases/$(database)/documents/invite_codes/$(code);
    }

    function inviteProofOk(teamId) {
      let code = request.resource.data.get('joinInviteCode', '');
      return request.resource.data.role == 'member'
        && code is string
        && code != ''
        && exists(inviteDocPath(code))
        && get(inviteDocPath(code)).data.teamId == teamId;
    }

    function teamAdminHashMatches(teamId, hash) {
      return hash is string && hash != ''
        && (
          (exists(teamSecretsPath(teamId))
            && get(teamSecretsPath(teamId)).data.get('adminCodeHash', '') == hash)
          || (exists(teamMetaPath(teamId))
            && get(teamMetaPath(teamId)).data.get('adminCodeHash', '') == hash)
        );
    }

    function clubRecoveryHashMatches(clubId, hash) {
      return hash is string && hash != ''
        && (
          (exists(clubSecretsPath(clubId))
            && get(clubSecretsPath(clubId)).data.get('ownerRecoveryCodeHash', '') == hash)
          || (exists(clubMetaPath(clubId))
            && get(clubMetaPath(clubId)).data.get('ownerRecoveryCodeHash', '') == hash)
        );
    }

    function clubIdUnchanged() {
      return resource.data.get('clubId', '') == request.resource.data.get('clubId', '');
    }

    function teamBelongsToClub(teamId, clubId) {
      return teamId is string && teamId != ''
        && exists(teamMetaPath(teamId))
        && get(teamMetaPath(teamId)).data.get('clubId', '') == clubId;
    }

    function clubJoinViaTeamOk(clubId) {
      let t = request.resource.data.get('joinedViaTeamId', '');
      return request.resource.data.role == 'member'
        && t is string
        && t != ''
        && isTeamMember(t)
        && teamBelongsToClub(t, clubId);
    }


    function isClubOwnerOfTeam(teamId) {
      return exists(teamMetaPath(teamId))
        && get(teamMetaPath(teamId)).data.get('clubId', '') != ''
        && isClubOwner(get(teamMetaPath(teamId)).data.clubId);
    }


    // Club metadata — create any signed-in; updates by Owner.
    // Recovery: signed-in user may rebind createdBy to self when only ownership
    // recovery fields change (client validates Club Owner Recovery Code first).
    match /clubs/{clubId}/metadata/info {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['clubName', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (
        (
          isClubOwner(clubId)
          && request.resource.data.createdBy == resource.data.createdBy
        )
        || (
          request.resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['createdBy', 'previousOwnerUid', 'ownershipRecoveredAt', 'recoveryHash'])
          && clubRecoveryHashMatches(clubId, request.resource.data.get('recoveryHash', ''))
        )
      );
      allow delete: if isClubOwner(clubId);
    }

    // Club secrets — recovery hash. Owner only. Written at club create; migration copies existing.
    match /clubs/{clubId}/secrets/{docId} {
      allow read, create, update, delete: if isClubOwner(clubId);
    }

    // Club members — owner only via club create (metadata.createdBy); members via a
    // club-team membership; admins granted only by the owner (update).
    match /clubs/{clubId}/members/{userId} {
      allow read: if isClubMember(clubId)
        || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn() && request.auth.uid == userId
        && (
          (
            request.resource.data.role == 'owner'
            && isClubOwner(clubId)
          )
          || clubJoinViaTeamOk(clubId)
        );

      // Owner may promote/demote (admin/member). A second owner can only be the caller
      // (already the metadata owner). Self-updates: profile / coachTeamId / joinedViaTeamId.
      allow update: if (
          isClubOwner(clubId)
          && request.resource.data.role in ['owner', 'admin', 'member']
          && (request.resource.data.role != 'owner' || userId == request.auth.uid)
        )
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'addedAt', 'coachTeamId', 'joinedViaTeamId', 'uid', 'rejoinedAt'])
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isClubOwner(clubId)
        || (signedIn() && request.auth.uid == userId);
    }

    // ── Club player list (docs/club-players-spec.md §4.1, §9) ─────────────────
    // Club coach = admin of one of the club's teams. Rules can't search teams, so the
    // client records the team on the caller's club membership (coachTeamId) and the
    // rule checks it live: caller is Admin of that team AND that team belongs to this
    // club. Losing team Admin (or the team leaving the club) removes coach access at once.
    function coachTeamOk(clubId, t) {
      return t is string && t != ''
        && exists(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid))
        && isTeamAdmin(t)
        && exists(teamMetaPath(t))
        && get(teamMetaPath(t)).data.get('clubId', '') == clubId;
    }

    function isClubCoach(clubId) {
      return signedIn()
        && exists(clubMemberPath(clubId))
        && coachTeamOk(clubId, get(clubMemberPath(clubId)).data.get('coachTeamId', ''));
    }

    function isClubManager(clubId) {
      return isClubOwnerOrAdmin(clubId) || isClubCoach(clubId);
    }

    // ISO date YYYY-MM-DD (full date of birth, decision 2).
    function isIsoDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function clubPlayerFieldsOk(d) {
      return d.keys().hasOnly(['playerId', 'name', 'preferredName', 'nameKey', 'dateOfBirth',
          'dobYear', 'dobMonth', 'dobDay',
          'teams', 'teamIds', 'assignmentTeamId', 'status', 'totals', 'byTeam', 'borrowed', 'borrowedByTeam',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'lastUsedAt'])
        && d.name is string && d.name.trim().size() > 0 && d.name.size() <= 80
        && (d.get('preferredName', null) == null
            || (d.preferredName is string && d.preferredName.size() <= 40))
        && d.nameKey is string && d.nameKey.size() <= 160
        && (d.get('dateOfBirth', null) == null || isIsoDate(d.dateOfBirth))
        && d.status in ['active', 'archived']
        && (!('teamIds' in d) || d.teamIds is list)
        && (!('teams' in d) || d.teams is list)
        && (!('assignmentTeamId' in d) || d.assignmentTeamId is string)
        && (
          !d.keys().hasAny(['dobYear', 'dobMonth', 'dobDay'])
          || (
            d.dobYear is int && d.dobMonth is int && d.dobDay is int
            && d.dobYear >= 1950 && d.dobYear <= 2100
            && d.dobMonth >= 1 && d.dobMonth <= 12
            && d.dobDay >= 1 && d.dobDay <= 31
          )
        );
    }

    // Age on 1 January of season (decision 1): born 1 Jan counts as already that age.
    function ageOn1Jan(y, m, d, season) {
      return season - y - ((m == 1 && d == 1) ? 0 : 1);
    }

    // Play up, never down. Open has no limit. Requires season + maxAgeOn1Jan on the team
    // and dobYear/Month/Day on the player (mirrors dateOfBirth for rules arithmetic).
    function playerEligibleForTeam(player, teamId) {
      return exists(teamMetaPath(teamId))
        && playerEligibleForMeta(player, get(teamMetaPath(teamId)).data);
    }

    function playerEligibleForMeta(player, meta) {
      return meta.get('ageGroup', '') in ['Open', 'open']
        || (
          meta.get('season', 0) is int
          && meta.get('maxAgeOn1Jan', -1) is int
          && player.get('dobYear', 0) is int
          && player.get('dobMonth', 0) is int
          && player.get('dobDay', 0) is int
          && ageOn1Jan(player.dobYear, player.dobMonth, player.dobDay, meta.season)
            <= meta.maxAgeOn1Jan
        );
    }

    function addedOnlyTeam(beforeIds, afterIds, t) {
      return t is string && t != ''
        && !beforeIds.hasAll([t]) && afterIds.hasAll([t])
        && afterIds.size() == beforeIds.size() + 1
        && afterIds.hasAll(beforeIds);
    }

    function removedOnlyTeam(beforeIds, afterIds, t) {
      return t is string && t != ''
        && beforeIds.hasAll([t]) && !afterIds.hasAll([t])
        && beforeIds.size() == afterIds.size() + 1
        && beforeIds.hasAll(afterIds);
    }

    function canAssignToTeam(clubId, t) {
      return isClubOwnerOrAdmin(clubId)
        || (isClubCoach(clubId) && get(clubMemberPath(clubId)).data.get('coachTeamId', '') == t);
    }

    // One team added or removed per write. assignmentTeamId names that team so rules
    // can check eligibility without walking the list for the new id.
    function assignmentWriteOk(clubId) {
      let beforeIds = resource.data.get('teamIds', []);
      let afterIds = request.resource.data.get('teamIds', []);
      let t = request.resource.data.get('assignmentTeamId', '');
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['teamIds', 'teams', 'updatedAt', 'updatedBy', 'lastUsedAt',
              'assignmentTeamId', 'dobYear', 'dobMonth', 'dobDay'])
        && teamBelongsToClub(t, clubId)
        && canAssignToTeam(clubId, t)
        && (
          removedOnlyTeam(beforeIds, afterIds, t)
          || (addedOnlyTeam(beforeIds, afterIds, t)
              && playerEligibleForTeam(request.resource.data, t))
        );
    }

    // Stats maps are written only by the Cloud Function (Admin SDK), never by clients.
    function noClientStats(d) {
      return !d.keys().hasAny(['totals', 'byTeam', 'borrowed', 'borrowedByTeam']);
    }

    match /clubs/{clubId}/players/{playerId} {
      allow read: if isClubManager(clubId);

      // New players: date of birth required; no team assignments on create.
      allow create: if isClubManager(clubId)
        && clubPlayerFieldsOk(request.resource.data)
        && noClientStats(request.resource.data)
        && isIsoDate(request.resource.data.get('dateOfBirth', null))
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('playerId', playerId) == playerId
        && request.resource.data.get('teamIds', []).size() == 0
        && request.resource.data.get('teams', []).size() == 0;

      // Owner/Admin: profile fields (date of birth, archive) except stats and creation stamps.
      // Coach: name / preferred name only, unless this write is an assignment to their team.
      // Assign / unassign (owner, admin, or the team's coach): one team per write, play-up only.
      allow update: if clubPlayerFieldsOk(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['totals', 'byTeam', 'borrowed', 'borrowedByTeam', 'createdAt', 'createdBy', 'playerId'])
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['teamIds', 'teams'])
            && assignmentWriteOk(clubId)
          )
          || (
            !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['teamIds', 'teams'])
            && (
              isClubOwnerOrAdmin(clubId)
              || (
                isClubCoach(clubId)
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['name', 'preferredName', 'nameKey', 'updatedAt', 'updatedBy', 'lastUsedAt'])
              )
            )
          )
        );

      allow delete: if isClubOwnerOrAdmin(clubId);

      // Per-match stats for this player (keyed by session id so re-saves overwrite).
      // Totals are computed on the client; this subcollection is the source of truth.
      // v1 fields: matches/minutes/secondsPlayed/goals/assists/POTM (decision 7). No borrowed field.
      // secondsPlayed is optional so rows written before this field (minutes only) remain valid.
      match /matches/{sessionId} {
        allow read: if isClubManager(clubId);

        function clubPlayerMatchFieldsOk(d) {
          return d.keys().hasOnly(['sessionId', 'playerId', 'clubId', 'teamId', 'teamName',
                  'matchDate', 'season', 'minutes', 'secondsPlayed', 'goals', 'assists', 'potm',
                  'playerName', 'updatedAt', 'updatedBy'])
            && d.sessionId == sessionId
            && d.playerId == playerId
            && d.clubId == clubId
            && d.teamId is string && d.teamId != ''
            && (d.get('teamName', '') is string)
            && (d.get('playerName', '') is string)
            && d.season is int && d.season >= 2000 && d.season <= 2100
            && d.minutes is int && d.minutes >= 0 && d.minutes <= 300
            && (!('secondsPlayed' in d)
                || (d.secondsPlayed is int && d.secondsPlayed >= 0 && d.secondsPlayed <= 18000))
            && d.goals is int && d.goals >= 0 && d.goals <= 50
            && d.assists is int && d.assists >= 0 && d.assists <= 50
            && d.potm is bool;
        }

        function canWritePlayerMatch() {
          return clubPlayerMatchFieldsOk(request.resource.data)
            && teamBelongsToClub(request.resource.data.teamId, clubId)
            && (isClubOwnerOrAdmin(clubId) || isTeamMember(request.resource.data.teamId));
        }

        allow create, update: if canWritePlayerMatch();
        allow delete: if isClubOwnerOrAdmin(clubId)
          || (resource.data.teamId is string && isTeamMember(resource.data.teamId));
      }
    }

    // O(1) invite lookup (root collection)
    match /invite_codes/{inviteCode} {
      // Get-by-id only: you must already know the code. Listing the collection
      // (or querying all codes) is denied so invite codes cannot be harvested.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['teamId', 'teamName', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || (resource.data.teamId is string && isTeamAdmin(resource.data.teamId))
        );
    }

    // Firebase data reads: presence index for releaseStaleGameControllers (avoids
    // scanning every teams/*/roster/data each minute). Doc id = teamId.
    // Clients (admins) upsert/delete; Admin SDK in Cloud Functions also writes.
    match /activeControllers/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create, update, delete: if isTeamAdmin(teamId);
    }

    // Team metadata — nickname: any signed-in may create without clubId.
    // Clubbed: create requires clubId and caller must be club Owner/Admin.
    // createdBy may change when current Owner transfers, or via Owner Recovery
    // (client validates Team Owner Recovery Code; only ownership fields may change).
    match /teams/{teamId}/metadata/info {
      allow read: if signedIn();
      allow create: if signedIn() && (
        !('clubId' in request.resource.data)
        || request.resource.data.clubId == null
        || request.resource.data.clubId == ''
        || isClubOwnerOrAdmin(request.resource.data.clubId)
      );
      // clubId is immutable after create (including by team admins). Club linkage
      // is set only at create, by a club owner/admin when the team is club-managed.
      allow update: if signedIn() && clubIdUnchanged() && (
        (
          isTeamAdmin(teamId)
          && (
            request.resource.data.createdBy == resource.data.createdBy
            || isTeamOwner(teamId)
          )
        )
        || (
          // Owner recovery reclaim (after client proves the recovery code by
          // writing an admin membership with adminCodeHash).
          isTeamAdmin(teamId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['createdBy', 'previousOwnerUid', 'ownershipRecoveredAt', 'lastActivityUtc'])
        )
      );
      allow delete: if isTeamAdmin(teamId);
    }

    // Team secrets — invite code, admin recovery hash, creator email.
    // Readable by team admins and the metadata creator (so the creator can write
    // this during Create Team, and recoverers can read it once they are admin).
    match /teams/{teamId}/secrets/{docId} {
      allow read: if isTeamAdmin(teamId) || isTeamOwner(teamId);
      allow create, update: if isTeamAdmin(teamId) || isTeamOwner(teamId);
      allow delete: if isTeamOwner(teamId);
    }

    // Optional public invite doc under the team (for collection-group join)
    match /teams/{teamId}/public/{docId} {
      allow read: if signedIn();
      // Creator may write while bootstrapping the team (before membership is readable everywhere)
      allow create, update: if signedIn()
        && (
          isTeamAdmin(teamId)
          || request.resource.data.createdBy == request.auth.uid
        );
      allow delete: if isTeamAdmin(teamId);
    }

    // Members
    match /teams/{teamId}/members/{userId} {
      allow read: if isTeamMember(teamId)
        || (signedIn() && request.auth.uid == userId);

      // Creator may take admin when they just created the team (metadata.createdBy).
      // Everyone else joins as member with a valid invite code on the write, or as
      // admin by presenting adminCodeHash that matches team secrets (or metadata
      // until secrets are migrated). Existing memberships are grandfathered (update/delete only).
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['admin', 'member']
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (
          (request.resource.data.role == 'admin' && isTeamOwner(teamId))
          || inviteProofOk(teamId)
          || (request.resource.data.role == 'admin'
              && teamAdminHashMatches(teamId, request.resource.data.get('adminCodeHash', '')))
          || (request.resource.data.role == 'admin' && isClubOwnerOfTeam(teamId))
        );

      // Admins may promote/demote (admin/member only) and may not change uid.
      // Self may update profile fields (including stripping join proof fields).
      // Self may become admin only by presenting a matching adminCodeHash.
      allow update: if signedIn()
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (
          (isTeamAdmin(teamId) && request.resource.data.role in ['admin', 'member'])
          || (request.auth.uid == userId && request.resource.data.role == resource.data.role)
          || (request.auth.uid == userId && request.resource.data.role == 'admin'
              && teamAdminHashMatches(teamId, request.resource.data.get('adminCodeHash', '')))
          || (request.auth.uid == userId && request.resource.data.role == 'admin'
              && isClubOwnerOfTeam(teamId))
        );

      allow delete: if signedIn()
        && (request.auth.uid == userId || isTeamAdmin(teamId));
    }

    // Select Team discovery: collection-group query members where uid == me.
    // Must reference ONLY fields the query filters on: Firestore can't prove a
    // path-variable check (userId == auth.uid) from a where('uid') filter, so the
    // whole query was rejected with PERMISSION_DENIED. uid is guarded on write
    // (self writes must set uid == doc id; Cloud Function stamps it otherwise).
    // Applies to teams/*/members and clubs/*/members; the client keeps only teams/*.
    match /{path=**}/members/{userId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Roster
    // Members read and write (game control / controller requests are member PATCHes).
    // Team create writes members/{uid} before roster/data, so the creator is already a member.
    match /teams/{teamId}/roster/data {
      allow read: if canReadTeam(teamId);
      allow write: if canReadTeam(teamId);
    }

    // Match schedule / Location (Details → Location)
    // Members read; admins write. Keep in sync with IMatchScheduleService.
    match /teams/{teamId}/details/location {
      allow read: if isTeamMember(teamId);
      allow create, update: if isTeamAdmin(teamId);
      allow delete: if isTeamAdmin(teamId);
    }

    // Details → Kit, Duties, and team settings (string fields + lastModifiedUtc/updatedByUid).
    // Same access as Location: members read; admins write. Keep in sync with ITeamDetailsDocService.
    match /teams/{teamId}/details/{docId} {
      allow read: if docId in ['kit', 'duties', 'settings'] && isTeamMember(teamId);
      allow create, update, delete: if docId in ['kit', 'duties', 'settings'] && isTeamAdmin(teamId);
    }

    // Chat messages
    // Create: author only. Update: reactions (any signed-in), soft-delete (author/admin),
    // pin (admin). Immutable core fields (userId/timestamp/senderName) must not change
    // on reaction/pin updates; soft-delete may set isDeleted + deletedAt.
    match /teams/{teamId}/messages/{messageId} {
      allow read: if canReadTeam(teamId);
      allow create: if isTeamMember(teamId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;

      allow update: if isTeamMember(teamId) && (
        // Toggle reactions — only the reactions map may change
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.timestamp == resource.data.timestamp
        )
        // Soft-delete for everyone (author or team admin/coach)
        || (
          (resource.data.userId == request.auth.uid || isTeamAdmin(teamId))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isDeleted', 'deletedAt'])
          && request.resource.data.isDeleted == true
        )
        // Admin pin / unpin
        || (
          isTeamAdmin(teamId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isPinned', 'pinnedAt', 'pinnedBy'])
        )
      );

      // Hard delete: owner cascade, admin, or the original author
      allow delete: if isTeamOwner(teamId)
        || isTeamAdmin(teamId)
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Game sessions (reports)
    // Delete: Admins, or the team owner during the DeleteTeamAsOwner cascade
    // (which removes members/* before sessions, so the owner is no longer an Admin).
    match /teams/{teamId}/sessions/{sessionId} {
      allow read: if canReadTeam(teamId);
      allow create, update: if isTeamMember(teamId);
      allow delete: if isTeamOwner(teamId) || isTeamAdmin(teamId);
    }

    // Player of the match nominations (docs/nominations-spec.md §5).
    // One vote per member per session: doc id = voter uid, so a new vote overwrites the old one.
    // Voting closes when an Admin sets nominationsMeta/status.closed, or 24 hours after the
    // session's endTime, whichever comes first. Keep in sync with INominationService.
    function sessionDocPath(teamId, sessionId) {
      return /databases/$(database)/documents/teams/$(teamId)/sessions/$(sessionId);
    }

    function nominationsStatusPath(teamId, sessionId) {
      return /databases/$(database)/documents/teams/$(teamId)/sessions/$(sessionId)/nominationsMeta/status;
    }

    function sessionEnded(teamId, sessionId) {
      return exists(sessionDocPath(teamId, sessionId))
        && 'endTime' in get(sessionDocPath(teamId, sessionId)).data
        && get(sessionDocPath(teamId, sessionId)).data.endTime is timestamp;
    }

    function nominationsSettingsPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/details/settings;
    }

    // Default ON when the settings doc or field is missing (existing shared teams).
    function teamNominationsEnabled(teamId) {
      return !exists(nominationsSettingsPath(teamId))
        || !('nominationsEnabled' in get(nominationsSettingsPath(teamId)).data)
        || get(nominationsSettingsPath(teamId)).data.nominationsEnabled != 'false';
    }

    function nominationsOpen(teamId, sessionId) {
      return sessionEnded(teamId, sessionId)
        && request.time <= get(sessionDocPath(teamId, sessionId)).data.endTime + duration.value(24, 'h')
        && (
          !exists(nominationsStatusPath(teamId, sessionId))
          || get(nominationsStatusPath(teamId, sessionId)).data.get('closed', false) != true
        );
    }

    function nominationPayloadOk(nominatorId) {
      let d = request.resource.data;
      return d.keys().hasAll(['nominatorId', 'nomineeSlotId', 'nomineeName', 'timestamp'])
        && d.keys().hasOnly(['nominatorId', 'nominatorDisplayName', 'nomineeSlotId', 'nomineeName', 'timestamp'])
        && d.nominatorId == request.auth.uid
        && d.nominatorId == nominatorId
        && d.nomineeSlotId is int
        && d.nomineeSlotId >= 1
        && d.nomineeName is string
        && d.nomineeName.size() > 0
        && d.nomineeName.size() <= 80
        && d.timestamp is timestamp
        && (!('nominatorDisplayName' in d)
            || (d.nominatorDisplayName is string && d.nominatorDisplayName.size() <= 80));
    }

    match /teams/{teamId}/sessions/{sessionId}/nominations/{nominatorId} {
      // The live tally is Admin-only while voting is open (it could sway voters):
      // a member may read only their own vote until voting closes; Admins (and the
      // team owner, for the delete cascade) can read all; everyone can read all after close.
      allow read: if canReadTeam(teamId) && (
          nominatorId == request.auth.uid
          || isTeamAdmin(teamId)
          || isTeamOwner(teamId)
          || !nominationsOpen(teamId, sessionId)
        );

      allow create: if isTeamMember(teamId)
        && nominatorId == request.auth.uid
        && nominationPayloadOk(nominatorId)
        && nominationsOpen(teamId, sessionId)
        && teamNominationsEnabled(teamId);

      allow update: if isTeamMember(teamId)
        && nominatorId == request.auth.uid
        && resource.data.nominatorId == request.auth.uid
        && nominationPayloadOk(nominatorId)
        && nominationsOpen(teamId, sessionId)
        && teamNominationsEnabled(teamId);

      // Members may withdraw while open; Admins may remove a vote at any time;
      // the team owner may delete during the DeleteTeamAsOwner cascade.
      allow delete: if (
          isTeamMember(teamId)
          && resource.data.nominatorId == request.auth.uid
          && nominationsOpen(teamId, sessionId)
        )
        || isTeamAdmin(teamId)
        || isTeamOwner(teamId);
    }

    // Admin-only close flag for a session's nominations. The team creator counts as an
    // Admin here (as in the app), even if their members doc role isn't 'admin'.
    match /teams/{teamId}/sessions/{sessionId}/nominationsMeta/{docId} {
      allow read: if docId == 'status' && canReadTeam(teamId);
      allow create, update: if docId == 'status'
        && (isTeamAdmin(teamId) || (isTeamMember(teamId) && isTeamOwner(teamId)))
        && request.resource.data.closed is bool;
      allow delete: if docId == 'status' && (isTeamAdmin(teamId) || isTeamOwner(teamId));
    }

    // Game logs
    match /teams/{teamId}/logs/{logId} {
      allow read, write: if canReadTeam(teamId);
    }

    // MCP server (mcp-server/) state: OAuth clients, auth codes, refresh grants, link codes.
    // Server-only: written and read with the Admin SDK, never by clients.
    match /mcp_clients/{id} { allow read, write: if false; }
    match /mcp_auth_codes/{id} { allow read, write: if false; }
    match /mcp_auth_requests/{id} { allow read, write: if false; }
    match /mcp_grants/{id} { allow read, write: if false; }
    match /mcp_link_codes/{id} { allow read, write: if false; }

    // Legacy paths
    match /rosters/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /logs/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
    }
  }
}
