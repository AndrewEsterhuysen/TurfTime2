rules_version = '2';

// Turf Time — Firestore security rules (aligned with Plugin.Firebase client paths)
// Deploy: firebase deploy --only firestore:rules --project turf-timer
//
// Model:
//   clubs/{clubId}/metadata/info
//   clubs/{clubId}/members/{uid}    (role: owner | admin | member)
//   teams/{teamId}/metadata/info    (+ optional clubId/clubName/kind)
//   teams/{teamId}/members/{uid}
//   teams/{teamId}/roster/data
//   teams/{teamId}/details/location  (match schedule / venue — admin write, member read)
//   teams/{teamId}/details/kit       (Details → Kit — admin write, member read)
//   teams/{teamId}/details/duties    (Details → Duties — admin write, member read)
//   teams/{teamId}/messages/{messageId}
//   teams/{teamId}/sessions/{sessionId}
//   teams/{teamId}/sessions/{sessionId}/nominations/{uid}   (player of the match votes)
//   teams/{teamId}/sessions/{sessionId}/nominationsMeta/status
//   mcp_* (server-only MCP OAuth state; Admin SDK only)
//   teams/{teamId}/public/invite     (join reverse-lookup under team tree)
//   invite_codes/{code}             (O(1) join lookup; may include clubId/clubName)
//   activeControllers/{teamId}      (presence index for stale controller release)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamAdmin(teamId) {
      return signedIn()
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Team creator (metadata.createdBy) — only they may hard-delete the whole team.
    function isTeamOwner(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/metadata/info)
        && get(/databases/$(database)/documents/teams/$(teamId)/metadata/info).data.createdBy == request.auth.uid;
    }

    // Team data readers: joined members, plus the team creator (metadata.createdBy). The owner
    // clause keeps DeleteTeamAsOwner working: it deletes members/* first and then lists
    // messages/sessions/logs to delete them, at which point the owner is no longer a member.
    function canReadTeam(teamId) {
      return isTeamMember(teamId) || isTeamOwner(teamId);
    }

    function clubMetaPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/metadata/info;
    }

    function clubMemberPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    function isClubOwner(clubId) {
      return signedIn()
        && exists(clubMetaPath(clubId))
        && get(clubMetaPath(clubId)).data.createdBy == request.auth.uid;
    }

    function isClubOwnerOrAdmin(clubId) {
      return isClubOwner(clubId)
        || (
          signedIn()
          && exists(clubMemberPath(clubId))
          && get(clubMemberPath(clubId)).data.role in ['owner', 'admin']
        );
    }

    function isClubMember(clubId) {
      return isClubOwner(clubId)
        || (signedIn() && exists(clubMemberPath(clubId)));
    }

    // Club metadata — create any signed-in; updates by Owner.
    // Recovery: signed-in user may rebind createdBy to self when only ownership
    // recovery fields change (client validates Club Owner Recovery Code first).
    match /clubs/{clubId}/metadata/info {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['clubName', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (
        (
          isClubOwner(clubId)
          && request.resource.data.createdBy == resource.data.createdBy
        )
        || (
          request.resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['createdBy', 'previousOwnerUid', 'ownershipRecoveredAt'])
        )
      );
      allow delete: if isClubOwner(clubId);
    }

    // Club members — Owner elevates Admins; self-join as member (via team invite path).
    match /clubs/{clubId}/members/{userId} {
      allow read: if isClubMember(clubId)
        || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['owner', 'admin', 'member'];

      allow update: if isClubOwner(clubId)
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'addedAt'])
        );

      allow delete: if isClubOwner(clubId)
        || (signedIn() && request.auth.uid == userId);
    }

    // O(1) invite lookup (root collection)
    match /invite_codes/{inviteCode} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['teamId', 'teamName', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    // Firebase data reads: presence index for releaseStaleGameControllers (avoids
    // scanning every teams/*/roster/data each minute). Doc id = teamId.
    // Clients (admins) upsert/delete; Admin SDK in Cloud Functions also writes.
    match /activeControllers/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create, update, delete: if isTeamAdmin(teamId);
    }

    // Team metadata — nickname: any signed-in may create without clubId.
    // Clubbed: create requires clubId and caller must be club Owner/Admin.
    // createdBy may change when current Owner transfers, or via Owner Recovery
    // (client validates Team Owner Recovery Code; only ownership fields may change).
    match /teams/{teamId}/metadata/info {
      allow read: if signedIn();
      allow create: if signedIn() && (
        !('clubId' in request.resource.data)
        || request.resource.data.clubId == null
        || request.resource.data.clubId == ''
        || isClubOwnerOrAdmin(request.resource.data.clubId)
      );
      allow update: if signedIn() && (
        (
          isTeamAdmin(teamId)
          && (
            request.resource.data.createdBy == resource.data.createdBy
            || isTeamOwner(teamId)
          )
        )
        || (
          // Owner recovery reclaim (after client validates recovery code)
          isTeamAdmin(teamId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['createdBy', 'previousOwnerUid', 'ownershipRecoveredAt', 'lastActivityUtc'])
        )
      );
      allow delete: if isTeamAdmin(teamId);
    }

    // Optional public invite doc under the team (for collection-group join)
    match /teams/{teamId}/public/{docId} {
      allow read: if signedIn();
      // Creator may write while bootstrapping the team (before membership is readable everywhere)
      allow create, update: if signedIn()
        && (
          isTeamAdmin(teamId)
          || request.resource.data.createdBy == request.auth.uid
        );
      allow delete: if isTeamAdmin(teamId);
    }

    // Members
    match /teams/{teamId}/members/{userId} {
      allow read: if isTeamMember(teamId)
        || (signedIn() && request.auth.uid == userId);

      // Self join / self create (new team admin or invite join)
      allow create: if signedIn() && request.auth.uid == userId;

      // Admins manage members; users may update their own profile/token fields
      allow update: if isTeamAdmin(teamId)
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'fcmTokens', 'tokenUpdatedAt', 'joinedAt', 'rejoinedAt', 'uid'])
          && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        );

      allow delete: if isTeamAdmin(teamId)
        || (signedIn() && request.auth.uid == userId);
    }

    // Select Team discovery: collection-group query members where uid == me.
    // Must reference ONLY fields the query filters on: Firestore can't prove a
    // path-variable check (userId == auth.uid) from a where('uid') filter, so the
    // whole query was rejected with PERMISSION_DENIED. uid is guarded on write
    // (self writes must set uid == doc id; Cloud Function stamps it otherwise).
    // Applies to teams/*/members and clubs/*/members; the client keeps only teams/*.
    match /{path=**}/members/{userId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Roster
    // Members read and write (game control / controller requests are member PATCHes).
    // Team create writes members/{uid} before roster/data, so the creator is already a member.
    match /teams/{teamId}/roster/data {
      allow read: if canReadTeam(teamId);
      allow write: if canReadTeam(teamId);
    }

    // Match schedule / Location (Details → Location)
    // Members read; admins write. Keep in sync with IMatchScheduleService.
    match /teams/{teamId}/details/location {
      allow read: if isTeamMember(teamId);
      allow create, update: if isTeamAdmin(teamId);
      allow delete: if isTeamAdmin(teamId);
    }

    // Details → Kit and Details → Duties (string fields + lastModifiedUtc/updatedByUid).
    // Same access as Location: members read; admins write. Keep in sync with ITeamDetailsDocService.
    match /teams/{teamId}/details/{docId} {
      allow read: if docId in ['kit', 'duties'] && isTeamMember(teamId);
      allow create, update, delete: if docId in ['kit', 'duties'] && isTeamAdmin(teamId);
    }

    // Chat messages
    // Create: author only. Update: reactions (any signed-in), soft-delete (author/admin),
    // pin (admin). Immutable core fields (userId/timestamp/senderName) must not change
    // on reaction/pin updates; soft-delete may set isDeleted + deletedAt.
    match /teams/{teamId}/messages/{messageId} {
      allow read: if canReadTeam(teamId);
      allow create: if isTeamMember(teamId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;

      allow update: if isTeamMember(teamId) && (
        // Toggle reactions — only the reactions map may change
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.timestamp == resource.data.timestamp
        )
        // Soft-delete for everyone (author or team admin/coach)
        || (
          (resource.data.userId == request.auth.uid || isTeamAdmin(teamId))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isDeleted', 'deletedAt'])
          && request.resource.data.isDeleted == true
        )
        // Admin pin / unpin
        || (
          isTeamAdmin(teamId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isPinned', 'pinnedAt', 'pinnedBy'])
        )
      );

      // Hard delete: owner cascade, admin, or the original author
      allow delete: if isTeamOwner(teamId)
        || isTeamAdmin(teamId)
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Game sessions (reports)
    // Delete: Admins, or the team owner during the DeleteTeamAsOwner cascade
    // (which removes members/* before sessions, so the owner is no longer an Admin).
    match /teams/{teamId}/sessions/{sessionId} {
      allow read: if canReadTeam(teamId);
      allow create, update: if isTeamMember(teamId);
      allow delete: if isTeamAdmin(teamId) || isTeamOwner(teamId);
    }

    // Player of the match nominations (docs/nominations-spec.md §5).
    // One vote per member per session: doc id = voter uid, so a new vote overwrites the old one.
    // Voting closes when an Admin sets nominationsMeta/status.closed, or 24 hours after the
    // session's endTime, whichever comes first. Keep in sync with INominationService.
    function sessionDocPath(teamId, sessionId) {
      return /databases/$(database)/documents/teams/$(teamId)/sessions/$(sessionId);
    }

    function nominationsStatusPath(teamId, sessionId) {
      return /databases/$(database)/documents/teams/$(teamId)/sessions/$(sessionId)/nominationsMeta/status;
    }

    function sessionEnded(teamId, sessionId) {
      return exists(sessionDocPath(teamId, sessionId))
        && 'endTime' in get(sessionDocPath(teamId, sessionId)).data
        && get(sessionDocPath(teamId, sessionId)).data.endTime is timestamp;
    }

    function nominationsOpen(teamId, sessionId) {
      return sessionEnded(teamId, sessionId)
        && request.time <= get(sessionDocPath(teamId, sessionId)).data.endTime + duration.value(24, 'h')
        && (
          !exists(nominationsStatusPath(teamId, sessionId))
          || get(nominationsStatusPath(teamId, sessionId)).data.get('closed', false) != true
        );
    }

    function nominationPayloadOk(nominatorId) {
      let d = request.resource.data;
      return d.keys().hasAll(['nominatorId', 'nomineeSlotId', 'nomineeName', 'timestamp'])
        && d.keys().hasOnly(['nominatorId', 'nominatorDisplayName', 'nomineeSlotId', 'nomineeName', 'timestamp'])
        && d.nominatorId == request.auth.uid
        && d.nominatorId == nominatorId
        && d.nomineeSlotId is int
        && d.nomineeSlotId >= 1
        && d.nomineeName is string
        && d.nomineeName.size() > 0
        && d.nomineeName.size() <= 80
        && d.timestamp is timestamp
        && (!('nominatorDisplayName' in d)
            || (d.nominatorDisplayName is string && d.nominatorDisplayName.size() <= 80));
    }

    match /teams/{teamId}/sessions/{sessionId}/nominations/{nominatorId} {
      // The live tally is Admin-only while voting is open (it could sway voters):
      // a member may read only their own vote until voting closes; Admins (and the
      // team owner, for the delete cascade) can read all; everyone can read all after close.
      allow read: if canReadTeam(teamId) && (
          nominatorId == request.auth.uid
          || isTeamAdmin(teamId)
          || isTeamOwner(teamId)
          || !nominationsOpen(teamId, sessionId)
        );

      allow create: if isTeamMember(teamId)
        && nominatorId == request.auth.uid
        && nominationPayloadOk(nominatorId)
        && nominationsOpen(teamId, sessionId);

      allow update: if isTeamMember(teamId)
        && nominatorId == request.auth.uid
        && resource.data.nominatorId == request.auth.uid
        && nominationPayloadOk(nominatorId)
        && nominationsOpen(teamId, sessionId);

      // Members may withdraw while open; Admins may remove a vote at any time;
      // the team owner may delete during the DeleteTeamAsOwner cascade.
      allow delete: if (
          isTeamMember(teamId)
          && resource.data.nominatorId == request.auth.uid
          && nominationsOpen(teamId, sessionId)
        )
        || isTeamAdmin(teamId)
        || isTeamOwner(teamId);
    }

    // Admin-only close flag for a session's nominations.
    match /teams/{teamId}/sessions/{sessionId}/nominationsMeta/{docId} {
      allow read: if docId == 'status' && canReadTeam(teamId);
      allow create, update: if docId == 'status'
        && isTeamAdmin(teamId)
        && request.resource.data.closed is bool;
      allow delete: if docId == 'status' && (isTeamAdmin(teamId) || isTeamOwner(teamId));
    }

    // Game logs
    match /teams/{teamId}/logs/{logId} {
      allow read, write: if canReadTeam(teamId);
    }

    // MCP server (mcp-server/) state: OAuth clients, auth codes, refresh grants, link codes.
    // Server-only: written and read with the Admin SDK, never by clients.
    match /mcp_clients/{id} { allow read, write: if false; }
    match /mcp_auth_codes/{id} { allow read, write: if false; }
    match /mcp_auth_requests/{id} { allow read, write: if false; }
    match /mcp_grants/{id} { allow read, write: if false; }
    match /mcp_link_codes/{id} { allow read, write: if false; }

    // Legacy paths
    match /rosters/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /logs/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
    }
  }
}
