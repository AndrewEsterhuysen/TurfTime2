<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TurfTime2.GamePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TurfTime2.Models"
             xmlns:conv="clr-namespace:TurfTime2.Converters"
             xmlns:local="clr-namespace:TurfTime2"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <ContentPage.Resources>
        <Color x:Key="FieldColor">#388e3c</Color>
        <Color x:Key="BenchColor">#1565c0</Color>
        <Color x:Key="GoalieColor">#f57f17</Color>
        <Color x:Key="InactiveColor">#424242</Color>
        <Color x:Key="AccentColor">#FF6B35</Color>
        <Color x:Key="CardBg">#2e7d32</Color>
        <Color x:Key="CyanHighlight">#00d9ff</Color>

        <conv:BoolToFontAttrsConverter    x:Key="BoolToFontAttrs" />
        <conv:PositionToColorConverter       x:Key="PositionToColor" />
        <conv:NextToBorderColorConverter     x:Key="NextToBorderColor" />
        <conv:RotationPairOutlineConverter   x:Key="RotationPairOutline" />
        <conv:NextToBorderThicknessConverter x:Key="NextToBorderThickness" />
        <conv:NextToArrowConverter        x:Key="NextToArrow" />
        <conv:BoolToOpacityConverter      x:Key="BoolToOpacity" />

        <!-- ── Player row template for VIEW_A ── -->
        <DataTemplate x:Key="PlayerRowTemplate" x:DataType="models:Player">
            <!--
                DragRow root: calls RequestDisallowInterceptTouchEvent(true) at
                ACTION_DOWN on Android, preventing the CollectionView/RecyclerView
                from intercepting vertical gestures before PanGestureRecognizer fires.
                ONE PanGestureRecognizer on the outer Grid handles both intents.
                After ~12 dp the handler commits to swipe (horizontal) or drag
                (vertical) so the two actions never conflict.
                The ☰ label is a visual cue only — no child gesture recognizer.
            -->
            <local:DragRow Spacing="0">
                <!-- Gold insertion-point indicator — always 3dp tall; opacity avoids layout reflow -->
                <BoxView HeightRequest="3"
                         Color="#FFD700"
                         HorizontalOptions="Fill"
                         Opacity="{Binding IsDragTarget, Converter={StaticResource BoolToOpacity}}" />

                <Grid ColumnDefinitions="0.15*,0.7*,0.15*">
                    <Grid.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnPlayerPanUpdated" />
                        <TapGestureRecognizer Tapped="OnPlayerNameTapped" />
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="1"
                            Stroke="{Binding RotationPairIndex, Converter={StaticResource RotationPairOutline}}"
                            StrokeThickness="{Binding IsNextToRotate, Converter={StaticResource NextToBorderThickness}}"
                            StrokeShape="RoundRectangle 0"
                            BackgroundColor="{Binding Position, Converter={StaticResource PositionToColor}}"
                            Margin="0,1,0,0"
                            InputTransparent="True">
                        <Border.Triggers>
                            <!-- Dim the row while it is being dragged so it stands out as the grabbed item -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsDragging}" Value="{x:Boolean True}">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <!-- Yellow outline when armed for select-and-drop (same as Field View). -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsFieldTapSelected}" Value="{x:Boolean True}">
                                <Setter Property="Stroke" Value="#FFEB3B" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                              Padding="4,9">
                            <!-- Drag handle (visual only — gesture is on the outer Grid) -->
                            <Border Grid.Column="0"
                                    Stroke="#66FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="#22000000"
                                    Padding="4,0"
                                    Margin="0,0,6,0"
                                    VerticalOptions="Center">
                                <Label Text="☰"
                                       TextColor="#88ffffff"
                                       FontSize="18"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDragging}" Value="{x:Boolean True}">
                                            <Setter Property="TextColor" Value="#FF6B35" />
                                            <Setter Property="FontSize" Value="22" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <!-- Position icon: ⚽ 💺 🥅 ❌ -->
                            <Label Grid.Column="1"
                                   Text="{Binding PositionIcon}"
                                   FontSize="20"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0" />
                            <!-- Next-to-rotate arrow -->
                            <Label Grid.Column="2"
                                   Text="➤"
                                   TextColor="{StaticResource CyanHighlight}"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsNextToRotate}"
                                   Margin="0,0,6,0" />
                            <!-- Player name (tap to rename — gesture is on the outer Grid) -->
                             <Label Grid.Column="3"
                                    Text="{Binding Name}"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="{Binding IsNextToRotate, Converter={StaticResource BoolToFontAttrs}}"
                                    VerticalOptions="Center"
                                    InputTransparent="True" />
                            <!-- Field time -->
                            <Label Grid.Column="4"
                                   Text="{Binding FieldTimeDisplay}"
                                   TextColor="#ccffcc"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </Grid>
            </local:DragRow>
        </DataTemplate>

        <!-- iOS: swipe on the row body for position changes; pan only on ☰ handle for drag.
             Avoids a full-row PanGestureRecognizer, which blocks UICollectionView scrolling. -->
        <DataTemplate x:Key="PlayerRowTemplateIos" x:DataType="models:Player">
            <local:DragRow Spacing="0">
                <BoxView HeightRequest="3"
                         Color="#FFD700"
                         HorizontalOptions="Fill"
                         Opacity="{Binding IsDragTarget, Converter={StaticResource BoolToOpacity}}" />

                <Grid ColumnDefinitions="0.15*,0.7*,0.15*">
                    <Grid.GestureRecognizers>
                        <SwipeGestureRecognizer Direction="Left"  Swiped="OnPlayerSwiped" />
                        <SwipeGestureRecognizer Direction="Right" Swiped="OnPlayerSwiped" />
                        <TapGestureRecognizer Tapped="OnPlayerNameTapped" />
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="0"
                            Stroke="#66FFFFFF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="#22000000"
                            Padding="4,0"
                            Margin="0,1,0,0"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnPlayerPanUpdated" />
                        </Border.GestureRecognizers>
                        <Label Text="☰"
                               TextColor="#88ffffff"
                               FontSize="18"
                               VerticalOptions="Center"
                               HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDragging}" Value="{x:Boolean True}">
                                    <Setter Property="TextColor" Value="#FF6B35" />
                                    <Setter Property="FontSize" Value="22" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Grid.Column="1"
                            Stroke="{Binding RotationPairIndex, Converter={StaticResource RotationPairOutline}}"
                            StrokeThickness="{Binding IsNextToRotate, Converter={StaticResource NextToBorderThickness}}"
                            StrokeShape="RoundRectangle 0"
                            BackgroundColor="{Binding Position, Converter={StaticResource PositionToColor}}"
                            Margin="0,1,0,0"
                            InputTransparent="True">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDragging}" Value="{x:Boolean True}">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFieldTapSelected}" Value="{x:Boolean True}">
                                <Setter Property="Stroke" Value="#FFEB3B" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                              Padding="4,9">
                            <Label Grid.Column="0"
                                   Text="{Binding PositionIcon}"
                                   FontSize="20"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0" />
                            <Label Grid.Column="1"
                                   Text="➤"
                                   TextColor="{StaticResource CyanHighlight}"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsNextToRotate}"
                                   Margin="0,0,6,0" />
                             <Label Grid.Column="2"
                                    Text="{Binding Name}"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="{Binding IsNextToRotate, Converter={StaticResource BoolToFontAttrs}}"
                                    VerticalOptions="Center"
                                    InputTransparent="True" />
                            <Label Grid.Column="3"
                                   Text="{Binding FieldTimeDisplay}"
                                   TextColor="#ccffcc"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </Grid>
            </local:DragRow>
        </DataTemplate>

        <!-- ── Inactive / absent group header template ── -->
        <DataTemplate x:Key="InactiveHeaderTemplate" x:DataType="models:InactiveGroupHeader">
            <Grid ColumnDefinitions="0.15*,0.7*,0.15*">
                <Border Grid.Column="1"
                        BackgroundColor="#424242"
                        StrokeShape="RoundRectangle 0"
                        Stroke="#666"
                        StrokeThickness="1"
                        Margin="0,4,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInactiveHeaderTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Label}"
                           TextColor="#cccccc"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="10,10" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template selector -->
        <local:RosterItemTemplateSelector x:Key="RosterSelector"
            PlayerTemplate="{StaticResource PlayerRowTemplate}"
            InactiveHeaderTemplate="{StaticResource InactiveHeaderTemplate}" />

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">

        <!-- ══ HEADER ══ -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto,Auto"
              BackgroundColor="#0a0a0a"
              Padding="8,6,8,6">

            <!-- Row 0: ⚽  Turf Timer  🥅 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0"
                       Text="⚽"
                       FontSize="22"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Label Grid.Column="1"
                       Text="Turf Timer"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="🥅"
                       FontSize="22"
                       VerticalOptions="Center"
                       HorizontalOptions="End" />
            </Grid>

            <!-- Row 1: Team name -->
            <Label Grid.Row="1"
                   Text="{Binding TeamName}"
                   TextColor="#ffe082"
                   FontSize="13"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   LineBreakMode="TailTruncation"
                   Margin="0,2,0,0" />

            <!-- Row 2: Column header labels -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*,*,*"
                  Margin="0,6,0,1">
                <Label Grid.Column="0"
                       Text="Us"
                       TextColor="#ccffcc"
                       FontSize="11"
                       HorizontalOptions="Center"
                       IsVisible="{Binding ScoresVisible}" />
                <Label Grid.Column="1"
                       Text="{Binding MatchTimeLabelText}"
                       TextColor="#99cc99"
                       FontSize="11"
                       HorizontalOptions="Center" />
                <Label Grid.Column="2"
                       Text="Rotate"
                       TextColor="#99cc99"
                       FontSize="11"
                       HorizontalOptions="Center" />
                <Label Grid.Column="3"
                       Text="Them"
                       TextColor="#ccffcc"
                       FontSize="11"
                       HorizontalOptions="Center"
                       IsVisible="{Binding ScoresVisible}" />
            </Grid>

            <!-- Row 3: Values — scores, match timer, rotation timer -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="*,*,*,*"
                  Margin="0,0,0,2">
                <!-- Us score — full cell is the tap target (controller only) -->
                <Grid Grid.Column="0"
                      IsVisible="{Binding ScoresVisible}"
                      InputTransparent="{Binding IsMember}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTeamAScoreTapped" />
                    </Grid.GestureRecognizers>
                    <Label Text="{Binding TeamAScore}"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Grid>
                <!-- Match timer: bright white high-contrast (Style null so app Label theme cannot dull it on Android) -->
                <Label Grid.Column="1"
                       x:Name="MatchTimerLabel"
                       Text="{Binding MatchTimeDisplay}"
                       Style="{x:Null}"
                       TextColor="#FFFFFF"
                       FontSize="26"
                       FontAttributes="Bold"
                       FontFamily="OpenSansSemibold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       Opacity="1">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMatchTimerTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <!-- Rotation countdown: same bright white, slightly smaller than match timer -->
                <Label Grid.Column="2"
                       x:Name="CountdownLabel"
                       Text="{Binding CountdownDisplay}"
                       Style="{x:Null}"
                       TextColor="#FFFFFF"
                       FontSize="22"
                       FontAttributes="Bold"
                       FontFamily="OpenSansSemibold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       Opacity="1">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCountdownTimerTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <!-- Them score — full cell is the tap target (controller only) -->
                <Grid Grid.Column="3"
                      IsVisible="{Binding ScoresVisible}"
                      InputTransparent="{Binding IsMember}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTeamBScoreTapped" />
                    </Grid.GestureRecognizers>
                    <Label Text="{Binding TeamBScore}"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Grid>
            </Grid>

        </Grid>

        <!-- ══ View-only / controller lock banner + optional voluntary Watch Only ══ -->
        <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="4,2,4,2">
            <Border BackgroundColor="#ffc107"
                    Padding="8,4"
                    StrokeShape="RoundRectangle 4"
                    IsVisible="{Binding IsMember}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnViewOnlyBannerTapped" />
                </Border.GestureRecognizers>
                <Label Text="{Binding ViewOnlyBannerText}"
                       TextColor="Black"
                       FontAttributes="Bold"
                       FontSize="12"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </Border>
            <!-- Setup only: voluntary Watch Only when no match controller is active -->
            <Button x:Name="SessionViewOnlyBtn"
                    Text="{Binding SessionViewOnlyToggleText}"
                    IsVisible="{Binding CanUseSessionViewOnly}"
                    BackgroundColor="#37474F"
                    TextColor="White"
                    FontSize="13"
                    FontAttributes="Bold"
                    HeightRequest="36"
                    Padding="8,0"
                    Clicked="OnSessionViewOnlyToggleClicked" />
            <Label Text="{Binding RotationBasisHintText}"
                   IsVisible="{Binding ShowRotationBasisHint}"
                   TextColor="#FFE082"
                   FontSize="11"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- ══ CONTENT AREA ══ -->
        <Grid Grid.Row="2">

            <!-- VIEW_A: Swipeable list -->
            <CollectionView x:Name="SwipeableRoster"
                            ItemsSource="{Binding DisplayItems}"
                            ItemTemplate="{StaticResource RosterSelector}"
                            ItemsLayout="VerticalList"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No players – tap Setup to add players"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- VIEW_C: Rotation display with score buttons.
                 Row 0 = title only (Auto); Row 1 = tap-to-rotate list (* fills remaining height). -->
            <Grid x:Name="RotationView"
                  IsVisible="False"
                  RowDefinitions="Auto,*"
                  ColumnDefinitions="80,*,80"
                  Padding="0,4,0,0">

                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                      x:Name="TeamAScoreBtn"
                      BackgroundColor="{StaticResource FieldColor}"
                      IsVisible="{Binding ScoresVisible}"
                      InputTransparent="{Binding IsMember}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTeamAScoreTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                        <Label Text=" Us "
                               TextColor="White"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Rotation="-90" />
                        <Label Text="{Binding TeamAScore}"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <Label Grid.Row="0" Grid.Column="1"
                       Text="Next Rotation"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="22"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       HorizontalTextAlignment="Center"
                       Margin="8,4,8,6" />

                <!-- Tap-to-rotate zone: short press rotates; hold ~1s opens rotation-count selector.
                     Transparent Button captures Pressed/Released/Clicked (reliable on touch devices). -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="#2a2a2a"
                        Stroke="#555555"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,6"
                        Margin="4,0,4,4"
                        VerticalOptions="Fill">
                    <Grid>
                        <Button BackgroundColor="Transparent"
                                BorderWidth="0"
                                Padding="0"
                                Margin="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                Clicked="OnTapToRotateClicked"
                                Pressed="OnTapToRotatePressed"
                                Released="OnTapToRotateReleased" />
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="2"
                              InputTransparent="True">
                            <Label Grid.Row="0"
                                   Text="Tap to Rotate · hold to set count"
                                   TextColor="#b0b0b0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <CollectionView Grid.Row="1"
                                            x:Name="RotationPairsView"
                                            ItemsSource="{Binding RotationPairs}"
                                            SelectionMode="None"
                                            VerticalOptions="Fill"
                                            InputTransparent="True">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical"
                                                       ItemSpacing="2" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:RotationPair">
                                        <VerticalStackLayout Spacing="0" Margin="4,2,4,4">
                                            <!-- Bench player coming ON — left aligned -->
                                            <Label TextColor="#bbdefb"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Start"
                                                   LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="&#x1FA91; " />
                                                        <Span Text="{Binding BenchPlayerName}" />
                                                        <Span Text="  on" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <!-- Field player coming OFF — right aligned -->
                                            <Label TextColor="#ffccbc"
                                                   FontSize="20"
                                                   HorizontalOptions="End"
                                                   LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="off  " />
                                                        <Span Text="&#x26BD; " />
                                                        <Span Text="{Binding FieldPlayerName}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="Assign field and bench players first"
                                           TextColor="#aaa"
                                           HorizontalOptions="Center" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                      x:Name="TeamBScoreBtn"
                      BackgroundColor="#c62828"
                      IsVisible="{Binding ScoresVisible}"
                      InputTransparent="{Binding IsMember}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTeamBScoreTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                        <Label Text="   Them "
                               TextColor="White"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Rotation="-90" />
                        <Label Text="{Binding TeamBScore}"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- VIEW_B: Field View — pitch fills space; goalie over goal; Bench on right sideline;
                 Absent strip behind goalie (Setup only). View-only members always see this mode. -->
            <Grid x:Name="FieldView"
                  IsVisible="False"
                  IsClippedToBounds="True"
                  BackgroundColor="#000000"
                  SizeChanged="OnFieldViewSizeChanged">
                <Grid.Resources>
                    <!-- Shared Field View player token (field / goalie / bench) -->
                    <DataTemplate x:Key="FieldViewTokenTemplate" x:DataType="models:Player">
                        <Border WidthRequest="48"
                                HeightRequest="48"
                                Margin="5"
                                Stroke="{Binding RotationPairIndex, Converter={StaticResource RotationPairOutline}}"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="{Binding Position, Converter={StaticResource PositionToColor}}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <DragGestureRecognizer DragStarting="OnFieldPlayerDragStarting" />
                                <DropGestureRecognizer AllowDrop="True"
                                                       DragOver="OnFieldViewTokenDragOver"
                                                       Drop="OnFieldViewTokenDrop" />
                                <TapGestureRecognizer NumberOfTapsRequired="1"
                                                       Tapped="OnFieldViewPlayerTapped" />
                                <TapGestureRecognizer NumberOfTapsRequired="2"
                                                       Tapped="OnFieldViewPlayerDoubleTapped" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsNextToRotate}"
                                             Value="{x:Boolean True}">
                                    <Setter Property="StrokeThickness" Value="3.5" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsNextToRotate}"
                                             Value="{x:Boolean False}">
                                    <Setter Property="Stroke" Value="#66FFFFFF" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsFieldTapSelected}"
                                             Value="{x:Boolean True}">
                                    <Setter Property="Stroke" Value="#FFEB3B" />
                                    <Setter Property="StrokeThickness" Value="3.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="0"
                                                 Padding="0,2,0,2"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 InputTransparent="True">
                                <Label Text="{Binding ShortName}"
                                       TextColor="White"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="NoWrap"
                                       InputTransparent="True" />
                                <Label Text="{Binding FieldTimeDisplay}"
                                       TextColor="#D9FFFFFF"
                                       FontSize="8"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="NoWrap"
                                       InputTransparent="True">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Position}"
                                                     Value="{x:Static models:PlayerPosition.Inactive}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>

                <!-- Sized/translated in code for true bottom-aligned AspectFill (MAUI End alone left a green gap). -->
                <Image x:Name="FieldViewBackground"
                       Source="field_view_bg.png"
                       Aspect="Fill"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"
                       InputTransparent="True" />
                <!-- Pitch stretches; Absent strip behind the goalie (Setup); Bench on right sideline -->
                <Grid x:Name="FieldViewOverlay"
                      RowDefinitions="*,Auto,Auto"
                      Padding="8,8,8,2"
                      RowSpacing="0">
                    <!-- Pitch: outfield grid sits just above the goal; Bench on trailing edge -->
                    <Grid Grid.Row="0"
                          RowDefinitions="*,Auto"
                          ColumnDefinitions="56,*,56"
                          RowSpacing="2">
                        <!-- Outfield 4×4 — fixed-height host End-aligned so grid bottom meets top of goal -->
                        <Grid Grid.Row="0"
                              Grid.Column="1"
                              VerticalOptions="End"
                              HorizontalOptions="Fill"
                              HeightRequest="236"
                              Margin="0,0,0,-18">
                            <CollectionView ItemsSource="{Binding FieldGridCells}"
                                            SelectionMode="None"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Fill"
                                            HorizontalOptions="Fill">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical"
                                                     Span="4"
                                                     HorizontalItemSpacing="2"
                                                     VerticalItemSpacing="2" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FieldCellSlot">
                                        <Border Stroke="#55FFFFFF"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#22000000"
                                                Margin="1"
                                                MinimumHeightRequest="52"
                                                MinimumWidthRequest="52">
                                            <Border.GestureRecognizers>
                                                <DropGestureRecognizer AllowDrop="True"
                                                                       DragOver="OnFieldCellDragOver"
                                                                       Drop="OnFieldCellDrop" />
                                                <TapGestureRecognizer Tapped="OnFieldCellTapped" />
                                            </Border.GestureRecognizers>
                                            <Grid>
                                                <Label Text="{Binding CellLabel}"
                                                       TextColor="#66FFFFFF"
                                                       FontSize="10"
                                                       Margin="4,2,0,0"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="Start"
                                                       InputTransparent="True" />
                                                <Border IsVisible="{Binding HasPlayer}"
                                                        WidthRequest="48"
                                                        HeightRequest="48"
                                                        Stroke="{Binding Player.RotationPairIndex, Converter={StaticResource RotationPairOutline}}"
                                                        StrokeThickness="1.5"
                                                        StrokeShape="RoundRectangle 24"
                                                        BackgroundColor="{Binding Player.Position, Converter={StaticResource PositionToColor}}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <DragGestureRecognizer DragStarting="OnFieldPlayerDragStarting" />
                                                        <TapGestureRecognizer NumberOfTapsRequired="1"
                                                                               Tapped="OnFieldViewPlayerTapped" />
                                                        <TapGestureRecognizer NumberOfTapsRequired="2"
                                                                               Tapped="OnFieldViewPlayerDoubleTapped" />
                                                    </Border.GestureRecognizers>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding Player.IsNextToRotate}"
                                                                     Value="{x:Boolean True}">
                                                            <Setter Property="StrokeThickness" Value="3.5" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding Player.IsNextToRotate}"
                                                                     Value="{x:Boolean False}">
                                                            <Setter Property="Stroke" Value="#66FFFFFF" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding Player.IsFieldTapSelected}"
                                                                     Value="{x:Boolean True}">
                                                            <Setter Property="Stroke" Value="#FFEB3B" />
                                                            <Setter Property="StrokeThickness" Value="3.5" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <VerticalStackLayout Spacing="0"
                                                                         Padding="0,2,0,2"
                                                                         HorizontalOptions="Center"
                                                                         VerticalOptions="Center"
                                                                         InputTransparent="True">
                                                        <Label Text="{Binding Player.ShortName}"
                                                               TextColor="White"
                                                               FontSize="10"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center"
                                                               HorizontalTextAlignment="Center"
                                                               LineBreakMode="NoWrap"
                                                               InputTransparent="True" />
                                                        <Label Text="{Binding Player.FieldTimeDisplay}"
                                                               TextColor="#D9FFFFFF"
                                                               FontSize="8"
                                                               HorizontalOptions="Center"
                                                               HorizontalTextAlignment="Center"
                                                               LineBreakMode="NoWrap"
                                                               InputTransparent="True" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>

                        <!-- Right gutter: vertical Bench alongside the pitch (sideline) -->
                        <Border x:Name="BenchDropBand"
                                Grid.Row="0"
                                Grid.Column="2"
                                WidthRequest="56"
                                MinimumHeightRequest="64"
                                MaximumWidthRequest="56"
                                Padding="2,4"
                                Margin="2,0,0,-18"
                                Stroke="#66FFFFFF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#22000000"
                                HorizontalOptions="Center"
                                VerticalOptions="Fill">
                            <Border.GestureRecognizers>
                                <DropGestureRecognizer AllowDrop="True"
                                                       DragOver="OnBenchBandDragOver"
                                                       DragLeave="OnBenchBandDragLeave"
                                                       Drop="OnBenchBandDrop" />
                                <TapGestureRecognizer Tapped="OnBenchBandTapped" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,*"
                                  RowSpacing="2"
                                  BackgroundColor="Transparent"
                                  HorizontalOptions="Center">
                                <Label Grid.Row="0"
                                       Text="Bench"
                                       TextColor="#CCFFFFFF"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       BackgroundColor="Transparent"
                                       InputTransparent="True" />
                                <!-- Transparent hit target under ScrollView (BoxView alpha often paints opaque black on Android).
                                     When a source token is armed, ScrollView is InputTransparent so taps reach this layer. -->
                                <!-- Near-invisible fill so Android hit-tests empty Bench area (fully Transparent often ignores touches). -->
                                <Grid Grid.Row="1"
                                      x:Name="BenchHitLayer"
                                      BackgroundColor="#01FFFFFF"
                                      VerticalOptions="Fill"
                                      HorizontalOptions="Fill">
                                    <Grid.GestureRecognizers>
                                        <DropGestureRecognizer AllowDrop="True"
                                                               DragOver="OnBenchBandDragOver"
                                                               DragLeave="OnBenchBandDragLeave"
                                                               Drop="OnBenchBandDrop" />
                                        <TapGestureRecognizer Tapped="OnBenchBandTapped" />
                                    </Grid.GestureRecognizers>
                                    <!-- Pass-through only for Absent→Bench empty-area taps.
                                         Field/Goalie armed: keep interactive so token taps do a direct sub.
                                         Drop handlers required on ScrollView — otherwise Android drops die on the list. -->
                                    <ScrollView x:Name="BenchTokenScroll"
                                                Orientation="Vertical"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Fill"
                                                VerticalScrollBarVisibility="Never"
                                                HorizontalOptions="Center"
                                                InputTransparent="{Binding PassThroughBenchScrollForAbsentArm}">
                                        <ScrollView.GestureRecognizers>
                                            <DropGestureRecognizer AllowDrop="True"
                                                                   DragOver="OnBenchBandDragOver"
                                                                   DragLeave="OnBenchBandDragLeave"
                                                                   Drop="OnBenchBandDrop" />
                                        </ScrollView.GestureRecognizers>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding BenchBandPlayers}"
                                                             BindableLayout.ItemTemplate="{StaticResource FieldViewTokenTemplate}"
                                                             Spacing="2"
                                                             BackgroundColor="Transparent"
                                                             HorizontalOptions="Center" />
                                    </ScrollView>
                                    <Label x:Name="BenchDropHint"
                                           Text="+"
                                           TextColor="#EEFFFFFF"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           BackgroundColor="Transparent"
                                           InputTransparent="True"
                                           IsVisible="False" />
                                    <Label Text="🪑"
                                           TextColor="#66FFFFFF"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           BackgroundColor="Transparent"
                                           InputTransparent="True"
                                           IsVisible="{Binding IsBenchBandEmpty}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Goalie drop zone over the painted goal; ~½ tile lower than prior (bottom margin 72→46) -->
                        <Border x:Name="GoalieDropBand"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                HeightRequest="48"
                                Margin="64,0,64,46"
                                Padding="0"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Fill"
                                VerticalOptions="End">
                            <Border.GestureRecognizers>
                                <DropGestureRecognizer AllowDrop="True"
                                                       DragOver="OnGoalieBandDragOver"
                                                       DragLeave="OnGoalieBandDragLeave"
                                                       Drop="OnGoalieBandDrop" />
                                <TapGestureRecognizer Tapped="OnGoalieBandTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label x:Name="GoalieDropHint"
                                       Text="+"
                                       TextColor="#EEFFFFFF"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True"
                                       IsVisible="False" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding GoalieBandPlayers}"
                                            BindableLayout.ItemTemplate="{StaticResource FieldViewTokenTemplate}"
                                            Wrap="NoWrap"
                                            JustifyContent="Center"
                                            AlignItems="Center"
                                            Direction="Row"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            InputTransparent="False" />
                            </Grid>
                        </Border>

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="No players on field"
                               TextColor="#ccffcc"
                               FontSize="13"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0,0,0,80"
                               InputTransparent="True"
                               IsVisible="{Binding IsOutfieldBandEmpty}" />
                    </Grid>

                    <!-- Absent behind the goalie (Setup only). Grid receives Android drag/drop + taps;
                         Border is visual-only (DropGestureRecognizer on Border unreliable under ScrollView). -->
                    <Grid x:Name="FieldViewAbsentStrip"
                          Grid.Row="2"
                          Margin="8,4,8,6"
                          MinimumHeightRequest="72"
                          BackgroundColor="Transparent"
                          HorizontalOptions="Fill"
                          IsVisible="{Binding ShowFieldViewAbsentZone}">
                        <Grid.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="True"
                                                   DragOver="OnInactiveBandDragOver"
                                                   DragLeave="OnInactiveBandDragLeave"
                                                   Drop="OnInactiveBandDrop" />
                            <TapGestureRecognizer Tapped="OnInactiveBandTapped" />
                        </Grid.GestureRecognizers>

                        <Border Stroke="#66FFFFFF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#22000000"
                                InputTransparent="True"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />

                        <VerticalStackLayout Padding="6,4"
                                             Spacing="2"
                                             HorizontalOptions="Fill"
                                             VerticalOptions="Fill"
                                             BackgroundColor="Transparent">
                            <Label Text="Absent"
                                   TextColor="#CCFFFFFF"
                                   FontSize="8"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   BackgroundColor="Transparent"
                                   InputTransparent="True" />
                            <!-- Near-invisible fill so Android hit-tests empty Absent area when ScrollView is pass-through. -->
                            <Grid x:Name="InactiveHitLayer"
                                  MinimumHeightRequest="56"
                                  HeightRequest="56"
                                  BackgroundColor="#01FFFFFF"
                                  HorizontalOptions="Fill">
                                <Grid.GestureRecognizers>
                                    <DropGestureRecognizer AllowDrop="True"
                                                           DragOver="OnInactiveBandDragOver"
                                                           DragLeave="OnInactiveBandDragLeave"
                                                           Drop="OnInactiveBandDrop" />
                                    <TapGestureRecognizer Tapped="OnInactiveBandTapped" />
                                </Grid.GestureRecognizers>

                                <!-- Pass-through when anyone is armed so Bench→Absent / empty-area taps reach the hit layer. -->
                                <ScrollView x:Name="InactiveTokenScroll"
                                            Orientation="Horizontal"
                                            BackgroundColor="Transparent"
                                            HorizontalScrollBarVisibility="Never"
                                            VerticalScrollBarVisibility="Never"
                                            VerticalOptions="Fill"
                                            HorizontalOptions="Fill"
                                            InputTransparent="{Binding HasFieldTapPlaceSelection}">
                                    <ScrollView.GestureRecognizers>
                                        <DropGestureRecognizer AllowDrop="True"
                                                               DragOver="OnInactiveBandDragOver"
                                                               DragLeave="OnInactiveBandDragLeave"
                                                               Drop="OnInactiveBandDrop" />
                                        <TapGestureRecognizer Tapped="OnInactiveBandTapped" />
                                    </ScrollView.GestureRecognizers>
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding InactiveBandPlayers}"
                                                           BindableLayout.ItemTemplate="{StaticResource FieldViewTokenTemplate}"
                                                           Spacing="2"
                                                           Padding="4,0"
                                                           BackgroundColor="Transparent"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Center"
                                                           MinimumHeightRequest="56" />
                                </ScrollView>

                                <Label x:Name="InactiveDropHint"
                                       Text="+"
                                       TextColor="#EEFFFFFF"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       BackgroundColor="Transparent"
                                       InputTransparent="True"
                                       IsVisible="False" />
                                <Label Text="✗"
                                       TextColor="#66FFFFFF"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       BackgroundColor="Transparent"
                                       InputTransparent="True"
                                       IsVisible="{Binding IsInactiveBandEmpty}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>

        <!-- ══ BOTTOM CONTROLS (admin only — view-only members hide these) ══ -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,*,*"
              Padding="4,6,4,6"
              ColumnSpacing="6"
              BackgroundColor="Black"
              IsVisible="{Binding IsAdmin}">

            <Button Grid.Column="0"
                    x:Name="StartBtn"
                    Text="{Binding StartButtonText}"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    IsEnabled="{Binding CanStart}"
                    Clicked="OnStartClicked"
                    Pressed="OnStartPressed"
                    Released="OnStartReleased" />

            <Button Grid.Column="1"
                    x:Name="RotateBtn"
                    Text="{Binding RotateButtonText}"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    Clicked="OnRotateClicked"
                    Pressed="OnRotatePressed"
                    Released="OnRotateReleased" />

            <Button Grid.Column="2"
                    x:Name="ViewBtn"
                    Text="View: Rotation"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontSize="13"
                    Margin="0"
                    Padding="0"
                    LineBreakMode="WordWrap"
                    HorizontalOptions="FillAndExpand"
                    Clicked="OnViewButtonClicked" />

        </Grid>

    </Grid>

</ContentPage>
