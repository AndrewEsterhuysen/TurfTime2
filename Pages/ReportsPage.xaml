<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.ReportsPage"
             Title="Match Reports">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Game Selection Picker -->
        <Border Style="{StaticResource PvCard}" Grid.Row="0" Margin="16,16,16,0">
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource PvCardTitle}" Text="Select Game" HorizontalOptions="Start"/>
                <Picker Style="{StaticResource PvPicker}" x:Name="GameSessionPicker" Title="Choose a completed game..." SelectedIndexChanged="OnGameSessionSelected"/>
            </VerticalStackLayout>
        </Border>

        <!-- Button Container -->
        <VerticalStackLayout Grid.Row="1" 
                           Padding="16,16,16,8" 
                           Spacing="8"
                           x:Name="ButtonContainer">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Style="{StaticResource PvButtonPrimary}" Grid.Column="0" x:Name="ViewReportButton" Text="View" Padding="8,12" Clicked="OnViewReportClicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialSymbols" Glyph="{StaticResource PvIconVisibility}" Size="18" Color="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}" />
                    </Button.ImageSource>
                </Button>
                <Button Style="{StaticResource PvButtonSecondary}" Grid.Column="1" x:Name="EmailHtmlButton" Text="HTML" Padding="8,12" Clicked="OnEmailHtmlClicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialSymbols" Glyph="{StaticResource PvIconMail}" Size="18" Color="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
                    </Button.ImageSource>
                </Button>
                <Button Style="{StaticResource PvButtonSecondary}" Grid.Column="2" x:Name="EmailReportButton" Text="Report" Padding="8,12" Clicked="OnEmailReportClicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialSymbols" Glyph="{StaticResource PvIconAttach}" Size="18" Color="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <Label Style="{StaticResource PvCaption}" x:Name="StatusLabel" Text="" HorizontalOptions="Center" IsVisible="False"/>
        </VerticalStackLayout>

        <!-- WebView for HTML Report Display -->
        <WebView Grid.Row="2" 
                 x:Name="ReportWebView"
                 BackgroundColor="White" />
    </Grid>
</ContentPage>
