<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.ChatPage"
             Title="Chat"
             HideSoftInputOnTapped="False">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <!-- RootGrid bottom padding is raised on iOS when the keyboard is open so InputBar stays visible. -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto, *, Auto, Auto, Auto">
        <!-- Pinned message (admin/coach) -->
        <Border x:Name="PinnedBar"
                Grid.Row="0"
                IsVisible="False"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PvWarningContainerLight}, Dark={StaticResource PvWarningContainerDark}}"
                Padding="16,8"
                Margin="0">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <HorizontalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvIcon}"
                               Text="{StaticResource PvIconPin}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource PvWarningTextLight}, Dark={StaticResource PvWarningDark}}" />
                        <Label Style="{StaticResource PvOverline}"
                               Text="PINNED"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource PvWarningTextLight}, Dark={StaticResource PvWarningDark}}" />
                    </HorizontalStackLayout>
                    <Label x:Name="PinnedTextLabel"
                           Style="{StaticResource PvCaption}"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"
                           TextColor="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
                </VerticalStackLayout>
                <Button x:Name="UnpinButton"
                        Grid.Column="1"
                        Style="{StaticResource PvButtonText}"
                        Text="Unpin"
                        FontSize="13"
                        MinimumHeightRequest="36"
                        TextColor="{AppThemeBinding Light={StaticResource PvWarningTextLight}, Dark={StaticResource PvWarningDark}}"
                        Clicked="OnUnpinClicked"
                        IsVisible="False" />
            </Grid>
        </Border>

        <!-- ui-refresh: fixed, low-contrast pitch background behind the list (see ChatPitchBackground.cs) -->
        <GraphicsView x:Name="ChatBackground"
                      Grid.Row="1"
                      InputTransparent="True" />

        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        SelectionMode="None"
                        BackgroundColor="Transparent"
                        Margin="8" />

        <!-- Reply quote strip above composer -->
        <Grid x:Name="ReplyBar"
              Grid.Row="2"
              IsVisible="False"
              ColumnDefinitions="4, *, Auto"
              Padding="16,8"
              BackgroundColor="{AppThemeBinding Light={StaticResource PvPrimaryContainerLight}, Dark={StaticResource PvPrimaryContainerDark}}">
            <BoxView Grid.Column="0" Color="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" WidthRequest="4" CornerRadius="2" />
            <VerticalStackLayout Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                <Label x:Name="ReplyBarName"
                       Style="{StaticResource PvOverline}"
                       TextColor="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
                <Label x:Name="ReplyBarText"
                       Style="{StaticResource PvCaption}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Style="{StaticResource PvIconButton}"
                    Text="{StaticResource PvIconClose}"
                    SemanticProperties.Description="Cancel reply"
                    Clicked="OnCancelReplyClicked" />
        </Grid>

        <!-- High-contrast input so iOS caret/text are always visible and tappable -->
        <Grid x:Name="InputBar"
              Grid.Row="3"
              ColumnDefinitions="*, Auto"
              Padding="16,8"
              BackgroundColor="{AppThemeBinding Light={StaticResource PvSurfaceLight}, Dark={StaticResource PvSurfaceDark}}">
            <Border Grid.Column="0"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}"
                    Padding="16,4"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Entry x:Name="MessageEntry"
                       Placeholder="Type a message..."
                       FontFamily="Inter"
                       FontSize="15"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}"
                       TextColor="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}"
                       BackgroundColor="Transparent"
                       MaxLength="500"
                       Keyboard="Chat"
                       IsTextPredictionEnabled="True"
                       ReturnType="Send"
                       VerticalOptions="Center"
                       MinimumHeightRequest="40"
                       Focused="OnMessageEntryFocused"
                       Unfocused="OnMessageEntryUnfocused"
                       Completed="OnSendClicked" />
            </Border>
            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Text="{StaticResource PvIconSend}"
                    FontFamily="MaterialSymbols"
                    FontSize="22"
                    SemanticProperties.Description="Send"
                    Clicked="OnSendClicked"
                    Margin="8,0,0,0"
                    Padding="0"
                    VerticalOptions="Center"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}" />
        </Grid>

        <!-- Team Chat Identifiers — all online teams; does not change Game/Details team -->
        <ScrollView x:Name="TeamChatStripScroll"
                    Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    IsVisible="False"
                    Padding="16,8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PvSurfaceLight}, Dark={StaticResource PvSurfaceDark}}">
            <HorizontalStackLayout x:Name="TeamChatStrip"
                                  Spacing="8" />
        </ScrollView>
    </Grid>
</ContentPage>
