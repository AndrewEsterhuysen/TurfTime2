<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TurfTime2"
             x:Class="TurfTime2.TeamDetailsPage"
             Title="Team">
    <ContentPage.Resources>
        <local:BoolToCheckConverter x:Key="BoolToCheckConverter"/>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- ========== 1. Team Admin Panel (current team tools) ========== -->
            <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#2C2C2C}"
                   Padding="14"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTeamAdminHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="Team Admin Panel"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalOptions="Center"/>
                        <Label x:Name="TeamAdminToggleIcon"
                               Grid.Column="1"
                               Text="▼"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                    </Grid>
                    <Label x:Name="TeamAdminHint"
                           Text="Tap to expand — current team tools"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#999, Dark=#888}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTeamAdminHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="TeamAdminContent"
                                         IsVisible="False"
                                         Spacing="10">
                        <Label x:Name="CurrentTeamLabel"
                               Text="No team selected"
                               FontSize="15"
                               FontAttributes="Bold"/>
                        <Label x:Name="TeamModeLabel"
                               Text="Mode: Not configured"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#999, Dark=#888}"/>

                        <StackLayout x:Name="DisplayNameSection"
                                     IsVisible="False"
                                     Spacing="6">
                            <Label Text="Your chat display name"
                                   FontAttributes="Bold"
                                   FontSize="13"/>
                            <Label Text="Teammates see this name in Chat and push notifications."
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                            <Entry x:Name="CurrentDisplayNameEntry"
                                   Placeholder="e.g. Alex or Coach Sam"
                                   MaxLength="40"/>
                            <Button x:Name="SaveDisplayNameButton"
                                    Text="Save Display Name"
                                    Clicked="OnSaveDisplayNameClicked"
                                    BackgroundColor="#9C27B0"
                                    TextColor="White"
                                    HeightRequest="44"
                                    FontSize="14"/>
                        </StackLayout>

                        <!-- Popular action: directly under display-name save (still visible for local teams). -->
                        <Button x:Name="ShareTeamButton"
                                Text="Share Team (QR)"
                                Clicked="OnShareTeamClicked"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                HeightRequest="44"
                                FontSize="14"/>

                        <!-- Admin-only tools (online teams). Visible when role is Admin / Owner. -->
                        <Frame x:Name="SharedAdminTools"
                               IsVisible="False"
                               BorderColor="{AppThemeBinding Light=#A5D6A7, Dark=#2E7D32}"
                               BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B3D1E}"
                               Padding="12"
                               CornerRadius="8">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Admin"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#2E7D32"/>
                                <Label Text="Invite codes, members, and match control — Admin only."
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                                <Frame BackgroundColor="{AppThemeBinding Light=#FFF3CD, Dark=#4A3C1E}"
                                       Padding="10"
                                       CornerRadius="5"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Invite Code" FontAttributes="Bold" FontSize="12"/>
                                        <Label x:Name="InviteCodeDisplay"
                                               Text="Loading..."
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               LineBreakMode="MiddleTruncation"/>
                                        <Label Text="Share this code with team members"
                                               FontSize="10"
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                                    </VerticalStackLayout>
                                </Frame>
                                <Button Text="Regenerate Invite Code"
                                        Clicked="OnRegenerateCodeClicked"
                                        BackgroundColor="#E65100"
                                        TextColor="White"
                                        HeightRequest="44"
                                        FontSize="14"/>
                                <Button Text="View Team Members"
                                        Clicked="OnViewMembersClicked"
                                        BackgroundColor="#9C27B0"
                                        TextColor="White"
                                        HeightRequest="44"
                                        FontSize="14"/>
                                <Button Text="Promote to Admin"
                                        Clicked="OnPromoteToAdminClicked"
                                        BackgroundColor="#2E7D32"
                                        TextColor="White"
                                        HeightRequest="44"
                                        FontSize="14"/>
                                <Button Text="Remove Member"
                                        Clicked="OnRemoveMemberClicked"
                                        BackgroundColor="#C62828"
                                        TextColor="White"
                                        HeightRequest="44"
                                        FontSize="14"/>
                                <Label Text="Removes someone from the cloud team. They must rejoin with the invite code. You cannot remove the Owner; only the Owner can remove other Admins."
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                                <Button x:Name="RelinquishControlButton"
                                        Text="Relinquish Match Control"
                                        Clicked="OnRelinquishControlClicked"
                                        BackgroundColor="#546E7A"
                                        TextColor="White"
                                        HeightRequest="44"
                                        FontSize="14"/>
                                <Label Text="Hand over live-match control so another Admin can run the game. If you go offline, the server auto-releases control after ~90s."
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                                <Button x:Name="TransferOwnershipButton"
                                        Text="Transfer Ownership"
                                        IsVisible="False"
                                        Clicked="OnTransferOwnershipClicked"
                                        BackgroundColor="#1565C0"
                                        TextColor="White"
                                        HeightRequest="44"
                                        FontSize="14"/>
                            </VerticalStackLayout>
                        </Frame>

                        <VerticalStackLayout Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="LeaveTeamButton"
                                    Text="Leave Team"
                                    IsVisible="False"
                                    Clicked="OnLeaveTeamButtonClicked"
                                    BackgroundColor="#F44336"
                                    TextColor="White"
                                    HeightRequest="44"
                                    FontSize="14"/>
                            <Button x:Name="DeleteLocalTeamButton"
                                    Text="Delete Team"
                                    IsVisible="False"
                                    Clicked="OnDeleteLocalTeamButtonClicked"
                                    BackgroundColor="#F44336"
                                    TextColor="White"
                                    HeightRequest="44"
                                    FontSize="14"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ========== 2. Select Team (switch between existing teams) ========== -->
            <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                   Padding="14"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangeTeamHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="Select Team"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalOptions="Center"/>
                        <Label x:Name="ChangeTeamToggleIcon"
                               Grid.Column="1"
                               Text="▼"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                    </Grid>
                    <Label x:Name="ChangeTeamHint"
                           Text="Tap to expand — switch between teams you already have"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#999, Dark=#888}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangeTeamHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="ChangeTeamContent"
                                         IsVisible="False"
                                         Spacing="12">
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox x:Name="SharedCheckbox"
                                      CheckedChanged="OnSharedCheckboxChanged"/>
                            <Label Text="Online (cloud with teammates)"
                                   FontSize="14"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSelectOnlineLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox x:Name="LocalCheckbox"
                                      CheckedChanged="OnLocalCheckboxChanged"/>
                            <Label Text="Local (this device only)"
                                   FontSize="14"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSelectLocalLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <Label x:Name="ChangeTeamModeHint"
                               Text="Select Online or Local to see your teams."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>

                        <StackLayout x:Name="SharedTeamSection" IsVisible="False" Spacing="8">
                            <Label x:Name="SharedTeamSwitcherLabel"
                                   Text="Your online teams"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   IsVisible="False"/>
                            <CollectionView x:Name="SharedTeamsCollection"
                                            IsVisible="False"
                                            SelectionMode="Single"
                                            SelectionChanged="OnSharedTeamSelectionChanged">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <SwipeView>
                                            <SwipeView.LeftItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Leave"
                                                               BackgroundColor="#FF9800"
                                                               CommandParameter="{Binding .}"
                                                               Invoked="OnLeaveSharedTeamSwipe"/>
                                                </SwipeItems>
                                            </SwipeView.LeftItems>
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Delete"
                                                               BackgroundColor="#F44336"
                                                               CommandParameter="{Binding .}"
                                                               Invoked="OnDeleteSharedTeamSwipe"/>
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            <Frame Padding="10"
                                                   Margin="0,3"
                                                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#505050}"
                                                   CornerRadius="5"
                                                   HasShadow="False"
                                                   InputTransparent="False">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnSharedTeamItemTapped"/>
                                                </Frame.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="10">
                                                    <Label Text="{Binding IsActive, Converter={StaticResource BoolToCheckConverter}}"
                                                           FontSize="20"
                                                           VerticalOptions="Center"/>
                                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                                        <Label Text="{Binding TeamName}"
                                                               FontSize="16"
                                                               FontAttributes="Bold"/>
                                                        <Label Text="{Binding TeamId}"
                                                               FontSize="10"
                                                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                                                        <Label Text="{Binding RoleLabel}"
                                                               FontSize="10"
                                                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>
                                            </Frame>
                                        </SwipeView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView x:Name="SharedTeamSeparator"
                                     HeightRequest="1"
                                     Color="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                     IsVisible="False"/>
                        </StackLayout>

                        <StackLayout x:Name="LocalTeamSection" IsVisible="False" Spacing="8">
                            <Label x:Name="LocalTeamSwitcherLabel"
                                   Text="Your local teams"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   IsVisible="False"/>
                            <CollectionView x:Name="LocalTeamsCollection"
                                            IsVisible="False"
                                            SelectionMode="Single"
                                            SelectionChanged="OnLocalTeamSelectionChanged">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <SwipeView>
                                            <SwipeView.LeftItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Rename"
                                                               BackgroundColor="#2196F3"
                                                               CommandParameter="{Binding .}"
                                                               Invoked="OnRenameTeamSwipe"/>
                                                </SwipeItems>
                                            </SwipeView.LeftItems>
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Delete"
                                                               BackgroundColor="Red"
                                                               CommandParameter="{Binding .}"
                                                               Invoked="OnDeleteTeamSwipe"/>
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            <Frame Padding="10"
                                                   Margin="0,3"
                                                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#505050}"
                                                   CornerRadius="5"
                                                   HasShadow="False"
                                                   InputTransparent="False">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTeamItemTapped"/>
                                                </Frame.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="10">
                                                    <Label Text="{Binding IsActive, Converter={StaticResource BoolToCheckConverter}}"
                                                           FontSize="20"
                                                           VerticalOptions="Center"/>
                                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                                        <Label Text="{Binding TeamName}"
                                                               FontSize="16"
                                                               FontAttributes="Bold"/>
                                                        <Label Text="{Binding TeamId}"
                                                               FontSize="10"
                                                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>
                                            </Frame>
                                        </SwipeView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView x:Name="TeamSeparator"
                                     HeightRequest="1"
                                     Color="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                     IsVisible="False"/>
                        </StackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ========== 3. Join Team ========== -->
            <Frame BorderColor="{AppThemeBinding Light=#BBDEFB, Dark=#1565C0}"
                   Padding="14"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnJoinTeamHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="Join Team"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#1565C0"
                               VerticalOptions="Center"/>
                        <Label x:Name="JoinTeamToggleIcon"
                               Grid.Column="1"
                               Text="▼"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="#1565C0"/>
                    </Grid>
                    <Label x:Name="JoinTeamHint"
                           Text="Tap to expand — join an online team or import a local roster"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#888, Dark=#999}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnJoinTeamHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="JoinTeamContent"
                                         IsVisible="False"
                                         Spacing="12">
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox x:Name="JoinOnlineModeCheckbox"
                                      IsChecked="True"
                                      CheckedChanged="OnJoinOnlineModeChanged"/>
                            <Label Text="Online"
                                   FontSize="14"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnJoinOnlineLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <CheckBox x:Name="JoinLocalModeCheckbox"
                                      CheckedChanged="OnJoinLocalModeChanged"/>
                            <Label Text="Local"
                                   FontSize="14"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnJoinLocalLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <VerticalStackLayout x:Name="JoinSharedSection" Spacing="8">
                            <Label Text="Online team"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="#1565C0"/>
                            <Button x:Name="ImportTeamButton"
                                    Text="Import / Scan Invite (QR)"
                                    Clicked="OnImportTeamClicked"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    HeightRequest="44"
                                    FontSize="14"/>
                            <Label Text="Or enter the invite code from your coach or admin."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                            <Entry x:Name="InviteCodeEntry"
                                   Placeholder="Invite code (e.g. ABCD-EFGH)"
                                   MaxLength="20"/>
                            <Label Text="Your display name (shown in Chat)"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                            <Entry x:Name="JoinDisplayNameEntry"
                                   Placeholder="e.g. Alex or Coach Sam"
                                   MaxLength="40"/>
                            <Button Text="Join as Member"
                                    Clicked="OnJoinTeamClicked"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    HeightRequest="44"
                                    FontSize="14"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="LocalImportSubsection"
                                             IsVisible="False"
                                             Spacing="8">
                            <Label Text="Local team (this device)"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="#2E7D32"/>
                            <Label Text="Scan a local roster QR shared from another device (offline copy)."
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#888, Dark=#999}"/>
                            <Button x:Name="LocalImportTeamButton"
                                    Text="Import Local Team (QR)"
                                    Clicked="OnImportTeamClicked"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    HeightRequest="44"
                                    FontSize="14"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ========== 4. Create Team (nickname / under club / local) ========== -->
            <Frame BorderColor="{AppThemeBinding Light=#C8E6C9, Dark=#2E7D32}"
                   Padding="14"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateTeamHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label x:Name="CreateSubsectionTitle"
                               Text="Create Team"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#2E7D32"
                               VerticalOptions="Center"/>
                        <Label x:Name="CreateTeamToggleIcon"
                               Grid.Column="1"
                               Text="▼"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="#2E7D32"/>
                    </Grid>
                    <Label x:Name="CreateTeamHint"
                           Text="Tap to expand — online nickname / under a club you manage, or local"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#888, Dark=#999}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateTeamHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <StackLayout x:Name="CreateTeamContent" IsVisible="False" Spacing="12" Padding="0,4,0,0">
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox x:Name="CreateSharedModeCheckbox"
                                      IsChecked="True"
                                      CheckedChanged="OnCreateSharedModeChanged"/>
                            <Label Text="Online"
                                   FontSize="14"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateOnlineLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <CheckBox x:Name="CreateLocalModeCheckbox"
                                      CheckedChanged="OnCreateLocalModeChanged"/>
                            <Label Text="Local"
                                   FontSize="14"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateLocalLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <StackLayout x:Name="CreateSharedSection" IsVisible="True" Spacing="10">
                            <Label Text="Add team under a club you manage"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                            <Picker x:Name="ManagedClubPicker"
                                    Title="Select managed club"
                                    SelectedIndexChanged="OnManagedClubPickerChanged"/>
                            <Entry x:Name="UnderClubTeamEntry"
                                   Placeholder="New team name under selected club"
                                   TextChanged="OnUnderClubTeamChanged"/>

                            <Label Text="OR nickname (standalone — no club)"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold"
                                   Margin="0,6,0,0"
                                   FontSize="12"/>
                            <Entry x:Name="NicknameEntry"
                                   Placeholder="Team nickname (e.g., Socceroos)"
                                   TextChanged="OnNicknameChanged"/>

                            <Label Text="Your display name (shown in Chat)"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                            <Entry x:Name="CreateDisplayNameEntry"
                                   Placeholder="e.g. Alex or Coach Sam"
                                   MaxLength="40"/>
                            <Label Text="Your Email Address"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                            <Label Text="Used to send the Team Owner Recovery Code as a backup."
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#888, Dark=#999}"/>
                            <Entry x:Name="CreatorEmailEntry"
                                   Placeholder="your@email.com"
                                   Keyboard="Email"
                                   MaxLength="200"/>
                            <Button x:Name="CreateSharedTeamButton"
                                    Text="Create Online Team"
                                    Clicked="OnCreateTeamClicked"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    HeightRequest="44"
                                    FontSize="14"/>
                            <HorizontalStackLayout x:Name="CreateTeamLoadingSection"
                                                   IsVisible="False"
                                                   HorizontalOptions="Center"
                                                   Spacing="10">
                                <ActivityIndicator x:Name="CreateTeamSpinner"
                                                   IsRunning="False"
                                                   Color="#4CAF50"
                                                   WidthRequest="22"
                                                   HeightRequest="22"/>
                                <Label Text="Setting up team in the cloud..."
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </StackLayout>

                        <StackLayout x:Name="CreateLocalSection" IsVisible="False" Spacing="10">
                            <Label Text="📱 New Local Team"
                                   FontAttributes="Bold"
                                   FontSize="14"/>
                            <Entry x:Name="LocalTeamNameEntry"
                                   Placeholder="Team name (stored on this device only)"/>
                            <Button Text="Create Local Team"
                                    Clicked="OnSetLocalTeamClicked"
                                    BackgroundColor="#FF9800"
                                    TextColor="White"
                                    HeightRequest="44"
                                    FontSize="14"/>
                        </StackLayout>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ========== 5. Create Club (always available) ========== -->
            <Frame BorderColor="{AppThemeBinding Light=#FFE0B2, Dark=#EF6C00}"
                   Padding="14"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateClubHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="Create Club (online)"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#EF6C00"
                               VerticalOptions="Center"/>
                        <Label x:Name="CreateClubToggleIcon"
                               Grid.Column="1"
                               Text="▼"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="#EF6C00"/>
                    </Grid>
                    <Label x:Name="CreateClubHint"
                           Text="Tap to expand — start a new online club and its first team (always available)"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#888, Dark=#999}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateClubHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="CreateClubContent"
                                         IsVisible="False"
                                         Spacing="10"
                                         Padding="0,4,0,0">
                        <Label Text="You become Club Owner. Save both the Club and Team Owner Recovery Codes when shown."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                        <Entry x:Name="ClubEntry"
                               Placeholder="Club name (e.g., Manchester United FC)"/>
                        <Entry x:Name="TeamEntry"
                               Placeholder="First team name (e.g., U17 Boys)"/>
                        <Label Text="Your display name (shown in Chat)"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                        <Entry x:Name="ClubCreateDisplayNameEntry"
                               Placeholder="e.g. Alex or Coach Sam"
                               MaxLength="40"/>
                        <Label Text="Your Email Address"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                        <Label Text="Used to send recovery reminders as a backup."
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#888, Dark=#999}"/>
                        <Entry x:Name="ClubCreatorEmailEntry"
                               Placeholder="your@email.com"
                               Keyboard="Email"
                               MaxLength="200"/>
                        <Button x:Name="CreateClubButton"
                                Text="Create Club &amp; First Team"
                                Clicked="OnCreateClubClicked"
                                BackgroundColor="#EF6C00"
                                TextColor="White"
                                HeightRequest="44"
                                FontSize="14"/>
                        <HorizontalStackLayout x:Name="CreateClubLoadingSection"
                                               IsVisible="False"
                                               HorizontalOptions="Center"
                                               Spacing="10">
                            <ActivityIndicator x:Name="CreateClubSpinner"
                                               IsRunning="False"
                                               Color="#EF6C00"
                                               WidthRequest="22"
                                               HeightRequest="22"/>
                            <Label Text="Setting up club in the cloud..."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ========== 6. Recover Owner Access ========== -->
            <Frame x:Name="RejoinAdminSection"
                   BorderColor="#FF9800"
                   Padding="14"
                   CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecoverAdminHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="🔑 Recover Owner Access"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#E65100"
                               VerticalOptions="Center"/>
                        <Label x:Name="RecoverAdminToggleIcon"
                               Grid.Column="1"
                               Text="▼"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="#E65100"/>
                    </Grid>
                    <Label x:Name="RecoverAdminHint"
                           Text="Tap to expand — new devices / lost Owner phone"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#999, Dark=#888}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecoverAdminHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <StackLayout x:Name="RecoverAdminContent" IsVisible="False" Spacing="10">
                        <Label Text="Enter any Team ID under your club plus a recovery code. A Team Owner Recovery Code restores that team; a Club Owner Recovery Code restores the club (Team ID is only used to find the club)."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"/>
                        <Entry x:Name="AdminRejoinTeamIdEntry"
                               Placeholder="Team ID (e.g. u17-boys-a1b2c3)"
                               MaxLength="60"/>
                        <Entry x:Name="AdminRejoinCodeEntry"
                               Placeholder="Team or Club Owner Recovery Code"
                               MaxLength="24"/>
                        <Entry x:Name="AdminRejoinDisplayNameEntry"
                               Placeholder="Your display name (shown in Chat)"
                               MaxLength="40"/>
                        <Button x:Name="RejoinAsAdminButton"
                                Text="Restore Owner Access"
                                Clicked="OnRejoinAsAdminClicked"
                                BackgroundColor="#E65100"
                                TextColor="White"
                                HeightRequest="44"
                                FontSize="14"/>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"/>
                        <Label Text="📧 Forgot your Team Owner Recovery Code?"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#E65100"/>
                        <Label Text="Enter Team ID — team recovery reminder goes to the email registered at create. (Club recovery codes are not emailed yet.)"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#888, Dark=#999}"/>
                        <Entry x:Name="EmailReminderTeamIdEntry"
                               Placeholder="Team ID"
                               MaxLength="60"/>
                        <Button x:Name="RequestAdminCodeEmailButton"
                                Text="Send Recovery Reminder Email"
                                Clicked="OnRequestAdminCodeEmailClicked"
                                BackgroundColor="#FF9800"
                                TextColor="White"
                                HeightRequest="44"
                                FontSize="14"/>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
