<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TurfTime2"
             x:Class="TurfTime2.TeamDetailsPage"
             Title="Team">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ContentPage.Resources>
        <local:BoolToCheckConverter x:Key="BoolToCheckConverter"/>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- ========== 1. Team Admin Panel (current team tools) ========== -->
            <Border Style="{StaticResource PvCard}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTeamAdminHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Style="{StaticResource PvCardTitle}" Text="Team Admin Panel" VerticalOptions="Center"/>
                        <Label Style="{StaticResource PvBody}" x:Name="TeamAdminToggleIcon" Grid.Column="1" Text="▼" VerticalOptions="Center"/>
                    </Grid>
                    <Label Style="{StaticResource PvCaption}" x:Name="TeamAdminHint" Text="Tap to expand — current team tools">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTeamAdminHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="TeamAdminContent"
                                         IsVisible="False"
                                         Spacing="8">
                        <Label Style="{StaticResource PvBodyStrong}" x:Name="CurrentTeamLabel" Text="No team selected"/>
                        <Label Style="{StaticResource PvCaption}" x:Name="TeamModeLabel" Text="Mode: Not configured"/>

                        <StackLayout x:Name="DisplayNameSection"
                                     IsVisible="False"
                                     Spacing="8">
                            <Label Style="{StaticResource PvBodyStrong}" Text="Your chat display name"/>
                            <Label Style="{StaticResource PvCaption}" Text="Teammates see this name in Chat and push notifications."/>
                            <Entry Style="{StaticResource PvEntry}" x:Name="CurrentDisplayNameEntry" Placeholder="e.g. Alex or Coach Sam" MaxLength="40"/>
                            <Button Style="{StaticResource PvButtonSecondary}" x:Name="SaveDisplayNameButton" Text="Save Display Name" Clicked="OnSaveDisplayNameClicked"/>
                        </StackLayout>

                        <!-- Popular action: directly under display-name save (still visible for local teams). -->
                        <Button Style="{StaticResource PvButtonSecondary}" x:Name="ShareTeamButton" Text="Share Team (QR)" Clicked="OnShareTeamClicked"/>

                        <!-- All online-team members: see who is Owner / Admin / Member. -->
                        <Button Style="{StaticResource PvButtonSecondary}" x:Name="ViewTeamMembersButton" Text="View Team Members" IsVisible="False" Clicked="OnViewMembersClicked"/>
                        <Label Style="{StaticResource PvCaption}" x:Name="ViewTeamMembersHint" Text="See who is Owner or Admin if you need help with team settings." IsVisible="False"/>

                        <!-- Admin-only tools (online teams). Visible when role is Admin / Owner. -->
                        <Border Style="{StaticResource PvCardTinted}" x:Name="SharedAdminTools" IsVisible="False" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Style="{StaticResource PvBodyStrong}" Text="Admin"/>
                                <Label Style="{StaticResource PvCaption}" Text="Invite codes, promote/remove, and match control — Admin only."/>
                                <Border Style="{StaticResource PvCardWarning}" Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{StaticResource PvBodyStrong}" Text="Invite Code"/>
                                        <Label Style="{StaticResource PvCardTitle}" x:Name="InviteCodeDisplay" Text="Loading..." HorizontalOptions="Center" LineBreakMode="MiddleTruncation"/>
                                        <Label Style="{StaticResource PvCaption}" Text="Share this code with team members" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Button Style="{StaticResource PvButtonWarning}" Text="Regenerate Invite Code" Clicked="OnRegenerateCodeClicked"/>
                                <Button Style="{StaticResource PvButtonPrimary}" Text="Promote to Admin" Clicked="OnPromoteToAdminClicked"/>
                                <Button Style="{StaticResource PvButtonDanger}" Text="Remove Member" Clicked="OnRemoveMemberClicked"/>
                                <Label Style="{StaticResource PvCaption}" Text="Removes someone from the cloud team. They must rejoin with the invite code. You cannot remove the Owner; only the Owner can remove other Admins."/>
                                <Button Style="{StaticResource PvButtonOutline}" x:Name="RelinquishControlButton" Text="Relinquish Match Control" Clicked="OnRelinquishControlClicked"/>
                                <Label Style="{StaticResource PvCaption}" Text="Hand over live-match control so another Admin can run the game. If you go offline, the server auto-releases control after ~90s."/>
                                <Button Style="{StaticResource PvButtonSecondary}" x:Name="TransferOwnershipButton" Text="Transfer Ownership" IsVisible="False" Clicked="OnTransferOwnershipClicked"/>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="8" Margin="0,4,0,0">
                            <Button Style="{StaticResource PvButtonDangerOutline}" x:Name="LeaveTeamButton" Text="Leave Team" IsVisible="False" Clicked="OnLeaveTeamButtonClicked"/>
                            <Button Style="{StaticResource PvButtonDangerOutline}" x:Name="DeleteLocalTeamButton" Text="Delete Team" IsVisible="False" Clicked="OnDeleteLocalTeamButtonClicked"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========== 2. Select Team (switch between existing teams) ========== -->
            <Border Style="{StaticResource PvCard}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangeTeamHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Style="{StaticResource PvCardTitle}" Text="Select Team" VerticalOptions="Center"/>
                        <Label Style="{StaticResource PvBody}" x:Name="ChangeTeamToggleIcon" Grid.Column="1" Text="▼" VerticalOptions="Center"/>
                    </Grid>
                    <Label Style="{StaticResource PvCaption}" x:Name="ChangeTeamHint" Text="Tap to expand — switch between teams you already have">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangeTeamHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="ChangeTeamContent"
                                         IsVisible="False"
                                         Spacing="12">
                        <!-- Segmented control (Online / Local). The original CheckBoxes stay (hidden) so the code-behind and its CheckedChanged logic are unchanged; segments call the same tap handlers the labels used. -->
                        <CheckBox x:Name="SharedCheckbox" CheckedChanged="OnSharedCheckboxChanged" IsVisible="False"/>
                        <CheckBox x:Name="LocalCheckbox" CheckedChanged="OnLocalCheckboxChanged" IsVisible="False"/>
                        <Border Style="{StaticResource PvSegmentTrack}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Border Grid.Column="0" Style="{StaticResource PvSegment}" BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference SharedCheckbox}, Path=IsChecked}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSelectOnlineLabelTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource PvSegmentLabel}" Text="Online (cloud)" TextColor="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference SharedCheckbox}, Path=IsChecked}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PvSegment}" BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference LocalCheckbox}, Path=IsChecked}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSelectLocalLabelTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource PvSegmentLabel}" Text="Local (this device)" TextColor="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference LocalCheckbox}, Path=IsChecked}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>

                        <Label Style="{StaticResource PvCaption}" x:Name="ChangeTeamModeHint" Text="Select Online or Local to see your teams."/>

                        <StackLayout x:Name="SharedTeamSection" IsVisible="False" Spacing="8">
                            <Label Style="{StaticResource PvBodyStrong}" x:Name="SharedTeamSwitcherLabel" Text="Your online teams" IsVisible="False"/>
                            <!-- BindableLayout, not CollectionView: a CollectionView that starts IsVisible=False inside a
                                 StackLayout in a ScrollView measured to zero height on iOS (label showed
                                 "Your Teams (2)" with no rows). Lists are small, so no virtualisation needed. -->
                            <VerticalStackLayout x:Name="SharedTeamsCollection" IsVisible="False" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <SwipeView>
                                            <SwipeView.LeftItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Leave"
                                                               BackgroundColor="{StaticResource PvWarningLight}"
                                                               CommandParameter="{Binding .}"
                                                               Invoked="OnLeaveSharedTeamSwipe"/>
                                                </SwipeItems>
                                            </SwipeView.LeftItems>
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Delete"
                                                               BackgroundColor="{StaticResource PvDangerLight}"
                                                               CommandParameter="{Binding .}"
                                                               Invoked="OnDeleteSharedTeamSwipe"/>
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            <Border Style="{StaticResource PvCard}" Margin="0,3" InputTransparent="False" Padding="12">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnSharedTeamItemTapped"/>
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Style="{StaticResource PvHeadline}" Text="{Binding IsActive, Converter={StaticResource BoolToCheckConverter}}" VerticalOptions="Center"/>
                                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                                        <Label Style="{StaticResource PvCardTitle}" Text="{Binding TeamName}"/>
                                                        <Label Style="{StaticResource PvCaption}" Text="{Binding TeamId}"/>
                                                        <Label Style="{StaticResource PvCaption}" Text="{Binding RoleLabel}"/>
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </SwipeView>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <BoxView x:Name="SharedTeamSeparator"
                                     HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}"
                                     IsVisible="False"/>
                        </StackLayout>

                        <StackLayout x:Name="LocalTeamSection" IsVisible="False" Spacing="8">
                            <Label Style="{StaticResource PvBodyStrong}" x:Name="LocalTeamSwitcherLabel" Text="Your local teams" IsVisible="False"/>
                            <!-- BindableLayout, not CollectionView: a CollectionView that starts IsVisible=False inside a
                                 StackLayout in a ScrollView measured to zero height on iOS (label showed
                                 "Your Teams (2)" with no rows). Lists are small, so no virtualisation needed. -->
                            <VerticalStackLayout x:Name="LocalTeamsCollection" IsVisible="False" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <SwipeView>
                                            <SwipeView.LeftItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Rename"
                                                               BackgroundColor="{StaticResource PvPrimaryLight}"
                                                               CommandParameter="{Binding .}"
                                                               Invoked="OnRenameTeamSwipe"/>
                                                </SwipeItems>
                                            </SwipeView.LeftItems>
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Delete"
                                                               BackgroundColor="{StaticResource PvDangerLight}"
                                                               CommandParameter="{Binding .}"
                                                               Invoked="OnDeleteTeamSwipe"/>
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            <Border Style="{StaticResource PvCard}" Margin="0,3" InputTransparent="False" Padding="12">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTeamItemTapped"/>
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Style="{StaticResource PvHeadline}" Text="{Binding IsActive, Converter={StaticResource BoolToCheckConverter}}" VerticalOptions="Center"/>
                                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                                        <Label Style="{StaticResource PvCardTitle}" Text="{Binding TeamName}"/>
                                                        <Label Style="{StaticResource PvCaption}" Text="{Binding TeamId}"/>
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </SwipeView>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <BoxView x:Name="TeamSeparator"
                                     HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}"
                                     IsVisible="False"/>
                        </StackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========== 3. Join Team ========== -->
            <Border Style="{StaticResource PvCard}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnJoinTeamHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Style="{StaticResource PvCardTitle}" Text="Join Team" VerticalOptions="Center"/>
                        <Label Style="{StaticResource PvBody}" x:Name="JoinTeamToggleIcon" Grid.Column="1" Text="▼" VerticalOptions="Center"/>
                    </Grid>
                    <Label Style="{StaticResource PvCaption}" x:Name="JoinTeamHint" Text="Tap to expand — join an online team or import a local roster">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnJoinTeamHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="JoinTeamContent"
                                         IsVisible="False"
                                         Spacing="12">
                        <!-- Segmented control (Join: Online / Local). The original CheckBoxes stay (hidden) so the code-behind and its CheckedChanged logic are unchanged; segments call the same tap handlers the labels used. -->
                        <CheckBox x:Name="JoinOnlineModeCheckbox" IsChecked="True" CheckedChanged="OnJoinOnlineModeChanged" IsVisible="False"/>
                        <CheckBox x:Name="JoinLocalModeCheckbox" CheckedChanged="OnJoinLocalModeChanged" IsVisible="False"/>
                        <Border Style="{StaticResource PvSegmentTrack}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Border Grid.Column="0" Style="{StaticResource PvSegment}" BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference JoinOnlineModeCheckbox}, Path=IsChecked}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnJoinOnlineLabelTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource PvSegmentLabel}" Text="Online" TextColor="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference JoinOnlineModeCheckbox}, Path=IsChecked}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PvSegment}" BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference JoinLocalModeCheckbox}, Path=IsChecked}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnJoinLocalLabelTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource PvSegmentLabel}" Text="Local" TextColor="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference JoinLocalModeCheckbox}, Path=IsChecked}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>

                        <VerticalStackLayout x:Name="JoinSharedSection" Spacing="8">
                            <Label Style="{StaticResource PvLink}" Text="Online team"/>
                            <Button Style="{StaticResource PvButtonPrimary}" x:Name="ImportTeamButton" Text="Import / Scan Invite (QR)" Clicked="OnImportTeamClicked"/>
                            <Label Style="{StaticResource PvCaption}" Text="Or enter the invite code from your coach or admin."/>
                            <Entry Style="{StaticResource PvEntry}" x:Name="InviteCodeEntry" Placeholder="Invite code (e.g. ABCD-EFGH)" MaxLength="20"/>
                            <Label Style="{StaticResource PvCaption}" Text="Your display name (shown in Chat)"/>
                            <Entry Style="{StaticResource PvEntry}" x:Name="JoinDisplayNameEntry" Placeholder="e.g. Alex or Coach Sam" MaxLength="40"/>
                            <Button Style="{StaticResource PvButtonSecondary}" Text="Join as Member" Clicked="OnJoinTeamClicked"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="LocalImportSubsection"
                                             IsVisible="False"
                                             Spacing="8">
                            <Label Style="{StaticResource PvBodyStrong}" Text="Local team (this device)"/>
                            <Label Style="{StaticResource PvCaption}" Text="Scan a local roster QR shared from another device (offline copy)."/>
                            <Button Style="{StaticResource PvButtonPrimary}" x:Name="LocalImportTeamButton" Text="Import Local Team (QR)" Clicked="OnImportTeamClicked"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========== 4. Create Team (nickname / under club / local) ========== -->
            <Border Style="{StaticResource PvCard}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateTeamHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Style="{StaticResource PvCardTitle}" x:Name="CreateSubsectionTitle" Text="Create Team" VerticalOptions="Center"/>
                        <Label Style="{StaticResource PvBody}" x:Name="CreateTeamToggleIcon" Grid.Column="1" Text="▼" VerticalOptions="Center"/>
                    </Grid>
                    <Label Style="{StaticResource PvCaption}" x:Name="CreateTeamHint" Text="Tap to expand — online nickname / under a club you manage, or local">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateTeamHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <StackLayout x:Name="CreateTeamContent" IsVisible="False" Spacing="12" Padding="0,4,0,0">
                        <!-- Segmented control (Create: Online / Local). The original CheckBoxes stay (hidden) so the code-behind and its CheckedChanged logic are unchanged; segments call the same tap handlers the labels used. -->
                        <CheckBox x:Name="CreateSharedModeCheckbox" IsChecked="True" CheckedChanged="OnCreateSharedModeChanged" IsVisible="False"/>
                        <CheckBox x:Name="CreateLocalModeCheckbox" CheckedChanged="OnCreateLocalModeChanged" IsVisible="False"/>
                        <Border Style="{StaticResource PvSegmentTrack}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Border Grid.Column="0" Style="{StaticResource PvSegment}" BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference CreateSharedModeCheckbox}, Path=IsChecked}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCreateOnlineLabelTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource PvSegmentLabel}" Text="Online" TextColor="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference CreateSharedModeCheckbox}, Path=IsChecked}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PvSegment}" BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference CreateLocalModeCheckbox}, Path=IsChecked}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCreateLocalLabelTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource PvSegmentLabel}" Text="Local" TextColor="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference CreateLocalModeCheckbox}, Path=IsChecked}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>

                        <StackLayout x:Name="CreateSharedSection" IsVisible="True" Spacing="8">
                            <Label Style="{StaticResource PvBodyStrong}" Text="Add team under a club you manage"/>
                            <Picker Style="{StaticResource PvPicker}" x:Name="ManagedClubPicker" Title="Select managed club" SelectedIndexChanged="OnManagedClubPickerChanged"/>
                            <Entry Style="{StaticResource PvEntry}" x:Name="UnderClubTeamEntry" Placeholder="New team name under selected club" TextChanged="OnUnderClubTeamChanged"/>

                            <Label Style="{StaticResource PvBodyStrong}" Text="OR nickname (standalone — no club)" HorizontalOptions="Center" Margin="0,6,0,0"/>
                            <Entry Style="{StaticResource PvEntry}" x:Name="NicknameEntry" Placeholder="Team nickname (e.g., Socceroos)" TextChanged="OnNicknameChanged"/>

                            <Label Style="{StaticResource PvCaption}" Text="Your display name (shown in Chat)"/>
                            <Entry Style="{StaticResource PvEntry}" x:Name="CreateDisplayNameEntry" Placeholder="e.g. Alex or Coach Sam" MaxLength="40"/>
                            <Label Style="{StaticResource PvCaption}" Text="Your Email Address"/>
                            <Label Style="{StaticResource PvCaption}" Text="Used to send the Team Owner Recovery Code as a backup."/>
                            <Entry Style="{StaticResource PvEntry}" x:Name="CreatorEmailEntry" Placeholder="your@email.com" Keyboard="Email" MaxLength="200"/>
                            <Button Style="{StaticResource PvButtonPrimary}" x:Name="CreateSharedTeamButton" Text="Create Online Team" Clicked="OnCreateTeamClicked"/>
                            <HorizontalStackLayout x:Name="CreateTeamLoadingSection"
                                                   IsVisible="False"
                                                   HorizontalOptions="Center"
                                                   Spacing="8">
                                <ActivityIndicator x:Name="CreateTeamSpinner"
                                                   IsRunning="False"
                                                   Color="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}"
                                                   WidthRequest="22"
                                                   HeightRequest="22"/>
                                <Label Style="{StaticResource PvCaption}" Text="Setting up team in the cloud..." VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </StackLayout>

                        <StackLayout x:Name="CreateLocalSection" IsVisible="False" Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconPhone}" FontSize="20" VerticalOptions="Center"/>
                                <Label Style="{StaticResource PvBodyStrong}" Text="New Local Team" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Entry Style="{StaticResource PvEntry}" x:Name="LocalTeamNameEntry" Placeholder="Team name (stored on this device only)"/>
                            <Button Style="{StaticResource PvButtonSecondary}" Text="Create Local Team" Clicked="OnSetLocalTeamClicked"/>
                        </StackLayout>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========== 5. Create Club (always available) ========== -->
            <Border Style="{StaticResource PvCardWarning}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateClubHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Style="{StaticResource PvWarningText}" Text="Create Club (online)" VerticalOptions="Center"/>
                        <Label Style="{StaticResource PvWarningText}" x:Name="CreateClubToggleIcon" Grid.Column="1" Text="▼" VerticalOptions="Center"/>
                    </Grid>
                    <Label Style="{StaticResource PvCaption}" x:Name="CreateClubHint" Text="Tap to expand — start a new online club and its first team (always available)">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateClubHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <VerticalStackLayout x:Name="CreateClubContent"
                                         IsVisible="False"
                                         Spacing="8"
                                         Padding="0,4,0,0">
                        <Label Style="{StaticResource PvCaption}" Text="You become Club Owner. Save both the Club and Team Owner Recovery Codes when shown."/>
                        <Entry Style="{StaticResource PvEntry}" x:Name="ClubEntry" Placeholder="Club name (e.g., Manchester United FC)"/>
                        <Entry Style="{StaticResource PvEntry}" x:Name="TeamEntry" Placeholder="First team name (e.g., U17 Boys)"/>
                        <Label Style="{StaticResource PvCaption}" Text="Your display name (shown in Chat)"/>
                        <Entry Style="{StaticResource PvEntry}" x:Name="ClubCreateDisplayNameEntry" Placeholder="e.g. Alex or Coach Sam" MaxLength="40"/>
                        <Label Style="{StaticResource PvCaption}" Text="Your Email Address"/>
                        <Label Style="{StaticResource PvCaption}" Text="Used to send recovery reminders as a backup."/>
                        <Entry Style="{StaticResource PvEntry}" x:Name="ClubCreatorEmailEntry" Placeholder="your@email.com" Keyboard="Email" MaxLength="200"/>
                        <Button Style="{StaticResource PvButtonWarning}" x:Name="CreateClubButton" Text="Create Club &amp; First Team" Clicked="OnCreateClubClicked"/>
                        <HorizontalStackLayout x:Name="CreateClubLoadingSection"
                                               IsVisible="False"
                                               HorizontalOptions="Center"
                                               Spacing="8">
                            <ActivityIndicator x:Name="CreateClubSpinner"
                                               IsRunning="False"
                                               Color="{AppThemeBinding Light={StaticResource PvWarningTextLight}, Dark={StaticResource PvWarningDark}}"
                                               WidthRequest="22"
                                               HeightRequest="22"/>
                            <Label Style="{StaticResource PvCaption}" Text="Setting up club in the cloud..." VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========== 6. Recover Owner Access ========== -->
            <Border Style="{StaticResource PvCard}" x:Name="RejoinAdminSection" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecoverAdminHeaderTapped"/>
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconKey}" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource PvWarningTextLight}, Dark={StaticResource PvWarningDark}}" VerticalOptions="Center"/>
                            <Label Style="{StaticResource PvWarningText}" Text="Recover Owner Access" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource PvWarningText}" x:Name="RecoverAdminToggleIcon" Grid.Column="1" Text="▼" VerticalOptions="Center"/>
                    </Grid>
                    <Label Style="{StaticResource PvCaption}" x:Name="RecoverAdminHint" Text="Tap to expand — new devices / lost Owner phone">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecoverAdminHeaderTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <StackLayout x:Name="RecoverAdminContent" IsVisible="False" Spacing="8">
                        <Label Style="{StaticResource PvCaption}" Text="Enter any Team ID under your club plus a recovery code. A Team Owner Recovery Code restores that team; a Club Owner Recovery Code restores the club (Team ID is only used to find the club)."/>
                        <Entry Style="{StaticResource PvEntry}" x:Name="AdminRejoinTeamIdEntry" Placeholder="Team ID (e.g. u17-boys-a1b2c3)" MaxLength="60"/>
                        <Entry Style="{StaticResource PvEntry}" x:Name="AdminRejoinCodeEntry" Placeholder="Team or Club Owner Recovery Code" MaxLength="24"/>
                        <Entry Style="{StaticResource PvEntry}" x:Name="AdminRejoinDisplayNameEntry" Placeholder="Your display name (shown in Chat)" MaxLength="40"/>
                        <Button Style="{StaticResource PvButtonWarning}" x:Name="RejoinAsAdminButton" Text="Restore Owner Access" Clicked="OnRejoinAsAdminClicked"/>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}"/>
                        <HorizontalStackLayout Spacing="8">
                            <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconMail}" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource PvWarningTextLight}, Dark={StaticResource PvWarningDark}}" VerticalOptions="Center"/>
                            <Label Style="{StaticResource PvWarningText}" Text="Forgot your Team Owner Recovery Code?" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource PvCaption}" Text="Enter Team ID — team recovery reminder goes to the email registered at create. (Club recovery codes are not emailed yet.)"/>
                        <Entry Style="{StaticResource PvEntry}" x:Name="EmailReminderTeamIdEntry" Placeholder="Team ID" MaxLength="60"/>
                        <Button Style="{StaticResource PvButtonSecondary}" x:Name="RequestAdminCodeEmailButton" Text="Send Recovery Reminder Email" Clicked="OnRequestAdminCodeEmailClicked"/>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
