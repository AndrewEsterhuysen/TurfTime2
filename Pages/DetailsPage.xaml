<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.DetailsPage"
             Title="Details">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="12">
            <Label Style="{StaticResource PvTitle}" Text="Details" Margin="4,8,0,8"/>
            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLocationTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource PvIconTile}">
                        <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconLocation}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource PvCardTitle}" Text="Location" />
                        <Label Style="{StaticResource PvCaption}" Text="Match venue, GPS, and map links" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconChevron}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnKitTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource PvIconTile}">
                        <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconCheckroom}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource PvCardTitle}" Text="Kit" />
                        <Label Style="{StaticResource PvCaption}" Text="Arrive, warm-up, game, and event kit" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconChevron}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDutiesTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource PvIconTile}">
                        <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconFactCheck}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource PvCardTitle}" Text="Duties" />
                        <Label Style="{StaticResource PvCaption}" Text="Duty officer, canteen, grounds, other" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconChevron}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNominationsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource PvIconTile}">
                        <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconStar}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource PvCardTitle}" Text="Nominations" />
                        <Label Style="{StaticResource PvCaption}" Text="Player nominations and selections" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconChevron}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
