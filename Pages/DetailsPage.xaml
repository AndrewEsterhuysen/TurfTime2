<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.DetailsPage"
             Title="Details"
             BackgroundColor="#1b5e20">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Location -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True"
                   Margin="0,8,0,0">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLocationTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label Text="📍" FontSize="32" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Location"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Match venue, GPS, and map links"
                                   FontSize="14"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                        <Label Text="›"
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Kit -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnKitTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label Text="👕" FontSize="32" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Kit"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Team kit and colours"
                                   FontSize="14"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                        <Label Text="›"
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Duties -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDutiesTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label Text="✅" FontSize="32" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Duties"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Match-day roles and assignments"
                                   FontSize="14"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                        <Label Text="›"
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Nominations -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="0"
                   HasShadow="True">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNominationsTapped" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Padding="20" Spacing="15">
                        <Label Text="⭐" FontSize="32" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="Nominations"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Player nominations and selections"
                                   FontSize="14"
                                   TextColor="#E0E0E0" />
                        </VerticalStackLayout>
                        <Label Text="›"
                               FontSize="32"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
