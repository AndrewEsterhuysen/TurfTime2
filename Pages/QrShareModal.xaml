<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.QrShareModal"
             Title="Share Team"
             Shell.PresentationMode="Modal">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Close" Clicked="OnCloseToolbarClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
    <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="16">

        <Label Style="{StaticResource PvHeadline}" Text="Share via QR Code" HorizontalOptions="Center"/>

        <Border Style="{StaticResource PvCard}">
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource PvCardTitle}" Text="{Binding TeamName}"/>
                <Label Style="{StaticResource PvCaption}" Text="{Binding SubtitleLine}"/>
                <Label Style="{StaticResource PvCaption}" Text="{Binding DetailLine}"/>
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource PvCard}" HorizontalOptions="Center" Padding="8" BackgroundColor="White">
            <Image
                Source="{Binding QrImage}"
                WidthRequest="280"
                HeightRequest="360"
                Aspect="AspectFit" />
        </Border>

        <!-- Shared team: tappable join deep link for email / SMS -->
        <VerticalStackLayout IsVisible="{Binding ShowJoinLink}" Spacing="8">
            <Label Style="{StaticResource PvBodyStrong}" Text="Join link (email or text message)" HorizontalTextAlignment="Center"/>
            <Label Style="{StaticResource PvLink}" Text="{Binding JoinLink}" HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyJoinLinkCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Button Style="{StaticResource PvButtonOutline}" Text="Copy join link" Command="{Binding CopyJoinLinkCommand}"/>
        </VerticalStackLayout>

        <Label Style="{StaticResource PvCaption}" Text="{Binding Instructions}" HorizontalTextAlignment="Center" Margin="0,8"/>

        <VerticalStackLayout Spacing="8">
            <Button Style="{StaticResource PvButtonPrimary}" Text="{Binding ShareButtonText}" Command="{Binding ShareQrImageCommand}"/>

            <Button Style="{StaticResource PvButtonOutline}" Text="Close" Command="{Binding CloseCommand}"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
    </ScrollView>

</ContentPage>
