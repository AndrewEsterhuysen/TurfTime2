<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.AiConnectPage"
             Title="AI assistant">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="12">
            <Label Style="{StaticResource PvTitle}" Text="Connect AI assistant" Margin="4,8,0,8" />
            <Label Style="{StaticResource PvBody}"
                   Text="Let ChatGPT, Claude, Grok or Copilot see your teams, next match, kit, duties, roster, lineup and chat." />
            <Label Style="{StaticResource PvBody}"
                   Text="Choose Allow read and write when connecting to also let it post chat messages as you and, if you're an admin, update kit, duties, next match and roster. Or choose Allow read-only." />
            <Label Style="{StaticResource PvCaption}"
                   Text="Shared (online) teams only. Local teams stay on this phone." />
            <Label Style="{StaticResource PvBody}"
                   Text="Add the TurfTimer connector in your assistant, then tap Get code and enter it on the Connect TurfTimer page." />
            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="CodeLabel" Style="{StaticResource PvTitle}" Text="—" HorizontalOptions="Center" />
                    <Label x:Name="ExpiryLabel" Style="{StaticResource PvCaption}" Text="Codes work once and expire after 10 minutes." HorizontalOptions="Center" />
                    <Button x:Name="GetCodeButton" Style="{StaticResource PvButtonPrimary}" Text="Get code" Clicked="OnGetCodeClicked" />
                </VerticalStackLayout>
            </Border>
            <Label Style="{StaticResource PvBodyStrong}" Text="Connected assistants" Margin="4,8,0,0" />
            <VerticalStackLayout x:Name="GrantsList" Spacing="8" />
            <Label x:Name="NoGrantsLabel" Style="{StaticResource PvCaption}" Text="None" />
            <Label Style="{StaticResource PvCaption}" Text="Tap Disconnect to remove an assistant's access at any time." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
