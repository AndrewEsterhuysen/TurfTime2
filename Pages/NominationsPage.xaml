<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.NominationsPage"
             Title="Nominations">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="16">
            <Label Style="{StaticResource PvTitle}" Text="Player of the match" Margin="4,0,0,0" />

            <!-- Shown for local teams, no matches, or load errors -->
            <Border x:Name="NoticeCard" Style="{StaticResource PvCardWarning}" Padding="12,8" IsVisible="False">
                <Label x:Name="NoticeLabel" Style="{StaticResource PvWarningText}" FontFamily="InterSemiBold"
                       HorizontalTextAlignment="Center" />
            </Border>

            <!-- 1. Match -->
            <Border x:Name="MatchCard" Style="{StaticResource PvCard}" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvSectionHeader}" Text="Match" />
                    <Picker x:Name="SessionPicker" Style="{StaticResource PvPicker}"
                            Title="Choose a completed game..."
                            SelectedIndexChanged="OnSessionSelected" />
                    <Label x:Name="WindowLabel" Style="{StaticResource PvCaption}" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. Nominate (hidden once voting has closed) -->
            <Border x:Name="NominateCard" Style="{StaticResource PvCard}" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvSectionHeader}" Text="Your nomination" />
                    <Label Style="{StaticResource PvCaption}"
                           Text="Tap a player who played in this match. Tap another player to change your vote until voting closes." />
                    <Label x:Name="FallbackLabel" Style="{StaticResource PvCaption}" IsVisible="False"
                           Text="This older match didn't save its squad, so players come from the current roster." />
                    <VerticalStackLayout x:Name="NomineeList" Spacing="6" />
                    <Label x:Name="SubmitStatusLabel" Style="{StaticResource PvCaption}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. Live tally / result -->
            <Border x:Name="TallyCard" Style="{StaticResource PvCard}" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="TallyHeader" Style="{StaticResource PvSectionHeader}" Text="Live tally" />
                    <VerticalStackLayout x:Name="TallyList" Spacing="6" />
                    <Label x:Name="TallyEmptyLabel" Style="{StaticResource PvCaption}" Text="No votes yet." />
                    <Label Style="{StaticResource PvCaption}"
                           Text="Votes are private. Only totals are shown, never who voted. Ties stand as joint winners." />
                </VerticalStackLayout>
            </Border>

            <!-- Admin: close voting early -->
            <Button x:Name="CloseVotingButton" Style="{StaticResource PvButtonDangerOutline}"
                    Text="Close voting now" IsVisible="False" Clicked="OnCloseVotingClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
