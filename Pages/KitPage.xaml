<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.KitPage"
             Title="Kit">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="16">
            <!-- View-only banner (shared members) -->
            <Border x:Name="ViewOnlyBanner" IsVisible="False" Style="{StaticResource PvCardWarning}" Padding="12,8">
                <Label Style="{StaticResource PvWarningText}" FontFamily="InterSemiBold"
                       Text="VIEW-ONLY — Only the team Admin can edit kit"
                       HorizontalTextAlignment="Center" />
            </Border>
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PvSectionHeader}" Text="Match Day" />
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Arrive" />
                        <Label Style="{StaticResource PvCaption}" Text="Kit to be worn when arriving at the venue" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="ArriveEntry" Placeholder="e.g. Club tracksuit" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Warm-Up" />
                        <Label Style="{StaticResource PvCaption}" Text="Kit to be worn during warm-up" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="WarmUpEntry" Placeholder="e.g. Training kit / bibs" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Game" />
                        <Label Style="{StaticResource PvCaption}" Text="Kit to be worn during the game" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="GameEntry" Placeholder="e.g. Home strip / Away strip" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Departure" />
                        <Label Style="{StaticResource PvCaption}" Text="Kit to be worn when departing the venue" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="DepartureEntry" Placeholder="e.g. Club tracksuit" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PvSectionHeader}" Text="Other" />
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Attendance as non-playing player" />
                        <Label Style="{StaticResource PvCaption}" Text="e.g. due to injury or other reasons" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="NonPlayingEntry" Placeholder="e.g. Club polo / casual" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Special Event" />
                        <Label Style="{StaticResource PvCaption}" Text="Prize giving, year end, etc." />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="SpecialEventEntry" Placeholder="e.g. Formal / club blazer" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
