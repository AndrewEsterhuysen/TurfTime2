<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.TimersSettingsPage"
             Title="Timers">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="16">

            <!-- Header -->
            <Label Style="{StaticResource PvTitle}" Text="Timers" Margin="4,8,0,0"/>

            <Label Style="{StaticResource PvCaption}" Text="Changes apply the next time a match is started." Margin="4,0,0,8"/>

            <!-- ── Match Timer ── -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Match Timer (minutes)"/>
                    <Label Style="{StaticResource PvCaption}" Text="Total match duration split across two halves."/>
                    <Entry Style="{StaticResource PvEntry}" x:Name="MatchTimerEntry" Keyboard="Numeric" Placeholder="e.g. 90" ReturnType="Done" Completed="OnMatchTimerCompleted"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Rotation Timer ── -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Rotation Timer (MM:SS)"/>
                    <Label Style="{StaticResource PvCaption}" Text="Countdown between player rotations."/>
                    <Entry Style="{StaticResource PvEntry}" x:Name="RotationTimerEntry" Keyboard="Default" Placeholder="e.g. 2:00" ReturnType="Done" Completed="OnRotationTimerCompleted"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Rotation Warning Time ── -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Rotation Warning Time (seconds)"/>
                    <Label Style="{StaticResource PvCaption}" Text="Seconds remaining on the Rotation Timer when the warning vibration triggers."/>
                    <Entry Style="{StaticResource PvEntry}" x:Name="RotationWarningTimeEntry" Keyboard="Numeric" Placeholder="Default: 10" ReturnType="Done" Completed="OnRotationWarningTimeCompleted"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Rotation Warning Duration ── -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Rotation Warning Vibration Duration (seconds)"/>
                    <Label Style="{StaticResource PvCaption}" Text="How long the device vibrates at the Rotation Warning Time."/>
                    <Entry Style="{StaticResource PvEntry}" x:Name="RotationWarningDurationEntry" Keyboard="Numeric" Placeholder="Default: 0.5" ReturnType="Done" Completed="OnRotationWarningDurationCompleted"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Rotation Duration ── -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Rotation Vibration Duration (seconds)"/>
                    <Label Style="{StaticResource PvCaption}" Text="How long the device vibrates when the Rotation Timer reaches 0."/>
                    <Entry Style="{StaticResource PvEntry}" x:Name="RotationDurationEntry" Keyboard="Numeric" Placeholder="Default: 1" ReturnType="Done" Completed="OnRotationDurationCompleted"/>
                </VerticalStackLayout>
            </Border>

            <!-- Save button -->
            <Button Style="{StaticResource PvButtonPrimary}" Text="Save" Margin="0,8,0,24" Clicked="OnSaveClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
