<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.WelcomePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D1F10" Offset="0.0" />
            <GradientStop Color="#050505" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- Greyscale watermark: splash image at very low opacity, centred -->
        <Image Source="turftimer_splash_512_512.png"
               Aspect="AspectFit"
               Opacity="0.08"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="420"
               HeightRequest="420" />

        <!-- Desaturate overlay: semi-transparent white layer over the image to wash colour further -->
        <BoxView Color="White"
                 Opacity="0.04"
                 VerticalOptions="Fill"
                 HorizontalOptions="Fill" />

        <!-- Welcome content on top -->
        <ScrollView VerticalOptions="Fill">
            <VerticalStackLayout Padding="24,48,24,32" Spacing="0">

                <!-- App logo / title line -->
                <Label Text="⏱ Turf Time"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#E8E8E8"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4" />

                <Label Text="Your Sideline Companion"
                       FontSize="14"
                       TextColor="#A0A0A0"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,32" />

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="#333333" Margin="0,0,0,28" />

                <!-- Welcome heading -->
                <Label Text="Welcome to Turf Time!"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,16" />

                <!-- Welcome body -->
                <Label TextColor="#CCCCCC"
                       FontSize="15"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,24">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Built for parents, coaches, and managers — run fair rotations, keep rosters tidy, and share the game with your team. Local play always works offline; shared cloud teams add multi-device control with one Admin running the match at a time." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Current features heading -->
                <Label Text="✅  What's Available Right Now"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       Margin="0,0,0,10" />

                <Label TextColor="#C8C8C8"
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,24">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="🎬  " /><Span Text="Demo Team quick start" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — first launch includes a ready-to-play demo team so you can press Start and try the full game flow immediately." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="🏆  " /><Span Text="Multiple teams" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — create and switch between as many local or shared teams as you need from Team Details." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="💾  " /><Span Text="On-device storage" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — rosters, game history, and settings stay on your phone so you're never without your data." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="🔄  " /><Span Text="Match timer &amp; fair rotations" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — set field/bench, rotation order, and interval; Tap to Rotate shows who is coming on and off." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="⚽  " /><Span Text="Goals with scorer &amp; assist" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — log goals and pick who scored and assisted for cleaner match reports." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="📋  " /><Span Text="Game reports" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — post-game summaries from your session history, ready to review and share." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="📲  " /><Span Text="QR team share &amp; import" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — share a team to another device offline from Team Details, or import by scanning a code." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="☁️  " /><Span Text="Shared cloud teams" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — create or join with an invite code; roster, timers, and scores sync across devices." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="👑  " /><Span Text="Owner · Admin · Member" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — Owner manages the club; promote co-admins; members follow in view-only. Only one Admin controls a live match at a time (Request / Take control / Relinquish)." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="💬  " /><Span Text="Team chat" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — message your shared team from the Chat tab using your display name." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="📍  " /><Span Text="Match location" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — set venue details, GPS, and map links under Details → Location." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="👕  " /><Span Text="Kit &amp; duties" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — kit colours and match-day duties (officer, canteen, grounds, pack-up) under Details — Admin-editable, members can view." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="🔔  " /><Span Text="Team push alerts" FontAttributes="Bold" TextColor="#FFFFFF" /><Span Text=" — stay in the loop with notifications for team events when permissions allow." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,0,0,24" />

                <!-- Coming soon heading -->
                <Label Text="🚀  Coming Soon"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       Margin="0,0,0,10" />

                <Label TextColor="#B0B0B0"
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,24">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="🗳️  " /><Span Text="Nominations" FontAttributes="Bold" TextColor="#D0D0D0" /><Span Text=" — player nominations and related Details tools." />
                            <Span Text="&#10;&#10;" />
                            <Span Text="…and more as we keep building with your feedback." TextColor="#888888" FontAttributes="Italic" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,0,0,24" />

                <!-- Closing call-to-action -->
                <Label Text="Join Us on the Journey! 🌱"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,12" />

                <Label TextColor="#B8B8B8"
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,36">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Turf Time is actively growing, and your experience on the pitch shapes every feature we build. You're not just using an app — " />
                            <Span Text="you're part of its story." FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Span Text=" Share feedback and ideas anytime — they help us prioritise what truly adds value. Game on! 🎉" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Don't show again toggle -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="10"
                                       Margin="0,0,0,16">
                    <CheckBox x:Name="DontShowCheckBox"
                              Color="#1A7F3C"
                              VerticalOptions="Center" />
                    <Label Text="Don't show this again"
                           TextColor="#A0A0A0"
                           FontSize="14"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDontShowLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Close / Enter button -->
                <Button Text="Let's Go! ▶"
                        x:Name="CloseBtn"
                        Clicked="OnCloseClicked"
                        BackgroundColor="#1A7F3C"
                        TextColor="#FFFFFF"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="52"
                        HorizontalOptions="Fill"
                        Margin="0,0,0,16" />

                <!-- App version watermark -->
                <Label x:Name="VersionLabel"
                       FontSize="11"
                       TextColor="#444444"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,8" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
