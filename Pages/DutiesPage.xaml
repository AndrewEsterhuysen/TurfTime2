<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.DutiesPage"
             Title="Duties">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="16">
            <!-- View-only banner (shared members) -->
            <Border x:Name="ViewOnlyBanner" IsVisible="False" Style="{StaticResource PvCardWarning}" Padding="12,8">
                <Label Style="{StaticResource PvWarningText}" FontFamily="InterSemiBold"
                       Text="VIEW-ONLY — Only the team Admin can edit duties"
                       HorizontalTextAlignment="Center" />
            </Border>
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PvSectionHeader}" Text="Match-Day Duties" />
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Duty Officer" />
                        <Label Style="{StaticResource PvCaption}" Text="Person responsible on the day" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="DutyOfficerEntry" Placeholder="Name of duty officer" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Canteen" />
                        <Label Style="{StaticResource PvCaption}" Text="Person(s) on canteen duty" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="CanteenEntry" Placeholder="Name(s) for canteen" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Grounds Setup" />
                        <Label Style="{StaticResource PvCaption}" Text="Person(s) setting up the grounds" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="GroundsSetupEntry" Placeholder="Name(s) for grounds setup" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Grounds Pack-up" />
                        <Label Style="{StaticResource PvCaption}" Text="Person(s) packing up the grounds" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="GroundsPackupEntry" Placeholder="Name(s) for grounds pack-up" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Other" />
                        <Label Style="{StaticResource PvCaption}" Text="Any additional match-day duties" />
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="OtherEntry" Placeholder="e.g. first aid, equipment, notes" TextChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
