<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.OptionsPage"
             Title="Options"
             BackgroundColor="#1b5e20">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="⚙️ Options"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,10,0,20" />

            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Enable reporting goal scorer and assist"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label x:Name="ToggleStateLabel"
                               Text="ON"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#A5D6A7"
                               VerticalOptions="Center" />
                        <Switch x:Name="EnableGoalDetailsSwitch"
                                IsToggled="True"
                                Toggled="OnEnableGoalDetailsToggled"
                                HorizontalOptions="Start"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Match reminders (local notifications) -->
            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Match reminders"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Uses Details → Location schedule. One tap enables day-before, morning, and leave reminders (arrive time minus buffer)."
                           FontSize="12"
                           TextColor="#C8E6C9" />

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label x:Name="RemindersMasterLabel"
                               Text="OFF"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#A5D6A7"
                               VerticalOptions="Center"
                               WidthRequest="48" />
                        <Switch x:Name="RemindersEnabledSwitch"
                                Toggled="OnRemindersEnabledToggled"
                                HorizontalOptions="Start"
                                VerticalOptions="Center" />
                        <Label Text="Enable reminders"
                               FontSize="15"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout x:Name="ReminderDetailsPanel" Spacing="10" IsVisible="False">
                        <HorizontalStackLayout Spacing="12">
                            <Switch x:Name="DayBeforeSwitch" Toggled="OnReminderDetailToggled" />
                            <Label Text="Day before"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Switch x:Name="MorningSwitch" Toggled="OnReminderDetailToggled" />
                            <Label Text="Morning of match"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Switch x:Name="LeaveSwitch" Toggled="OnReminderDetailToggled" />
                            <Label Text="Time to leave"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Leave buffer (before arrive)"
                               FontSize="13"
                               TextColor="#C8E6C9" />
                        <Picker x:Name="LeaveBufferPicker"
                                Title="Buffer"
                                TextColor="White"
                                TitleColor="#A5D6A7"
                                SelectedIndexChanged="OnLeaveBufferChanged" />
                    </VerticalStackLayout>

                    <Label x:Name="RemindersStatusLabel"
                           FontSize="12"
                           TextColor="#A5D6A7"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
