<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.OptionsPage"
             Title="Options">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="16">
            <Label Style="{StaticResource PvTitle}" Text="Options" Margin="4,8,0,8"/>

            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Enable reporting goal scorer and assist"/>

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Style="{StaticResource PvAccentText}" x:Name="ToggleStateLabel" Text="ON" VerticalOptions="Center"/>
                        <Switch Style="{StaticResource PvSwitch}" x:Name="EnableGoalDetailsSwitch" IsToggled="True" Toggled="OnEnableGoalDetailsToggled" HorizontalOptions="Start" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Rotation Basis — who is selected for the next rotate -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Rotation Basis"/>
                    <Label Style="{StaticResource PvCaption}" Text="How the app chooses who comes off the field and who comes on from the bench."/>
                    <Picker Style="{StaticResource PvPicker}" x:Name="RotationBasisPicker" Title="Basis" SelectedIndexChanged="OnRotationBasisChanged"/>
                    <Label Style="{StaticResource PvCaption}" x:Name="RotationBasisDescriptionLabel" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- Optional Game-tab tips (rotation basis line today; more later) -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Information text"/>
                    <Label Style="{StaticResource PvCaption}" Text="Show short instructional tips on the Game tab (for example the yellow rotation tip above Field View during a match). Turn off for a cleaner sideline display."/>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Style="{StaticResource PvAccentText}" x:Name="InformationTextStateLabel" Text="ON" VerticalOptions="Center" WidthRequest="48"/>
                        <Switch Style="{StaticResource PvSwitch}" x:Name="InformationTextSwitch" IsToggled="True" Toggled="OnInformationTextToggled" HorizontalOptions="Start" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Legacy Team (roster list) View — off by default -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource PvCardTitle}" Text="Enable Team View"/>
                    <Label Style="{StaticResource PvCaption}" Text="Include the roster list in the View cycle (Field → Team → Rotation). Off by default — Field toggles only with Rotation."/>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Style="{StaticResource PvAccentText}" x:Name="TeamViewStateLabel" Text="OFF" VerticalOptions="Center" WidthRequest="48"/>
                        <Switch Style="{StaticResource PvSwitch}" x:Name="TeamViewSwitch" IsToggled="False" Toggled="OnTeamViewToggled" HorizontalOptions="Start" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Match reminders (local notifications) -->
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PvCardTitle}" Text="Match reminders"/>
                    <Label Style="{StaticResource PvCaption}" Text="Uses Details → Location schedule. One tap enables day-before, morning, and leave reminders (arrive time minus buffer)."/>

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Style="{StaticResource PvAccentText}" x:Name="RemindersMasterLabel" Text="OFF" VerticalOptions="Center" WidthRequest="48"/>
                        <Switch Style="{StaticResource PvSwitch}" x:Name="RemindersEnabledSwitch" Toggled="OnRemindersEnabledToggled" HorizontalOptions="Start" VerticalOptions="Center"/>
                        <Label Style="{StaticResource PvBody}" Text="Enable reminders" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout x:Name="ReminderDetailsPanel" Spacing="8" IsVisible="False">
                        <HorizontalStackLayout Spacing="12">
                            <Switch Style="{StaticResource PvSwitch}" x:Name="DayBeforeSwitch" Toggled="OnReminderDetailToggled"/>
                            <Label Style="{StaticResource PvBody}" Text="Day before" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Switch Style="{StaticResource PvSwitch}" x:Name="MorningSwitch" Toggled="OnReminderDetailToggled"/>
                            <Label Style="{StaticResource PvBody}" Text="Morning of match" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Switch Style="{StaticResource PvSwitch}" x:Name="LeaveSwitch" Toggled="OnReminderDetailToggled"/>
                            <Label Style="{StaticResource PvBody}" Text="Time to leave" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Style="{StaticResource PvCaption}" Text="Leave buffer (before arrive)"/>
                        <Picker Style="{StaticResource PvPicker}" x:Name="LeaveBufferPicker" Title="Buffer" SelectedIndexChanged="OnLeaveBufferChanged"/>
                    </VerticalStackLayout>

                    <Label Style="{StaticResource PvCaption}" x:Name="RemindersStatusLabel" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
