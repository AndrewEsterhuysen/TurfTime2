<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.OptionsPage"
             Title="Options"
             BackgroundColor="#1b5e20">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="⚙️ Options"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,10,0,20" />

            <Frame BackgroundColor="#2e7d32"
                   CornerRadius="10"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Enable reporting goal scorer and assist"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label x:Name="ToggleStateLabel"
                               Text="ON"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#A5D6A7"
                               VerticalOptions="Center" />
                        <Switch x:Name="EnableGoalDetailsSwitch"
                                IsToggled="True"
                                Toggled="OnEnableGoalDetailsToggled"
                                HorizontalOptions="Start"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
