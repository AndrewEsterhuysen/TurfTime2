<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.SettingsPage"
             Title="Settings">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="8">
            <Label Style="{StaticResource PvTitle}" Text="Settings" Margin="4,8,0,16" />

            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTeamDetailsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource PvIconTile}">
                        <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconGroups}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource PvCardTitle}" Text="Team Selection" />
                        <Label Style="{StaticResource PvCaption}" Text="Switch teams, invites, QR share, and admin tools" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconChevron}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReportsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource PvIconTile}">
                        <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconChart}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource PvCardTitle}" Text="Reports" />
                        <Label Style="{StaticResource PvCaption}" Text="View and email match reports" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconChevron}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTimersTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource PvIconTile}">
                        <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconTimer}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource PvCardTitle}" Text="Timers" />
                        <Label Style="{StaticResource PvCaption}" Text="Configure match, rotation and vibration timers" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconChevron}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PvCard}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOptionsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Style="{StaticResource PvIconTile}">
                        <Label Style="{StaticResource PvIcon}" Text="{StaticResource PvIconTune}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Style="{StaticResource PvCardTitle}" Text="Options" />
                        <Label Style="{StaticResource PvCaption}" Text="Configure goal scorer and assist reporting" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Style="{StaticResource PvIconMuted}" Text="{StaticResource PvIconChevron}" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
