<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.SetupPage"
             Title="Location">
    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/PitchVolt.xaml" />
    </ContentPage.Resources>
    <ContentPage.Style>
        <StaticResource Key="PvPage" />
    </ContentPage.Style>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PvPagePadding}" Spacing="16">
            <!-- View-only banner (shared members) -->
            <Border x:Name="ViewOnlyBanner" IsVisible="False" Style="{StaticResource PvCardWarning}" Padding="12,8">
                <Label Style="{StaticResource PvWarningText}" FontFamily="InterSemiBold"
                       Text="VIEW-ONLY — Only the team Admin can edit match location"
                       HorizontalTextAlignment="Center" />
            </Border>
            <!-- Outdated / incomplete schedule -->
            <Border x:Name="ScheduleStatusBanner" IsVisible="False" Style="{StaticResource PvCardWarning}" Padding="12,8">
                <Label Style="{StaticResource PvWarningText}" x:Name="ScheduleStatusBannerLabel" FontFamily="InterSemiBold" HorizontalTextAlignment="Center" />
            </Border>
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PvSectionHeader}" Text="Schedule" />
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Match Start" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Style="{StaticResource PvField}">
                                <DatePicker Style="{StaticResource PvDatePicker}" x:Name="MatchDatePicker" DateSelected="OnFieldChanged" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PvField}">
                                <TimePicker Style="{StaticResource PvTimePicker}" x:Name="MatchTimePicker" PropertyChanged="OnFieldChanged" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PvBodyStrong}" Text="Arrive Time" />
                        <Label Style="{StaticResource PvCaption}" Text="When to be at the ground for warm-up (not kickoff)" />
                        <Border Style="{StaticResource PvField}">
                            <TimePicker Style="{StaticResource PvTimePicker}" x:Name="ArriveTimePicker" PropertyChanged="OnFieldChanged" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2" Margin="0,4,0,0">
                        <Label Style="{StaticResource PvBodyStrong}" x:Name="ScheduleStatusLabel" FontSize="13" />
                        <Label Style="{StaticResource PvCaption}" x:Name="ScheduleUpdatedLabel" />
                        <Label Style="{StaticResource PvCaption}" x:Name="ScheduleSourceLabel" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PvSectionHeader}" Text="Match Location" />
                    <Border Style="{StaticResource PvField}">
                        <Entry Style="{StaticResource PvEntry}" x:Name="LocationNameEntry" Placeholder="Venue or ground name" TextChanged="OnFieldChanged" />
                    </Border>
                    <Button Style="{StaticResource PvButtonSecondary}" x:Name="SearchLocationButton" Text="Search in Google Maps" Clicked="OnSearchLocationClicked" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PvSectionHeader}" Text="GPS Coordinates" />
                    <Label Style="{StaticResource PvCaption}" Text="Optional" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="LatitudeEntry" Placeholder="Latitude" Keyboard="Numeric" TextChanged="OnFieldChanged" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PvField}">
                            <Entry Style="{StaticResource PvEntry}" x:Name="LongitudeEntry" Placeholder="Longitude" Keyboard="Numeric" TextChanged="OnFieldChanged" />
                        </Border>
                    </Grid>
                    <Button Style="{StaticResource PvButtonSecondary}" x:Name="GetLocationButton" Text="Get Current Location" Clicked="OnGetLocationClicked" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource PvCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PvSectionHeader}" Text="Maps Link" />
                    <Label Style="{StaticResource PvCaption}" Text="Link (Google Maps)" />
                    <Border Style="{StaticResource PvField}">
                        <Entry Style="{StaticResource PvEntry}" x:Name="MapsLinkEntry" Placeholder="Paste Google Maps link here" Keyboard="Url" TextChanged="OnFieldChanged" />
                    </Border>
                    <Button Style="{StaticResource PvButtonSecondary}" x:Name="PickLocationButton" Text="Pick Location from Maps" Clicked="OnPickLocationClicked" />
                    <Button Style="{StaticResource PvButtonPrimary}" x:Name="OpenLinkButton" Text="Open in Maps" Clicked="OnOpenLinkClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
