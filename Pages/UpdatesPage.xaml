<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TurfTime2.UpdatesPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D1F10" Offset="0.0" />
            <GradientStop Color="#050505" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView VerticalOptions="Fill">
        <VerticalStackLayout Padding="24,56,24,32" Spacing="0">
            <Label Text="🆕 Updates"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10" />

            <Label x:Name="VersionLabel"
                   FontSize="13"
                   TextColor="#A0A0A0"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,24" />

            <BoxView HeightRequest="1" Color="#333333" Margin="0,0,0,22" />

            <Label Text="✅ Included in this release"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   Margin="0,0,0,12" />

            <Label TextColor="#C8C8C8"
                   FontSize="15"
                   LineBreakMode="WordWrap"
                   Margin="0,0,0,30">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="📲  " />
                        <Span Text="Team sharing via QR Code" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Span Text=" — share your team to another device from Team Details using a generated QR code." />
                        <Span Text="&#10;&#10;" />
                        <Span Text="🍎  " />
                        <Span Text="iOS drag 'n drop roster reorder" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Span Text=" — long-press the ☰ handle, then drag up or down to reorder player rows." />
                        <Span Text="&#10;&#10;" />
                        <Span Text="🎬  " />
                        <Span Text="Demo Team quick start" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Span Text=" — first launch now includes a ready-to-play demo team so you can press Start and experience the app immediately." />
                        <Span Text="&#10;&#10;" />
                        <Span Text="⚽  " />
                        <Span Text="Select goal scoring and assisting players for inclusion in report" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Span Text=" — choose who scored and assisted when logging goals so they appear in your match reports." />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Button Text="Continue ▶"
                    Clicked="OnContinueClicked"
                    BackgroundColor="#1A7F3C"
                    TextColor="#FFFFFF"
                    FontSize="17"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="52"
                    HorizontalOptions="Fill"
                    Margin="0,0,0,16" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
