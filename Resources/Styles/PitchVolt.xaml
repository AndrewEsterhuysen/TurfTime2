<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Pitch & Volt design tokens + styles (ui-refresh).
  PAGE-SCOPED: merge into an in-scope page's ContentPage.Resources only.
  Do NOT merge into App.xaml - global Styles.xaml/Colors.xaml stay unchanged.
  All keys are prefixed "Pv" and all styles are explicit (keyed) so nothing
  leaks into other pages. Code-behind equivalents: Helpers/PitchVolt.cs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Colour tokens (Light / Dark) ===== -->
    <Color x:Key="PvPrimaryLight">#0B6E4F</Color>
    <Color x:Key="PvPrimaryDark">#3DDC97</Color>
    <Color x:Key="PvOnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="PvOnPrimaryDark">#0B1210</Color>
    <Color x:Key="PvPrimaryContainerLight">#D7F2E3</Color>
    <Color x:Key="PvPrimaryContainerDark">#0F3B2C</Color>
    <Color x:Key="PvVolt">#C6F432</Color>
    <Color x:Key="PvOnVolt">#111816</Color>
    <Color x:Key="PvWarningLight">#FF8A00</Color>
    <Color x:Key="PvWarningDark">#FFB547</Color>
    <Color x:Key="PvWarningTextLight">#9A4F00</Color>
    <Color x:Key="PvWarningContainerLight">#FFF1DE</Color>
    <Color x:Key="PvWarningContainerDark">#3A2A12</Color>
    <Color x:Key="PvDangerLight">#D93025</Color>
    <Color x:Key="PvDangerDark">#FF6B5E</Color>
    <Color x:Key="PvBackgroundLight">#F6F8F7</Color>
    <Color x:Key="PvBackgroundDark">#0B1210</Color>
    <Color x:Key="PvSurfaceLight">#FFFFFF</Color>
    <Color x:Key="PvSurfaceDark">#15201C</Color>
    <Color x:Key="PvOutlineLight">#D5DDD9</Color>
    <Color x:Key="PvOutlineDark">#2A3833</Color>
    <Color x:Key="PvTextLight">#111816</Color>
    <Color x:Key="PvTextDark">#E8EEEB</Color>
    <Color x:Key="PvTextSecondaryLight">#56635E</Color>
    <Color x:Key="PvTextSecondaryDark">#9FB0A9</Color>

    <!-- ===== Spacing (8pt grid) ===== -->
    <x:Double x:Key="PvSpace1">4</x:Double>
    <x:Double x:Key="PvSpace2">8</x:Double>
    <x:Double x:Key="PvSpace3">16</x:Double>
    <x:Double x:Key="PvSpace4">24</x:Double>
    <x:Double x:Key="PvSpace5">32</x:Double>
    <Thickness x:Key="PvPagePadding">16,16,16,24</Thickness>
    <Thickness x:Key="PvCardPadding">16</Thickness>

    <!-- ===== Icon glyphs (Material Symbols Rounded) ===== -->
    <x:String x:Key="PvIconSettings">&#xe8b8;</x:String>
    <x:String x:Key="PvIconGroups">&#xf233;</x:String>
    <x:String x:Key="PvIconChart">&#xe26b;</x:String>
    <x:String x:Key="PvIconTimer">&#xe425;</x:String>
    <x:String x:Key="PvIconTune">&#xe429;</x:String>
    <x:String x:Key="PvIconChevron">&#xe5cc;</x:String>
    <x:String x:Key="PvIconClose">&#xe5cd;</x:String>
    <x:String x:Key="PvIconSend">&#xe163;</x:String>
    <x:String x:Key="PvIconPin">&#xf10d;</x:String>
    <x:String x:Key="PvIconVisibility">&#xe8f4;</x:String>
    <x:String x:Key="PvIconMail">&#xe159;</x:String>
    <x:String x:Key="PvIconAttach">&#xe226;</x:String>
    <x:String x:Key="PvIconPhone">&#xe7ba;</x:String>
    <x:String x:Key="PvIconKey">&#xe73c;</x:String>
    <x:String x:Key="PvIconLocation">&#xe0c8;</x:String>
    <x:String x:Key="PvIconCheckroom">&#xf19e;</x:String>
    <x:String x:Key="PvIconFactCheck">&#xf0c5;</x:String>
    <x:String x:Key="PvIconStar">&#xe838;</x:String>
    <x:String x:Key="PvIconMyLocation">&#xe55c;</x:String>
    <x:String x:Key="PvIconMap">&#xe55b;</x:String>
    <x:String x:Key="PvIconSearch">&#xe8b6;</x:String>
    <x:String x:Key="PvIconOpenNew">&#xe89e;</x:String>
    <x:String x:Key="PvIconCalendar">&#xe916;</x:String>
    <x:String x:Key="PvIconSchedule">&#xe192;</x:String>

    <!-- ===== Page ===== -->
    <Style x:Key="PvPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}" />
    </Style>

    <!-- ===== Cards (Border, radius 16) ===== -->
    <Style x:Key="PvCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvSurfaceLight}, Dark={StaticResource PvSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="{StaticResource PvCardPadding}" />
    </Style>
    <Style x:Key="PvCardTinted" TargetType="Border" BasedOn="{StaticResource PvCard}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryContainerLight}, Dark={StaticResource PvPrimaryContainerDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style x:Key="PvCardWarning" TargetType="Border" BasedOn="{StaticResource PvCard}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvWarningContainerLight}, Dark={StaticResource PvWarningContainerDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PvWarningLight}, Dark={StaticResource PvWarningDark}}" />
    </Style>
    <Style x:Key="PvCardDanger" TargetType="Border" BasedOn="{StaticResource PvCard}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PvDangerLight}, Dark={StaticResource PvDangerDark}}" />
    </Style>
    <Style x:Key="PvDivider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}" />
    </Style>

    <!-- ===== Type scale: Inter 56/28/22/17/15/13/11 ===== -->
    <Style x:Key="PvText" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
    </Style>
    <Style x:Key="PvDisplay" TargetType="Label" BasedOn="{StaticResource PvText}">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="56" />
    </Style>
    <Style x:Key="PvTitle" TargetType="Label" BasedOn="{StaticResource PvText}">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style x:Key="PvHeadline" TargetType="Label" BasedOn="{StaticResource PvText}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="PvCardTitle" TargetType="Label" BasedOn="{StaticResource PvText}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="PvBody" TargetType="Label" BasedOn="{StaticResource PvText}" />
    <Style x:Key="PvBodyStrong" TargetType="Label" BasedOn="{StaticResource PvText}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>
    <Style x:Key="PvCaption" TargetType="Label" BasedOn="{StaticResource PvText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
    </Style>
    <Style x:Key="PvOverline" TargetType="Label" BasedOn="{StaticResource PvText}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
    </Style>
    <Style x:Key="PvSectionHeader" TargetType="Label" BasedOn="{StaticResource PvOverline}">
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="Margin" Value="4,8,0,0" />
    </Style>
    <Style x:Key="PvAccentText" TargetType="Label" BasedOn="{StaticResource PvBodyStrong}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
    </Style>
    <Style x:Key="PvWarningText" TargetType="Label" BasedOn="{StaticResource PvCaption}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvWarningTextLight}, Dark={StaticResource PvWarningDark}}" />
    </Style>
    <Style x:Key="PvDangerText" TargetType="Label" BasedOn="{StaticResource PvCaption}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvDangerLight}, Dark={StaticResource PvDangerDark}}" />
    </Style>
    <Style x:Key="PvLink" TargetType="Label" BasedOn="{StaticResource PvCaption}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- ===== Icons ===== -->
    <Style x:Key="PvIcon" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialSymbols" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
    </Style>
    <Style x:Key="PvIconMuted" TargetType="Label" BasedOn="{StaticResource PvIcon}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
    </Style>
    <!-- 40x40 rounded tile holding a PvIcon (Settings rows) -->
    <Style x:Key="PvIconTile" TargetType="Border">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryContainerLight}, Dark={StaticResource PvPrimaryContainerDark}}" />
    </Style>

    <!-- ===== Buttons (pill) ===== -->
    <Style x:Key="PvButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
    <Style x:Key="PvButtonPrimary" TargetType="Button" BasedOn="{StaticResource PvButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvOnPrimaryLight}, Dark={StaticResource PvOnPrimaryDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="PvButtonVolt" TargetType="Button" BasedOn="{StaticResource PvButtonPrimary}">
        <Setter Property="BackgroundColor" Value="{StaticResource PvVolt}" />
        <Setter Property="TextColor" Value="{StaticResource PvOnVolt}" />
    </Style>
    <Style x:Key="PvButtonSecondary" TargetType="Button" BasedOn="{StaticResource PvButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryContainerLight}, Dark={StaticResource PvPrimaryContainerDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="PvButtonOutline" TargetType="Button" BasedOn="{StaticResource PvButtonBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
    </Style>
    <Style x:Key="PvButtonWarning" TargetType="Button" BasedOn="{StaticResource PvButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvWarningLight}, Dark={StaticResource PvWarningDark}}" />
        <Setter Property="TextColor" Value="{StaticResource PvOnVolt}" />
    </Style>
    <Style x:Key="PvButtonDanger" TargetType="Button" BasedOn="{StaticResource PvButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvDangerLight}, Dark={StaticResource PvDangerDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PvOnPrimaryDark}}" />
    </Style>
    <Style x:Key="PvButtonDangerOutline" TargetType="Button" BasedOn="{StaticResource PvButtonOutline}">
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource PvDangerLight}, Dark={StaticResource PvDangerDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvDangerLight}, Dark={StaticResource PvDangerDark}}" />
    </Style>
    <Style x:Key="PvButtonText" TargetType="Button" BasedOn="{StaticResource PvButtonBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
    </Style>
    <Style x:Key="PvIconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="MaterialSymbols" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
    </Style>

    <!-- ===== Inputs ===== -->
    <!-- Read-only (IsEnabled=False) keeps full-strength text colour: ≥ 15:1 light, ≥ 13:1 dark (WCAG AA+), better than PR #2's Gray600/Gray200. -->
    <Style x:Key="PvEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="PvEditor" TargetType="Editor">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="PvPicker" TargetType="Picker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource PvTextSecondaryLight}, Dark={StaticResource PvTextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}" />
    </Style>
    <Style x:Key="PvDatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="PvTimePicker" TargetType="TimePicker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PvTextLight}, Dark={StaticResource PvTextDark}}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="PvSwitch" TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PvTextDark}}" />
    </Style>
    <Style x:Key="PvCheckBox" TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PvPrimaryLight}, Dark={StaticResource PvPrimaryDark}}" />
    </Style>
    <!-- Rounded field wrapper used around Entry/Picker -->
    <Style x:Key="PvField" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- ===== Segmented control ===== -->
    <Style x:Key="PvSegmentTrack" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PvBackgroundLight}, Dark={StaticResource PvBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PvOutlineLight}, Dark={StaticResource PvOutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style x:Key="PvSegment" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style x:Key="PvSegmentLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
